@prefix dg: <https://linked.data.gov.au/dataset/fsdf/licenses> .
@prefix license: <http://purl.org/NET/rdflicense/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .

license:APACHE2.0 schema:description "As per the license' legal code"@en ;
    schema:name "Apache License Version 2.0"@en .

license:MIT1.0 schema:description "As per the license' legal code"@en ;
    schema:name "MIT License"@en .

license:cc-by-nc4.0 schema:description "As per the license' legal code"@en ;
    schema:name "Attribution-NonCommercial 4.0 International (CC BY-NC 4.0)"@en .

license:cc-by-nd4.0 schema:description "As per the license' legal code"@en ;
    schema:name "Attribution-NoDerivatives 4.0 International (CC BY-ND 4.0)"@en .

license:cc-by-sa3.0au schema:description "As per the license' legal code"@en ;
    schema:name "Attribution-ShareAlike 3.0 Australia (CC BY-SA 3.0 AU)"@en .

license:cc-by-sa4.0 schema:description "As per the license' legal code"@en ;
    schema:name "Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)"@en .

license:cc-by2.0au schema:description "As per the license' legal code"@en ;
    schema:name "Attribution 2.0 Australia (CC BY 2.0 AU)"@en .

license:cc-by4.0 schema:description "As per the license' legal code"@en ;
    schema:name "Attribution 4.0 International (CC BY 4.0)"@en .

license:publicdomain schema:description "As per the license' legal code"@en ;
    schema:name "Public domain"@en .

dg: a owl:Ontology ;
    schema:description "This Data Graph contains instances of licenses which are ODRL Policy instances contained within the RDF Licenses dataset, online at http://rdflicense.appspot.com/"@en ;
    schema:name "FSDF Licenses"@en .

