@prefix ont: <https://linked.data.gov.au/def/ontpub> .
@prefix op: <https://linked.data.gov.au/def/ontpub/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .

ont: a owl:Ontology ;
    schema:description "This small ontology provides only a few properties used to assist with the documentation of other ontologies' content" ;
    schema:name "Ontology Documentation Profile" .

op:defines a rdf:Property ;
    schema:description "Inverse of rdfs:isDefinedBy" ;
    schema:name "defines" .

op:hasInstance a rdf:Property ;
    schema:description "Indicates Named Individuals that are of this class" ;
    schema:name "has instance" .

op:inDomainIncludesOf a rdf:Property ;
    schema:description "Inverse of sdo:domainIncludes" ;
    schema:name "in domain includes of" .

op:inDomainOf a rdf:Property ;
    schema:description "Inverse of rdfs:domain" ;
    schema:name "in domain of" .

op:inRangeIncludesOf a rdf:Property ;
    schema:description "Inverse of sdo:rangeIncludes" ;
    schema:name "in range includes of" .

op:inRangeOf a rdf:Property ;
    schema:description "Inverse of rdfs:range" ;
    schema:name "in range of" .

op:restriction a rdf:Property ;
    schema:description "Convenience property for things that subclass owl:Restriction" ;
    schema:name "restriction" .

op:superClassOf a rdf:Property ;
    schema:description "Inverse of RDFS' subClassOf" ;
    schema:name "super class of" .

op:superPropertyOf a rdf:Property ;
    schema:description "Inverse of RDFS' subPropertyOf" ;
    schema:name "super property of" .

