@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .

schema:Dermatology a schema:MedicalSpecialty ;
    schema:description "A specific branch of medical science that pertains to diagnosis and treatment of disorders of skin." ;
    schema:name "Dermatology" .

schema:about a rdf:Property ;
    schema:description "The subject matter of the content." ;
    schema:name "about" .

schema:abridged a rdf:Property ;
    schema:description "Indicates whether the book is an abridged edition." ;
    schema:name "abridged" .

schema:abstract a rdf:Property ;
    schema:description "An abstract is a short description that summarizes a [[CreativeWork]]." ;
    schema:name "abstract" .

schema:accelerationTime a rdf:Property ;
    schema:description "The time needed to accelerate the vehicle from a given start velocity to a given target velocity.\\n\\nTypical unit code(s): SEC for seconds\\n\\n* Note: There are unfortunately no standard unit codes for seconds/0..100 km/h or seconds/0..60 mph. Simply use \"SEC\" for seconds and indicate the velocities in the [[name]] of the [[QuantitativeValue]], or use [[valueReference]] with a [[QuantitativeValue]] of 0..60 mph or 0..100 km/h to specify the reference speeds." ;
    schema:name "acceleration time" .

schema:acceptedAnswer a rdf:Property ;
    schema:description "The answer(s) that has been accepted as best, typically on a Question/Answer site. Sites vary in their selection mechanisms, e.g. drawing on community opinion and/or the view of the Question author." ;
    schema:name "accepted answer" .

schema:acceptedOffer a rdf:Property ;
    schema:description "The offer(s) -- e.g., product, quantity and price combinations -- included in the order." ;
    schema:name "accepted offer" .

schema:acceptedPaymentMethod a rdf:Property ;
    schema:description "The payment method(s) accepted by seller for this offer." ;
    schema:name "accepted payment method" .

schema:acceptsReservations a rdf:Property ;
    schema:description "Indicates whether a FoodEstablishment accepts reservations. Values can be Boolean, an URL at which reservations can be made or (for backwards compatibility) the strings ```Yes``` or ```No```." ;
    schema:name "accepts reservations" .

schema:accessCode a rdf:Property ;
    schema:description "Password, PIN, or access code needed for delivery (e.g. from a locker)." ;
    schema:name "access code" .

schema:accessMode a rdf:Property ;
    schema:description """The human sensory perceptual system or cognitive faculty through which a person may process or perceive information. Expected values include: auditory, tactile, textual, visual, colorDependent, chartOnVisual, chemOnVisual, diagramOnVisual, mathOnVisual, musicOnVisual, textOnVisual.
      """ ;
    schema:name "access mode" .

schema:accessModeSufficient a rdf:Property ;
    schema:description """A list of single or combined accessModes that are sufficient to understand all the intellectual content of a resource. Expected values include:  auditory, tactile, textual, visual.
      """ ;
    schema:name "access mode sufficient" .

schema:accessibilityAPI a rdf:Property ;
    schema:description "Indicates that the resource is compatible with the referenced accessibility API ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." ;
    schema:name "accessibility api" .

schema:accessibilityControl a rdf:Property ;
    schema:description "Identifies input methods that are sufficient to fully control the described resource ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." ;
    schema:name "accessibility control" .

schema:accessibilityFeature a rdf:Property ;
    schema:description "Content features of the resource, such as accessible media, alternatives and supported enhancements for accessibility ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." ;
    schema:name "accessibility feature" .

schema:accessibilityHazard a rdf:Property ;
    schema:description "A characteristic of the described resource that is physiologically dangerous to some users. Related to WCAG 2.0 guideline 2.3 ([WebSchemas wiki lists possible values](http://www.w3.org/wiki/WebSchemas/Accessibility))." ;
    schema:name "accessibility hazard" .

schema:accessibilitySummary a rdf:Property ;
    schema:description "A human-readable summary of specific accessibility features or deficiencies, consistent with the other accessibility metadata but expressing subtleties such as \"short descriptions are present but long descriptions will be needed for non-visual users\" or \"short descriptions are present and no long descriptions are needed.\"" ;
    schema:name "accessibility summary" .

schema:accommodationCategory a rdf:Property ;
    schema:description "Category of an [[Accommodation]], following real estate conventions e.g. RESO (see [PropertySubType](https://ddwiki.reso.org/display/DDW17/PropertySubType+Field), and [PropertyType](https://ddwiki.reso.org/display/DDW17/PropertyType+Field) fields  for suggested values)." ;
    schema:name "accommodation category" .

schema:accommodationFloorPlan a rdf:Property ;
    schema:description "A floorplan of some [[Accommodation]]." ;
    schema:name "accommodation floor plan" .

schema:accountId a rdf:Property ;
    schema:description "The identifier for the account the payment will be applied to." ;
    schema:name "account id" .

schema:accountMinimumInflow a rdf:Property ;
    schema:description "A minimum amount that has to be paid in every month." ;
    schema:name "account minimum inflow" .

schema:accountOverdraftLimit a rdf:Property ;
    schema:description "An overdraft is an extension of credit from a lending institution when an account reaches zero. An overdraft allows the individual to continue withdrawing money even if the account has no funds in it. Basically the bank allows people to borrow a set amount of money." ;
    schema:name "account overdraft limit" .

schema:accountablePerson a rdf:Property ;
    schema:description "Specifies the Person that is legally accountable for the CreativeWork." ;
    schema:name "accountable person" .

schema:acquireLicensePage a rdf:Property ;
    schema:description "Indicates a page documenting how licenses can be purchased or otherwise acquired, for the current item." ;
    schema:name "acquire license page" .

schema:acquiredFrom a rdf:Property ;
    schema:description "The organization or person from which the product was acquired." ;
    schema:name "acquired from" .

schema:acrissCode a rdf:Property ;
    schema:description "The ACRISS Car Classification Code is a code used by many car rental companies, for classifying vehicles. ACRISS stands for Association of Car Rental Industry Systems and Standards." ;
    schema:name "acriss code" .

schema:actionAccessibilityRequirement a rdf:Property ;
    schema:description "A set of requirements that a must be fulfilled in order to perform an Action. If more than one value is specied, fulfilling one set of requirements will allow the Action to be performed." ;
    schema:name "action accessibility requirement" .

schema:actionApplication a rdf:Property ;
    schema:description "An application that can complete the request." ;
    schema:name "action application" .

schema:actionOption a rdf:Property ;
    schema:description "A sub property of object. The options subject to this action." ;
    schema:name "action option" .

schema:actionPlatform a rdf:Property ;
    schema:description "The high level platform(s) where the Action can be performed for the given URL. To specify a specific application or operating system instance, use actionApplication." ;
    schema:name "action platform" .

schema:actionStatus a rdf:Property ;
    schema:description "Indicates the current disposition of the Action." ;
    schema:name "action status" .

schema:actionableFeedbackPolicy a rdf:Property ;
    schema:description "For a [[NewsMediaOrganization]] or other news-related [[Organization]], a statement about public engagement activities (for news media, the newsroom’s), including involving the public - digitally or otherwise -- in coverage decisions, reporting and activities after publication." ;
    schema:name "actionable feedback policy" .

schema:activeIngredient a rdf:Property ;
    schema:description "An active ingredient, typically chemical compounds and/or biologic substances." ;
    schema:name "active ingredient" .

schema:activityDuration a rdf:Property ;
    schema:description "Length of time to engage in the activity." ;
    schema:name "activity duration" .

schema:activityFrequency a rdf:Property ;
    schema:description "How often one should engage in the activity." ;
    schema:name "activity frequency" .

schema:actor a rdf:Property ;
    schema:description "An actor, e.g. in tv, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip." ;
    schema:name "actor" .

schema:actors a rdf:Property ;
    schema:description "An actor, e.g. in tv, radio, movie, video games etc. Actors can be associated with individual items or with a series, episode, clip." ;
    schema:name "actors" .

schema:addOn a rdf:Property ;
    schema:description "An additional offer that can only be obtained in combination with the first base offer (e.g. supplements and extensions that are available for a surcharge)." ;
    schema:name "add on" .

schema:additionalName a rdf:Property ;
    schema:description "An additional name for a Person, can be used for a middle name." ;
    schema:name "additional name" .

schema:additionalNumberOfGuests a rdf:Property ;
    schema:description "If responding yes, the number of guests who will attend in addition to the invitee." ;
    schema:name "additional number of guests" .

schema:additionalProperty a rdf:Property ;
    schema:description """A property-value pair representing an additional characteristics of the entitity, e.g. a product feature or another characteristic for which there is no matching property in schema.org.\\n\\nNote: Publishers should be aware that applications designed to use specific schema.org properties (e.g. https://schema.org/width, https://schema.org/color, https://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism.
""" ;
    schema:name "additional property" .

schema:additionalType a rdf:Property ;
    schema:description "An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. In RDFa syntax, it is better to use the native RDFa syntax - the 'typeof' attribute - for multiple types. Schema.org tools may have only weaker understanding of extra types, in particular those defined externally." ;
    schema:name "additional type" .

schema:additionalVariable a rdf:Property ;
    schema:description "Any additional component of the exercise prescription that may need to be articulated to the patient. This may include the order of exercises, the number of repetitions of movement, quantitative distance, progressions over time, etc." ;
    schema:name "additional variable" .

schema:address a rdf:Property ;
    schema:description "Physical address of the item." ;
    schema:name "address" .

schema:addressCountry a rdf:Property ;
    schema:description "The country. For example, USA. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1)." ;
    schema:name "address country" .

schema:addressLocality a rdf:Property ;
    schema:description "The locality in which the street address is, and which is in the region. For example, Mountain View." ;
    schema:name "address locality" .

schema:addressRegion a rdf:Property ;
    schema:description "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level [Administrative division](https://en.wikipedia.org/wiki/List_of_administrative_divisions_by_country) " ;
    schema:name "address region" .

schema:administrationRoute a rdf:Property ;
    schema:description "A route by which this drug may be administered, e.g. 'oral'." ;
    schema:name "administration route" .

schema:advanceBookingRequirement a rdf:Property ;
    schema:description "The amount of time that is required between accepting the offer and the actual usage of the resource or service." ;
    schema:name "advance booking requirement" .

schema:adverseOutcome a rdf:Property ;
    schema:description "A possible complication and/or side effect of this therapy. If it is known that an adverse outcome is serious (resulting in death, disability, or permanent damage; requiring hospitalization; or is otherwise life-threatening or requires immediate medical attention), tag it as a seriouseAdverseOutcome instead." ;
    schema:name "adverse outcome" .

schema:affectedBy a rdf:Property ;
    schema:description "Drugs that affect the test's results." ;
    schema:name "affected by" .

schema:affiliation a rdf:Property ;
    schema:description "An organization that this person is affiliated with. For example, a school/university, a club, or a team." ;
    schema:name "affiliation" .

schema:afterMedia a rdf:Property ;
    schema:description "A media object representing the circumstances after performing this direction." ;
    schema:name "after media" .

schema:agent a rdf:Property ;
    schema:description "The direct performer or driver of the action (animate or inanimate). e.g. *John* wrote a book." ;
    schema:name "agent" .

schema:aggregateRating a rdf:Property ;
    schema:description "The overall rating, based on a collection of reviews or ratings, of the item." ;
    schema:name "aggregate rating" .

schema:aircraft a rdf:Property ;
    schema:description "The kind of aircraft (e.g., \"Boeing 747\")." ;
    schema:name "aircraft" .

schema:album a rdf:Property ;
    schema:description "A music album." ;
    schema:name "album" .

schema:albumProductionType a rdf:Property ;
    schema:description "Classification of the album by it's type of content: soundtrack, live album, studio album, etc." ;
    schema:name "album production type" .

schema:albumRelease a rdf:Property ;
    schema:description "A release of this album." ;
    schema:name "album release" .

schema:albumReleaseType a rdf:Property ;
    schema:description "The kind of release which this album is: single, EP or album." ;
    schema:name "album release type" .

schema:albums a rdf:Property ;
    schema:description "A collection of music albums." ;
    schema:name "albums" .

schema:alcoholWarning a rdf:Property ;
    schema:description "Any precaution, guidance, contraindication, etc. related to consumption of alcohol while taking this drug." ;
    schema:name "alcohol warning" .

schema:algorithm a rdf:Property ;
    schema:description "The algorithm or rules to follow to compute the score." ;
    schema:name "algorithm" .

schema:alignmentType a rdf:Property ;
    schema:description "A category of alignment between the learning resource and the framework node. Recommended values include: 'requires', 'textComplexity', 'readingLevel', and 'educationalSubject'." ;
    schema:name "alignment type" .

schema:alternateName a rdf:Property ;
    schema:description "An alias for the item." ;
    schema:name "alternate name" .

schema:alternativeHeadline a rdf:Property ;
    schema:description "A secondary title of the CreativeWork." ;
    schema:name "alternative headline" .

schema:alternativeOf a rdf:Property ;
    schema:description "Another gene which is a variation of this one." ;
    schema:name "alternative of" .

schema:alumni a rdf:Property ;
    schema:description "Alumni of an organization." ;
    schema:name "alumni" .

schema:alumniOf a rdf:Property ;
    schema:description "An organization that the person is an alumni of." ;
    schema:name "alumni of" .

schema:amenityFeature a rdf:Property ;
    schema:description "An amenity feature (e.g. a characteristic or service) of the Accommodation. This generic property does not make a statement about whether the feature is included in an offer for the main accommodation or available at extra costs." ;
    schema:name "amenity feature" .

schema:amount a rdf:Property ;
    schema:description "The amount of money." ;
    schema:name "amount" .

schema:amountOfThisGood a rdf:Property ;
    schema:description "The quantity of the goods included in the offer." ;
    schema:name "amount of this good" .

schema:announcementLocation a rdf:Property ;
    schema:description "Indicates a specific [[CivicStructure]] or [[LocalBusiness]] associated with the SpecialAnnouncement. For example, a specific testing facility or business with special opening hours. For a larger geographic region like a quarantine of an entire region, use [[spatialCoverage]]." ;
    schema:name "announcement location" .

schema:annualPercentageRate a rdf:Property ;
    schema:description "The annual rate that is charged for borrowing (or made by investing), expressed as a single percentage number that represents the actual yearly cost of funds over the term of a loan. This includes any fees or additional costs associated with the transaction." ;
    schema:name "annual percentage rate" .

schema:answerCount a rdf:Property ;
    schema:description "The number of answers this question has received." ;
    schema:name "answer count" .

schema:answerExplanation a rdf:Property ;
    schema:description "A step-by-step or full explanation about Answer. Can outline how this Answer was achieved or contain more broad clarification or statement about it. " ;
    schema:name "answer explanation" .

schema:antagonist a rdf:Property ;
    schema:description "The muscle whose action counteracts the specified muscle." ;
    schema:name "antagonist" .

schema:appearance a rdf:Property ;
    schema:description "Indicates an occurence of a [[Claim]] in some [[CreativeWork]]." ;
    schema:name "appearance" .

schema:applicableLocation a rdf:Property ;
    schema:description "The location in which the status applies." ;
    schema:name "applicable location" .

schema:applicantLocationRequirements a rdf:Property ;
    schema:description "The location(s) applicants can apply from. This is usually used for telecommuting jobs where the applicant does not need to be in a physical office. Note: This should not be used for citizenship or work visa requirements." ;
    schema:name "applicant location requirements" .

schema:application a rdf:Property ;
    schema:description "An application that can complete the request." ;
    schema:name "application" .

schema:applicationCategory a rdf:Property ;
    schema:description "Type of software application, e.g. 'Game, Multimedia'." ;
    schema:name "application category" .

schema:applicationContact a rdf:Property ;
    schema:description "Contact details for further information relevant to this job posting." ;
    schema:name "application contact" .

schema:applicationDeadline a rdf:Property ;
    schema:description "The date at which the program stops collecting applications for the next enrollment cycle." ;
    schema:name "application deadline" .

schema:applicationStartDate a rdf:Property ;
    schema:description "The date at which the program begins collecting applications for the next enrollment cycle." ;
    schema:name "application start date" .

schema:applicationSubCategory a rdf:Property ;
    schema:description "Subcategory of the application, e.g. 'Arcade Game'." ;
    schema:name "application sub category" .

schema:applicationSuite a rdf:Property ;
    schema:description "The name of the application suite to which the application belongs (e.g. Excel belongs to Office)." ;
    schema:name "application suite" .

schema:appliesToDeliveryMethod a rdf:Property ;
    schema:description "The delivery method(s) to which the delivery charge or payment charge specification applies." ;
    schema:name "applies to delivery method" .

schema:appliesToPaymentMethod a rdf:Property ;
    schema:description "The payment method(s) to which the payment charge specification applies." ;
    schema:name "applies to payment method" .

schema:archiveHeld a rdf:Property ;
    schema:description "Collection, [fonds](https://en.wikipedia.org/wiki/Fonds), or item held, kept or maintained by an [[ArchiveOrganization]]."@en ;
    schema:name "archive held"@en .

schema:archivedAt a rdf:Property ;
    schema:description "Indicates a page or other link involved in archival of a [[CreativeWork]]. In the case of [[MediaReview]], the items in a [[MediaReviewItem]] may often become inaccessible, but be archived by archival, journalistic, activist, or law enforcement organizations. In such cases, the referenced page may not directly publish the content." ;
    schema:name "archived at" .

schema:area a rdf:Property ;
    schema:description "The area within which users can expect to reach the broadcast service." ;
    schema:name "area" .

schema:areaServed a rdf:Property ;
    schema:description "The geographic area where a service or offered item is provided." ;
    schema:name "area served" .

schema:arrivalAirport a rdf:Property ;
    schema:description "The airport where the flight terminates." ;
    schema:name "arrival airport" .

schema:arrivalBoatTerminal a rdf:Property ;
    schema:description "The terminal or port from which the boat arrives." ;
    schema:name "arrival boat terminal" .

schema:arrivalBusStop a rdf:Property ;
    schema:description "The stop or station from which the bus arrives." ;
    schema:name "arrival bus stop" .

schema:arrivalGate a rdf:Property ;
    schema:description "Identifier of the flight's arrival gate." ;
    schema:name "arrival gate" .

schema:arrivalPlatform a rdf:Property ;
    schema:description "The platform where the train arrives." ;
    schema:name "arrival platform" .

schema:arrivalStation a rdf:Property ;
    schema:description "The station where the train trip ends." ;
    schema:name "arrival station" .

schema:arrivalTerminal a rdf:Property ;
    schema:description "Identifier of the flight's arrival terminal." ;
    schema:name "arrival terminal" .

schema:arrivalTime a rdf:Property ;
    schema:description "The expected arrival time." ;
    schema:name "arrival time" .

schema:artEdition a rdf:Property ;
    schema:description "The number of copies when multiple copies of a piece of artwork are produced - e.g. for a limited edition of 20 prints, 'artEdition' refers to the total number of copies (in this example \"20\")." ;
    schema:name "art edition" .

schema:artMedium a rdf:Property ;
    schema:description "The material used. (e.g. Oil, Watercolour, Acrylic, Linoprint, Marble, Cyanotype, Digital, Lithograph, DryPoint, Intaglio, Pastel, Woodcut, Pencil, Mixed Media, etc.)" ;
    schema:name "art medium" .

schema:arterialBranch a rdf:Property ;
    schema:description "The branches that comprise the arterial structure." ;
    schema:name "arterial branch" .

schema:artform a rdf:Property ;
    schema:description "e.g. Painting, Drawing, Sculpture, Print, Photograph, Assemblage, Collage, etc." ;
    schema:name "artform" .

schema:articleBody a rdf:Property ;
    schema:description "The actual body of the article." ;
    schema:name "article body" .

schema:articleSection a rdf:Property ;
    schema:description "Articles may belong to one or more 'sections' in a magazine or newspaper, such as Sports, Lifestyle, etc." ;
    schema:name "article section" .

schema:artist a rdf:Property ;
    schema:description """The primary artist for a work
    	in a medium other than pencils or digital line art--for example, if the
    	primary artwork is done in watercolors or digital paints.""" ;
    schema:name "artist" .

schema:artworkSurface a rdf:Property ;
    schema:description "The supporting materials for the artwork, e.g. Canvas, Paper, Wood, Board, etc." ;
    schema:name "artwork surface" .

schema:aspect a rdf:Property ;
    schema:description "An aspect of medical practice that is considered on the page, such as 'diagnosis', 'treatment', 'causes', 'prognosis', 'etiology', 'epidemiology', etc." ;
    schema:name "aspect" .

schema:assembly a rdf:Property ;
    schema:description "Library file name e.g., mscorlib.dll, system.web.dll." ;
    schema:name "assembly" .

schema:assemblyVersion a rdf:Property ;
    schema:description "Associated product/technology version. e.g., .NET Framework 4.5." ;
    schema:name "assembly version" .

schema:assesses a rdf:Property ;
    schema:description "The item being described is intended to assess the competency or learning outcome defined by the referenced term." ;
    schema:name "assesses" .

schema:associatedAnatomy a rdf:Property ;
    schema:description "The anatomy of the underlying organ system or structures associated with this entity." ;
    schema:name "associated anatomy" .

schema:associatedArticle a rdf:Property ;
    schema:description "A NewsArticle associated with the Media Object." ;
    schema:name "associated article" .

schema:associatedClaimReview a rdf:Property ;
    schema:description "An associated [[ClaimReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." ;
    schema:name "associated claim review" .

schema:associatedDisease a rdf:Property ;
    schema:description "Disease associated to this BioChemEntity. Such disease can be a MedicalCondition or a URL. If you want to add an evidence supporting the association, please use PropertyValue." ;
    schema:name "associated disease" .

schema:associatedMedia a rdf:Property ;
    schema:description "A media object that encodes this CreativeWork. This property is a synonym for encoding." ;
    schema:name "associated media" .

schema:associatedMediaReview a rdf:Property ;
    schema:description "An associated [[MediaReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." ;
    schema:name "associated media review" .

schema:associatedPathophysiology a rdf:Property ;
    schema:description "If applicable, a description of the pathophysiology associated with the anatomical system, including potential abnormal changes in the mechanical, physical, and biochemical functions of the system." ;
    schema:name "associated pathophysiology" .

schema:associatedReview a rdf:Property ;
    schema:description "An associated [[Review]]." ;
    schema:name "associated review" .

schema:athlete a rdf:Property ;
    schema:description "A person that acts as performing member of a sports team; a player as opposed to a coach." ;
    schema:name "athlete" .

schema:attendee a rdf:Property ;
    schema:description "A person or organization attending the event." ;
    schema:name "attendee" .

schema:attendees a rdf:Property ;
    schema:description "A person attending the event." ;
    schema:name "attendees" .

schema:audience a rdf:Property ;
    schema:description "An intended audience, i.e. a group for whom something was created." ;
    schema:name "audience" .

schema:audienceType a rdf:Property ;
    schema:description "The target group associated with a given audience (e.g. veterans, car owners, musicians, etc.)." ;
    schema:name "audience type" .

schema:audio a rdf:Property ;
    schema:description "An embedded audio object." ;
    schema:name "audio" .

schema:authenticator a rdf:Property ;
    schema:description "The Organization responsible for authenticating the user's subscription. For example, many media apps require a cable/satellite provider to authenticate your subscription before playing media." ;
    schema:name "authenticator" .

schema:author a rdf:Property ;
    schema:description "The author of this content or rating. Please note that author is special in that HTML 5 provides a special mechanism for indicating authorship via the rel tag. That is equivalent to this and may be used interchangeably." ;
    schema:name "author" .

schema:availability a rdf:Property ;
    schema:description "The availability of this item&#x2014;for example In stock, Out of stock, Pre-order, etc." ;
    schema:name "availability" .

schema:availabilityEnds a rdf:Property ;
    schema:description "The end of the availability of the product or service included in the offer." ;
    schema:name "availability ends" .

schema:availabilityStarts a rdf:Property ;
    schema:description "The beginning of the availability of the product or service included in the offer." ;
    schema:name "availability starts" .

schema:availableAtOrFrom a rdf:Property ;
    schema:description "The place(s) from which the offer can be obtained (e.g. store locations)." ;
    schema:name "available at or from" .

schema:availableChannel a rdf:Property ;
    schema:description "A means of accessing the service (e.g. a phone bank, a web site, a location, etc.)." ;
    schema:name "available channel" .

schema:availableDeliveryMethod a rdf:Property ;
    schema:description "The delivery method(s) available for this offer." ;
    schema:name "available delivery method" .

schema:availableFrom a rdf:Property ;
    schema:description "When the item is available for pickup from the store, locker, etc." ;
    schema:name "available from" .

schema:availableIn a rdf:Property ;
    schema:description "The location in which the strength is available." ;
    schema:name "available in" .

schema:availableLanguage a rdf:Property ;
    schema:description "A language someone may use with or at the item, service or place. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[inLanguage]]" ;
    schema:name "available language" .

schema:availableOnDevice a rdf:Property ;
    schema:description "Device required to run the application. Used in cases where a specific make/model is required to run the application." ;
    schema:name "available on device" .

schema:availableService a rdf:Property ;
    schema:description "A medical service available from this provider." ;
    schema:name "available service" .

schema:availableStrength a rdf:Property ;
    schema:description "An available dosage strength for the drug." ;
    schema:name "available strength" .

schema:availableTest a rdf:Property ;
    schema:description "A diagnostic test or procedure offered by this lab." ;
    schema:name "available test" .

schema:availableThrough a rdf:Property ;
    schema:description "After this date, the item will no longer be available for pickup." ;
    schema:name "available through" .

schema:award a rdf:Property ;
    schema:description "An award won by or for this item." ;
    schema:name "award" .

schema:awards a rdf:Property ;
    schema:description "Awards won by or for this item." ;
    schema:name "awards" .

schema:awayTeam a rdf:Property ;
    schema:description "The away team in a sports event." ;
    schema:name "away team" .

schema:backstory a rdf:Property ;
    schema:description "For an [[Article]], typically a [[NewsArticle]], the backstory property provides a textual summary giving a brief explanation of why and how an article was created. In a journalistic setting this could include information about reporting process, methods, interviews, data sources, etc." ;
    schema:name "backstory" .

schema:bankAccountType a rdf:Property ;
    schema:description "The type of a bank account." ;
    schema:name "bank account type" .

schema:baseSalary a rdf:Property ;
    schema:description "The base salary of the job or of an employee in an EmployeeRole." ;
    schema:name "base salary" .

schema:bccRecipient a rdf:Property ;
    schema:description "A sub property of recipient. The recipient blind copied on a message." ;
    schema:name "bcc recipient" .

schema:bed a rdf:Property ;
    schema:description """The type of bed or beds included in the accommodation. For the single case of just one bed of a certain type, you use bed directly with a text.
      If you want to indicate the quantity of a certain kind of bed, use an instance of BedDetails. For more detailed information, use the amenityFeature property.""" ;
    schema:name "bed" .

schema:beforeMedia a rdf:Property ;
    schema:description "A media object representing the circumstances before performing this direction." ;
    schema:name "before media" .

schema:beneficiaryBank a rdf:Property ;
    schema:description "A bank or bank’s branch, financial institution or international financial institution operating the beneficiary’s bank account or releasing funds for the beneficiary." ;
    schema:name "beneficiary bank" .

schema:benefits a rdf:Property ;
    schema:description "Description of benefits associated with the job." ;
    schema:name "benefits" .

schema:benefitsSummaryUrl a rdf:Property ;
    schema:description "The URL that goes directly to the summary of benefits and coverage for the specific standard plan or plan variation." ;
    schema:name "benefits summary url" .

schema:bestRating a rdf:Property ;
    schema:description "The highest value allowed in this rating system. If bestRating is omitted, 5 is assumed." ;
    schema:name "best rating" .

schema:billingAddress a rdf:Property ;
    schema:description "The billing address for the order." ;
    schema:name "billing address" .

schema:billingDuration a rdf:Property ;
    schema:description "Specifies for how long this price (or price component) will be billed. Can be used, for example, to model the contractual duration of a subscription or payment plan. Type can be either a Duration or a Number (in which case the unit of measurement, for example month, is specified by the unitCode property)." ;
    schema:name "billing duration" .

schema:billingIncrement a rdf:Property ;
    schema:description "This property specifies the minimal quantity and rounding increment that will be the basis for the billing. The unit of measurement is specified by the unitCode property." ;
    schema:name "billing increment" .

schema:billingPeriod a rdf:Property ;
    schema:description "The time interval used to compute the invoice." ;
    schema:name "billing period" .

schema:billingStart a rdf:Property ;
    schema:description "Specifies after how much time this price (or price component) becomes valid and billing starts. Can be used, for example, to model a price increase after the first year of a subscription. The unit of measurement is specified by the unitCode property." ;
    schema:name "billing start" .

schema:bioChemInteraction a rdf:Property ;
    schema:description "A BioChemEntity that is known to interact with this item." ;
    schema:name "bio chem interaction" .

schema:bioChemSimilarity a rdf:Property ;
    schema:description "A similar BioChemEntity, e.g., obtained by fingerprint similarity algorithms." ;
    schema:name "bio chem similarity" .

schema:biologicalRole a rdf:Property ;
    schema:description "A role played by the BioChemEntity within a biological context." ;
    schema:name "biological role" .

schema:biomechnicalClass a rdf:Property ;
    schema:description "The biomechanical properties of the bone." ;
    schema:name "biomechnical class" .

schema:birthDate a rdf:Property ;
    schema:description "Date of birth." ;
    schema:name "birth date" .

schema:birthPlace a rdf:Property ;
    schema:description "The place where the person was born." ;
    schema:name "birth place" .

schema:bitrate a rdf:Property ;
    schema:description "The bitrate of the media object." ;
    schema:name "bitrate" .

schema:blogPost a rdf:Property ;
    schema:description "A posting that is part of this blog." ;
    schema:name "blog post" .

schema:blogPosts a rdf:Property ;
    schema:description "Indicates a post that is part of a [[Blog]]. Note that historically, what we term a \"Blog\" was once known as a \"weblog\", and that what we term a \"BlogPosting\" is now often colloquially referred to as a \"blog\"." ;
    schema:name "blog posts" .

schema:bloodSupply a rdf:Property ;
    schema:description "The blood vessel that carries blood from the heart to the muscle." ;
    schema:name "blood supply" .

schema:boardingGroup a rdf:Property ;
    schema:description "The airline-specific indicator of boarding order / preference." ;
    schema:name "boarding group" .

schema:boardingPolicy a rdf:Property ;
    schema:description "The type of boarding policy used by the airline (e.g. zone-based or group-based)." ;
    schema:name "boarding policy" .

schema:bodyLocation a rdf:Property ;
    schema:description "Location in the body of the anatomical structure." ;
    schema:name "body location" .

schema:bodyType a rdf:Property ;
    schema:description "Indicates the design and body style of the vehicle (e.g. station wagon, hatchback, etc.)." ;
    schema:name "body type" .

schema:bookEdition a rdf:Property ;
    schema:description "The edition of the book." ;
    schema:name "book edition" .

schema:bookFormat a rdf:Property ;
    schema:description "The format of the book." ;
    schema:name "book format" .

schema:bookingAgent a rdf:Property ;
    schema:description "'bookingAgent' is an out-dated term indicating a 'broker' that serves as a booking agent." ;
    schema:name "booking agent" .

schema:bookingTime a rdf:Property ;
    schema:description "The date and time the reservation was booked." ;
    schema:name "booking time" .

schema:borrower a rdf:Property ;
    schema:description "A sub property of participant. The person that borrows the object being lent." ;
    schema:name "borrower" .

schema:box a rdf:Property ;
    schema:description "A box is the area enclosed by the rectangle formed by two points. The first point is the lower corner, the second point is the upper corner. A box is expressed as two points separated by a space character." ;
    schema:name "box" .

schema:branch a rdf:Property ;
    schema:description "The branches that delineate from the nerve bundle. Not to be confused with [[branchOf]]." ;
    schema:name "branch" .

schema:branchCode a rdf:Property ;
    schema:description """A short textual code (also called "store code") that uniquely identifies a place of business. The code is typically assigned by the parentOrganization and used in structured URLs.\\n\\nFor example, in the URL http://www.starbucks.co.uk/store-locator/etc/detail/3047 the code "3047" is a branchCode for a particular branch.
      """ ;
    schema:name "branch code" .

schema:branchOf a rdf:Property ;
    schema:description "The larger organization that this local business is a branch of, if any. Not to be confused with (anatomical)[[branch]]." ;
    schema:name "branch of" .

schema:brand a rdf:Property ;
    schema:description "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person." ;
    schema:name "brand" .

schema:breadcrumb a rdf:Property ;
    schema:description "A set of links that can help a user understand and navigate a website hierarchy." ;
    schema:name "breadcrumb" .

schema:breastfeedingWarning a rdf:Property ;
    schema:description "Any precaution, guidance, contraindication, etc. related to this drug's use by breastfeeding mothers." ;
    schema:name "breastfeeding warning" .

schema:broadcastAffiliateOf a rdf:Property ;
    schema:description "The media network(s) whose content is broadcast on this station." ;
    schema:name "broadcast affiliate of" .

schema:broadcastChannelId a rdf:Property ;
    schema:description "The unique address by which the BroadcastService can be identified in a provider lineup. In US, this is typically a number." ;
    schema:name "broadcast channel id" .

schema:broadcastDisplayName a rdf:Property ;
    schema:description "The name displayed in the channel guide. For many US affiliates, it is the network name." ;
    schema:name "broadcast display name" .

schema:broadcastFrequency a rdf:Property ;
    schema:description "The frequency used for over-the-air broadcasts. Numeric values or simple ranges e.g. 87-99. In addition a shortcut idiom is supported for frequences of AM and FM radio channels, e.g. \"87 FM\"." ;
    schema:name "broadcast frequency" .

schema:broadcastFrequencyValue a rdf:Property ;
    schema:description "The frequency in MHz for a particular broadcast." ;
    schema:name "broadcast frequency value" .

schema:broadcastOfEvent a rdf:Property ;
    schema:description "The event being broadcast such as a sporting event or awards ceremony." ;
    schema:name "broadcast of event" .

schema:broadcastServiceTier a rdf:Property ;
    schema:description "The type of service required to have access to the channel (e.g. Standard or Premium)." ;
    schema:name "broadcast service tier" .

schema:broadcastSignalModulation a rdf:Property ;
    schema:description "The modulation (e.g. FM, AM, etc) used by a particular broadcast service." ;
    schema:name "broadcast signal modulation" .

schema:broadcastSubChannel a rdf:Property ;
    schema:description "The subchannel used for the broadcast." ;
    schema:name "broadcast sub channel" .

schema:broadcastTimezone a rdf:Property ;
    schema:description "The timezone in [ISO 8601 format](http://en.wikipedia.org/wiki/ISO_8601) for which the service bases its broadcasts" ;
    schema:name "broadcast timezone" .

schema:broadcaster a rdf:Property ;
    schema:description "The organization owning or operating the broadcast service." ;
    schema:name "broadcaster" .

schema:broker a rdf:Property ;
    schema:description "An entity that arranges for an exchange between a buyer and a seller.  In most cases a broker never acquires or releases ownership of a product or service involved in an exchange.  If it is not clear whether an entity is a broker, seller, or buyer, the latter two terms are preferred." ;
    schema:name "broker" .

schema:browserRequirements a rdf:Property ;
    schema:description "Specifies browser requirements in human-readable text. For example, 'requires HTML5 support'." ;
    schema:name "browser requirements" .

schema:busName a rdf:Property ;
    schema:description "The name of the bus (e.g. Bolt Express)." ;
    schema:name "bus name" .

schema:busNumber a rdf:Property ;
    schema:description "The unique identifier for the bus." ;
    schema:name "bus number" .

schema:businessDays a rdf:Property ;
    schema:description "Days of the week when the merchant typically operates, indicated via opening hours markup." ;
    schema:name "business days" .

schema:businessFunction a rdf:Property ;
    schema:description "The business function (e.g. sell, lease, repair, dispose) of the offer or component of a bundle (TypeAndQuantityNode). The default is http://purl.org/goodrelations/v1#Sell." ;
    schema:name "business function" .

schema:buyer a rdf:Property ;
    schema:description "A sub property of participant. The participant/person/organization that bought the object." ;
    schema:name "buyer" .

schema:byArtist a rdf:Property ;
    schema:description "The artist that performed this album or recording." ;
    schema:name "by artist" .

schema:byDay a rdf:Property ;
    schema:description "Defines the day(s) of the week on which a recurring [[Event]] takes place. May be specified using either [[DayOfWeek]], or alternatively [[Text]] conforming to iCal's syntax for byDay recurrence rules." ;
    schema:name "by day" .

schema:byMonth a rdf:Property ;
    schema:description "Defines the month(s) of the year on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-12. January is 1." ;
    schema:name "by month" .

schema:byMonthDay a rdf:Property ;
    schema:description "Defines the day(s) of the month on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-31." ;
    schema:name "by month day" .

schema:byMonthWeek a rdf:Property ;
    schema:description "Defines the week(s) of the month on which a recurring Event takes place. Specified as an Integer between 1-5. For clarity, byMonthWeek is best used in conjunction with byDay to indicate concepts like the first and third Mondays of a month." ;
    schema:name "by month week" .

schema:callSign a rdf:Property ;
    schema:description "A [callsign](https://en.wikipedia.org/wiki/Call_sign), as used in broadcasting and radio communications to identify people, radio and TV stations, or vehicles." ;
    schema:name "call sign" .

schema:calories a rdf:Property ;
    schema:description "The number of calories." ;
    schema:name "calories" .

schema:candidate a rdf:Property ;
    schema:description "A sub property of object. The candidate subject of this action." ;
    schema:name "candidate" .

schema:caption a rdf:Property ;
    schema:description "The caption for this object. For downloadable machine formats (closed caption, subtitles etc.) use MediaObject and indicate the [[encodingFormat]]." ;
    schema:name "caption" .

schema:carbohydrateContent a rdf:Property ;
    schema:description "The number of grams of carbohydrates." ;
    schema:name "carbohydrate content" .

schema:cargoVolume a rdf:Property ;
    schema:description "The available volume for cargo or luggage. For automobiles, this is usually the trunk volume.\\n\\nTypical unit code(s): LTR for liters, FTQ for cubic foot/feet\\n\\nNote: You can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "cargo volume" .

schema:carrier a rdf:Property ;
    schema:description "'carrier' is an out-dated term indicating the 'provider' for parcel delivery and flights." ;
    schema:name "carrier" .

schema:carrierRequirements a rdf:Property ;
    schema:description "Specifies specific carrier(s) requirements for the application (e.g. an application may only work on a specific carrier network)." ;
    schema:name "carrier requirements" .

schema:cashBack a rdf:Property ;
    schema:description "A cardholder benefit that pays the cardholder a small percentage of their net expenditures." ;
    schema:name "cash back" .

schema:catalog a rdf:Property ;
    schema:description "A data catalog which contains this dataset." ;
    schema:name "catalog" .

schema:catalogNumber a rdf:Property ;
    schema:description "The catalog number for the release." ;
    schema:name "catalog number" .

schema:category a rdf:Property ;
    schema:description "A category for the item. Greater signs or slashes can be used to informally indicate a category hierarchy." ;
    schema:name "category" .

schema:causeOf a rdf:Property ;
    schema:description "The condition, complication, symptom, sign, etc. caused." ;
    schema:name "cause of" .

schema:ccRecipient a rdf:Property ;
    schema:description "A sub property of recipient. The recipient copied on a message." ;
    schema:name "cc recipient" .

schema:character a rdf:Property ;
    schema:description "Fictional person connected with a creative work." ;
    schema:name "character" .

schema:characterAttribute a rdf:Property ;
    schema:description "A piece of data that represents a particular aspect of a fictional character (skill, power, character points, advantage, disadvantage)." ;
    schema:name "character attribute" .

schema:characterName a rdf:Property ;
    schema:description "The name of a character played in some acting or performing role, i.e. in a PerformanceRole." ;
    schema:name "character name" .

schema:cheatCode a rdf:Property ;
    schema:description "Cheat codes to the game." ;
    schema:name "cheat code" .

