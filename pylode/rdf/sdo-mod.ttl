    schema:description "The latest someone may check out of a lodging establishment." ;
    schema:name "checkout time" .

schema:chemicalComposition a rdf:Property ;
    schema:description "The chemical composition describes the identity and relative ratio of the chemical elements that make up the substance." ;
    schema:name "chemical composition" .

schema:chemicalRole a rdf:Property ;
    schema:description "A role played by the BioChemEntity within a chemical context." ;
    schema:name "chemical role" .

schema:childMaxAge a rdf:Property ;
    schema:description "Maximal age of the child." ;
    schema:name "child max age" .

schema:childMinAge a rdf:Property ;
    schema:description "Minimal age of the child." ;
    schema:name "child min age" .

schema:childTaxon a rdf:Property ;
    schema:description "Closest child taxa of the taxon in question." ;
    schema:name "child taxon" .

schema:children a rdf:Property ;
    schema:description "A child of the person." ;
    schema:name "children" .

schema:cholesterolContent a rdf:Property ;
    schema:description "The number of milligrams of cholesterol." ;
    schema:name "cholesterol content" .

schema:circle a rdf:Property ;
    schema:description "A circle is the circular region of a specified radius centered at a specified latitude and longitude. A circle is expressed as a pair followed by a radius in meters." ;
    schema:name "circle" .

schema:citation a rdf:Property ;
    schema:description "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc." ;
    schema:name "citation" .

schema:claimInterpreter a rdf:Property ;
    schema:description """For a [[Claim]] interpreted from [[MediaObject]] content
    sed to indicate a claim contained, implied or refined from the content of a [[MediaObject]].""" ;
    schema:name "claim interpreter" .

schema:claimReviewed a rdf:Property ;
    schema:description "A short summary of the specific claims reviewed in a ClaimReview." ;
    schema:name "claim reviewed" .

schema:clincalPharmacology a rdf:Property ;
    schema:description "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." ;
    schema:name "clincal pharmacology" .

schema:clinicalPharmacology a rdf:Property ;
    schema:description "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." ;
    schema:name "clinical pharmacology" .

schema:clipNumber a rdf:Property ;
    schema:description "Position of the clip within an ordered group of clips." ;
    schema:name "clip number" .

schema:closes a rdf:Property ;
    schema:description "The closing hour of the place or service on the given day(s) of the week." ;
    schema:name "closes" .

schema:coach a rdf:Property ;
    schema:description "A person that acts in a coaching role for a sports team." ;
    schema:name "coach" .

schema:code a rdf:Property ;
    schema:description "A medical code for the entity, taken from a controlled vocabulary or ontology such as ICD-9, DiseasesDB, MeSH, SNOMED-CT, RxNorm, etc." ;
    schema:name "code" .

schema:codeRepository a rdf:Property ;
    schema:description "Link to the repository where the un-compiled, human readable code and related code is located (SVN, github, CodePlex)." ;
    schema:name "code repository" .

schema:codeSampleType a rdf:Property ;
    schema:description "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." ;
    schema:name "code sample type" .

schema:codeValue a rdf:Property ;
    schema:description "A short textual code that uniquely identifies the value." ;
    schema:name "code value" .

schema:codingSystem a rdf:Property ;
    schema:description "The coding system, e.g. 'ICD-10'." ;
    schema:name "coding system" .

schema:colleague a rdf:Property ;
    schema:description "A colleague of the person." ;
    schema:name "colleague" .

schema:colleagues a rdf:Property ;
    schema:description "A colleague of the person." ;
    schema:name "colleagues" .

schema:collection a rdf:Property ;
    schema:description "A sub property of object. The collection target of the action." ;
    schema:name "collection" .

schema:collectionSize a rdf:Property ;
    schema:description "The number of items in the [[Collection]]."@en ;
    schema:name "collection size"@en .

schema:color a rdf:Property ;
    schema:description "The color of the product." ;
    schema:name "color" .

schema:colorist a rdf:Property ;
    schema:description "The individual who adds color to inked drawings." ;
    schema:name "colorist" .

schema:comment a rdf:Property ;
    schema:description "Comments, typically from users." ;
    schema:name "comment" .

schema:commentCount a rdf:Property ;
    schema:description "The number of comments this CreativeWork (e.g. Article, Question or Answer) has received. This is most applicable to works published in Web sites with commenting system; additional comments may exist elsewhere." ;
    schema:name "comment count" .

schema:commentText a rdf:Property ;
    schema:description "The text of the UserComment." ;
    schema:name "comment text" .

schema:commentTime a rdf:Property ;
    schema:description "The time at which the UserComment was made." ;
    schema:name "comment time" .

schema:competencyRequired a rdf:Property ;
    schema:description "Knowledge, skill, ability or personal attribute that must be demonstrated by a person or other entity in order to do something such as earn an Educational Occupational Credential or understand a LearningResource." ;
    schema:name "competency required" .

schema:competitor a rdf:Property ;
    schema:description "A competitor in a sports event." ;
    schema:name "competitor" .

schema:composer a rdf:Property ;
    schema:description "The person or organization who wrote a composition, or who is the composer of a work performed at some event." ;
    schema:name "composer" .

schema:comprisedOf a rdf:Property ;
    schema:description "Specifying something physically contained by something else. Typically used here for the underlying anatomical structures, such as organs, that comprise the anatomical system." ;
    schema:name "comprised of" .

schema:conditionsOfAccess a rdf:Property ;
    schema:description "Conditions that affect the availability of, or method(s) of access to, an item. Typically used for real world items such as an [[ArchiveComponent]] held by an [[ArchiveOrganization]]. This property is not suitable for use as a general Web access control mechanism. It is expressed only in natural language.\\n\\nFor example \"Available by appointment from the Reading Room\" or \"Accessible only from logged-in accounts \". " ;
    schema:name "conditions of access" .

schema:confirmationNumber a rdf:Property ;
    schema:description "A number that confirms the given order or payment has been received." ;
    schema:name "confirmation number" .

schema:connectedTo a rdf:Property ;
    schema:description "Other anatomical structures to which this structure is connected." ;
    schema:name "connected to" .

schema:constrainingProperty a rdf:Property ;
    schema:description """Indicates a property used as a constraint to define a [[StatisticalPopulation]] with respect to the set of entities
  corresponding to an indicated type (via [[populationType]]).""" ;
    schema:name "constraining property" .

schema:contactOption a rdf:Property ;
    schema:description "An option available on this contact point (e.g. a toll-free number or support for hearing-impaired callers)." ;
    schema:name "contact option" .

schema:contactPoint a rdf:Property ;
    schema:description "A contact point for a person or organization." ;
    schema:name "contact point" .

schema:contactPoints a rdf:Property ;
    schema:description "A contact point for a person or organization." ;
    schema:name "contact points" .

schema:contactType a rdf:Property ;
    schema:description "A person or organization can have different contact points, for different purposes. For example, a sales contact point, a PR contact point and so on. This property is used to specify the kind of contact point." ;
    schema:name "contact type" .

schema:contactlessPayment a rdf:Property ;
    schema:description "A secure method for consumers to purchase products or services via debit, credit or smartcards by using RFID or NFC technology." ;
    schema:name "contactless payment" .

schema:containedIn a rdf:Property ;
    schema:description "The basic containment relation between a place and one that contains it." ;
    schema:name "contained in" .

schema:containedInPlace a rdf:Property ;
    schema:description "The basic containment relation between a place and one that contains it." ;
    schema:name "contained in place" .

schema:containsPlace a rdf:Property ;
    schema:description "The basic containment relation between a place and another that it contains." ;
    schema:name "contains place" .

schema:containsSeason a rdf:Property ;
    schema:description "A season that is part of the media series." ;
    schema:name "contains season" .

schema:contentLocation a rdf:Property ;
    schema:description "The location depicted or described in the content. For example, the location in a photograph or painting." ;
    schema:name "content location" .

schema:contentRating a rdf:Property ;
    schema:description "Official rating of a piece of content&#x2014;for example,'MPAA PG-13'." ;
    schema:name "content rating" .

schema:contentReferenceTime a rdf:Property ;
    schema:description "The specific time described by a creative work, for works (e.g. articles, video objects etc.) that emphasise a particular moment within an Event." ;
    schema:name "content reference time" .

schema:contentSize a rdf:Property ;
    schema:description "File size in (mega/kilo) bytes." ;
    schema:name "content size" .

schema:contentType a rdf:Property ;
    schema:description "The supported content type(s) for an EntryPoint response." ;
    schema:name "content type" .

schema:contentUrl a rdf:Property ;
    schema:description "Actual bytes of the media object, for example the image file or video file." ;
    schema:name "content url" .

schema:contraindication a rdf:Property ;
    schema:description "A contraindication for this therapy." ;
    schema:name "contraindication" .

schema:contributor a rdf:Property ;
    schema:description "A secondary contributor to the CreativeWork or Event." ;
    schema:name "contributor" .

schema:cookTime a rdf:Property ;
    schema:description "The time it takes to actually cook the dish, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    schema:name "cook time" .

schema:cookingMethod a rdf:Property ;
    schema:description "The method of cooking, such as Frying, Steaming, ..." ;
    schema:name "cooking method" .

schema:copyrightHolder a rdf:Property ;
    schema:description "The party holding the legal copyright to the CreativeWork." ;
    schema:name "copyright holder" .

schema:copyrightNotice a rdf:Property ;
    schema:description "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work." ;
    schema:name "copyright notice" .

schema:copyrightYear a rdf:Property ;
    schema:description "The year during which the claimed copyright for the CreativeWork was first asserted." ;
    schema:name "copyright year" .

schema:correction a rdf:Property ;
    schema:description "Indicates a correction to a [[CreativeWork]], either via a [[CorrectionComment]], textually or in another document." ;
    schema:name "correction" .

schema:correctionsPolicy a rdf:Property ;
    schema:description "For an [[Organization]] (e.g. [[NewsMediaOrganization]]), a statement describing (in news media, the newsroom’s) disclosure and correction policy for errors." ;
    schema:name "corrections policy" .

schema:costCategory a rdf:Property ;
    schema:description "The category of cost, such as wholesale, retail, reimbursement cap, etc." ;
    schema:name "cost category" .

schema:costCurrency a rdf:Property ;
    schema:description "The currency (in 3-letter of the drug cost. See: http://en.wikipedia.org/wiki/ISO_4217. " ;
    schema:name "cost currency" .

schema:costOrigin a rdf:Property ;
    schema:description "Additional details to capture the origin of the cost data. For example, 'Medicare Part B'." ;
    schema:name "cost origin" .

schema:costPerUnit a rdf:Property ;
    schema:description "The cost per unit of the drug." ;
    schema:name "cost per unit" .

schema:countriesNotSupported a rdf:Property ;
    schema:description "Countries for which the application is not supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." ;
    schema:name "countries not supported" .

schema:countriesSupported a rdf:Property ;
    schema:description "Countries for which the application is supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." ;
    schema:name "countries supported" .

schema:countryOfAssembly a rdf:Property ;
    schema:description "The place where the product was assembled." ;
    schema:name "country of assembly" .

schema:countryOfLastProcessing a rdf:Property ;
    schema:description "The place where the item (typically [[Product]]) was last processed and tested before importation." ;
    schema:name "country of last processing" .

schema:countryOfOrigin a rdf:Property ;
    schema:description """The country of origin of something, including products as well as creative  works such as movie and TV content.

In the case of TV and movie, this would be the country of the principle offices of the production company or individual responsible for the movie. For other kinds of [[CreativeWork]] it is difficult to provide fully general guidance, and properties such as [[contentLocation]] and [[locationCreated]] may be more applicable.

In the case of products, the country of origin of the product. The exact interpretation of this may vary by context and product type, and cannot be fully enumerated here.""" ;
    schema:name "country of origin" .

schema:course a rdf:Property ;
    schema:description "A sub property of location. The course where this action was taken." ;
    schema:name "course" .

schema:courseCode a rdf:Property ;
    schema:description "The identifier for the [[Course]] used by the course [[provider]] (e.g. CS101 or 6.001)." ;
    schema:name "course code" .

schema:courseMode a rdf:Property ;
    schema:description "The medium or means of delivery of the course instance or the mode of study, either as a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or as a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous )." ;
    schema:name "course mode" .

schema:coursePrerequisites a rdf:Property ;
    schema:description "Requirements for taking the Course. May be completion of another [[Course]] or a textual description like \"permission of instructor\". Requirements may be a pre-requisite competency, referenced using [[AlignmentObject]]." ;
    schema:name "course prerequisites" .

schema:courseWorkload a rdf:Property ;
    schema:description "The amount of work expected of students taking the course, often provided as a figure per week or per month, and may be broken down by type. For example, \"2 hours of lectures, 1 hour of lab work and 3 hours of independent study per week\"." ;
    schema:name "course workload" .

schema:coverageEndTime a rdf:Property ;
    schema:description "The time when the live blog will stop covering the Event. Note that coverage may continue after the Event concludes." ;
    schema:name "coverage end time" .

schema:coverageStartTime a rdf:Property ;
    schema:description "The time when the live blog will begin covering the Event. Note that coverage may begin before the Event's start time. The LiveBlogPosting may also be created before coverage begins." ;
    schema:name "coverage start time" .

schema:creativeWorkStatus a rdf:Property ;
    schema:description "The status of a creative work in terms of its stage in a lifecycle. Example terms include Incomplete, Draft, Published, Obsolete. Some organizations define a set of terms for the stages of their publication lifecycle." ;
    schema:name "creative work status" .

schema:creator a rdf:Property ;
    schema:description "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork." ;
    schema:name "creator" .

schema:credentialCategory a rdf:Property ;
    schema:description "The category or type of credential being described, for example \"degree”, “certificate”, “badge”, or more specific term." ;
    schema:name "credential category" .

schema:creditText a rdf:Property ;
    schema:description "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work." ;
    schema:name "credit text" .

schema:creditedTo a rdf:Property ;
    schema:description "The group the release is credited to if different than the byArtist. For example, Red and Blue is credited to \"Stefani Germanotta Band\", but by Lady Gaga." ;
    schema:name "credited to" .

schema:cssSelector a rdf:Property ;
    schema:description "A CSS selector, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." ;
    schema:name "css selector" .

schema:currenciesAccepted a rdf:Property ;
    schema:description "The currency accepted.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." ;
    schema:name "currencies accepted" .

schema:currency a rdf:Property ;
    schema:description "The currency in which the monetary amount is expressed.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." ;
    schema:name "currency" .

schema:currentExchangeRate a rdf:Property ;
    schema:description "The current price of a currency." ;
    schema:name "current exchange rate" .

schema:customer a rdf:Property ;
    schema:description "Party placing the order or paying the invoice." ;
    schema:name "customer" .

schema:customerRemorseReturnFees a rdf:Property ;
    schema:description "The type of return fees if the product is returned due to customer remorse." ;
    schema:name "customer remorse return fees" .

schema:customerRemorseReturnLabelSource a rdf:Property ;
    schema:description "The method (from an enumeration) by which the customer obtains a return shipping label for a product returned due to customer remorse." ;
    schema:name "customer remorse return label source" .

schema:customerRemorseReturnShippingFeesAmount a rdf:Property ;
    schema:description "The amount of shipping costs if a product is returned due to customer remorse. Applicable when property [[customerRemorseReturnFees]] equals [[ReturnShippingFees]]." ;
    schema:name "customer remorse return shipping fees amount" .

schema:cutoffTime a rdf:Property ;
    schema:description "Order cutoff time allows merchants to describe the time after which they will no longer process orders received on that day. For orders processed after cutoff time, one day gets added to the delivery time estimate. This property is expected to be most typically used via the [[ShippingRateSettings]] publication pattern. The time is indicated using the ISO-8601 Time format, e.g. \"23:30:00-05:00\" would represent 6:30 pm Eastern Standard Time (EST) which is 5 hours behind Coordinated Universal Time (UTC)." ;
    schema:name "cutoff time" .

schema:cvdCollectionDate a rdf:Property ;
    schema:description "collectiondate - Date for which patient counts are reported." ;
    schema:name "cvd collection date" .

schema:cvdFacilityCounty a rdf:Property ;
    schema:description "Name of the County of the NHSN facility that this data record applies to. Use [[cvdFacilityId]] to identify the facility. To provide other details, [[healthcareReportingData]] can be used on a [[Hospital]] entry." ;
    schema:name "cvd facility county" .

schema:cvdFacilityId a rdf:Property ;
    schema:description "Identifier of the NHSN facility that this data record applies to. Use [[cvdFacilityCounty]] to indicate the county. To provide other details, [[healthcareReportingData]] can be used on a [[Hospital]] entry." ;
    schema:name "cvd facility id" .

schema:cvdNumBeds a rdf:Property ;
    schema:description "numbeds - HOSPITAL INPATIENT BEDS: Inpatient beds, including all staffed, licensed, and overflow (surge) beds used for inpatients." ;
    schema:name "cvd num beds" .

schema:cvdNumBedsOcc a rdf:Property ;
    schema:description "numbedsocc - HOSPITAL INPATIENT BED OCCUPANCY: Total number of staffed inpatient beds that are occupied." ;
    schema:name "cvd num beds occ" .

schema:cvdNumC19Died a rdf:Property ;
    schema:description "numc19died - DEATHS: Patients with suspected or confirmed COVID-19 who died in the hospital, ED, or any overflow location." ;
    schema:name "cvd num c19 died" .

schema:cvdNumC19HOPats a rdf:Property ;
    schema:description "numc19hopats - HOSPITAL ONSET: Patients hospitalized in an NHSN inpatient care location with onset of suspected or confirmed COVID-19 14 or more days after hospitalization." ;
    schema:name "cvd num c19 ho pats" .

schema:cvdNumC19HospPats a rdf:Property ;
    schema:description "numc19hosppats - HOSPITALIZED: Patients currently hospitalized in an inpatient care location who have suspected or confirmed COVID-19." ;
    schema:name "cvd num c19 hosp pats" .

schema:cvdNumC19MechVentPats a rdf:Property ;
    schema:description "numc19mechventpats - HOSPITALIZED and VENTILATED: Patients hospitalized in an NHSN inpatient care location who have suspected or confirmed COVID-19 and are on a mechanical ventilator." ;
    schema:name "cvd num c19 mech vent pats" .

schema:cvdNumC19OFMechVentPats a rdf:Property ;
    schema:description "numc19ofmechventpats - ED/OVERFLOW and VENTILATED: Patients with suspected or confirmed COVID-19 who are in the ED or any overflow location awaiting an inpatient bed and on a mechanical ventilator." ;
    schema:name "cvd num c19 of mech vent pats" .

schema:cvdNumC19OverflowPats a rdf:Property ;
    schema:description "numc19overflowpats - ED/OVERFLOW: Patients with suspected or confirmed COVID-19 who are in the ED or any overflow location awaiting an inpatient bed." ;
    schema:name "cvd num c19 overflow pats" .

schema:cvdNumICUBeds a rdf:Property ;
    schema:description "numicubeds - ICU BEDS: Total number of staffed inpatient intensive care unit (ICU) beds." ;
    schema:name "cvd num icu beds" .

schema:cvdNumICUBedsOcc a rdf:Property ;
    schema:description "numicubedsocc - ICU BED OCCUPANCY: Total number of staffed inpatient ICU beds that are occupied." ;
    schema:name "cvd num icu beds occ" .

schema:cvdNumTotBeds a rdf:Property ;
    schema:description "numtotbeds - ALL HOSPITAL BEDS: Total number of all Inpatient and outpatient beds, including all staffed,ICU, licensed, and overflow (surge) beds used for inpatients or outpatients." ;
    schema:name "cvd num tot beds" .

schema:cvdNumVent a rdf:Property ;
    schema:description "numvent - MECHANICAL VENTILATORS: Total number of ventilators available." ;
    schema:name "cvd num vent" .

schema:cvdNumVentUse a rdf:Property ;
    schema:description "numventuse - MECHANICAL VENTILATORS IN USE: Total number of ventilators in use." ;
    schema:name "cvd num vent use" .

schema:dataFeedElement a rdf:Property ;
    schema:description "An item within in a data feed. Data feeds may have many elements." ;
    schema:name "data feed element" .

schema:dataset a rdf:Property ;
    schema:description "A dataset contained in this catalog." ;
    schema:name "dataset" .

schema:datasetTimeInterval a rdf:Property ;
    schema:description "The range of temporal applicability of a dataset, e.g. for a 2011 census dataset, the year 2011 (in ISO 8601 time interval format)." ;
    schema:name "dataset time interval" .

schema:dateCreated a rdf:Property ;
    schema:description "The date on which the CreativeWork was created or the item was added to a DataFeed." ;
    schema:name "date created" .

schema:dateDeleted a rdf:Property ;
    schema:description "The datetime the item was removed from the DataFeed." ;
    schema:name "date deleted" .

schema:dateIssued a rdf:Property ;
    schema:description "The date the ticket was issued." ;
    schema:name "date issued" .

schema:dateModified a rdf:Property ;
    schema:description "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed." ;
    schema:name "date modified" .

schema:datePosted a rdf:Property ;
    schema:description "Publication date of an online listing." ;
    schema:name "date posted" .

schema:datePublished a rdf:Property ;
    schema:description "Date of first broadcast/publication." ;
    schema:name "date published" .

schema:dateRead a rdf:Property ;
    schema:description "The date/time at which the message has been read by the recipient if a single recipient exists." ;
    schema:name "date read" .

schema:dateReceived a rdf:Property ;
    schema:description "The date/time the message was received if a single recipient exists." ;
    schema:name "date received" .

schema:dateSent a rdf:Property ;
    schema:description "The date/time at which the message was sent." ;
    schema:name "date sent" .

schema:dateVehicleFirstRegistered a rdf:Property ;
    schema:description "The date of the first registration of the vehicle with the respective public authorities." ;
    schema:name "date vehicle first registered" .

schema:dateline a rdf:Property ;
    schema:description """A [dateline](https://en.wikipedia.org/wiki/Dateline) is a brief piece of text included in news articles that describes where and when the story was written or filed though the date is often omitted. Sometimes only a placename is provided.

Structured representations of dateline-related information can also be expressed more explicitly using [[locationCreated]] (which represents where a work was created e.g. where a news report was written).  For location depicted or described in the content, use [[contentLocation]].

Dateline summaries are oriented more towards human readers than towards automated processing, and can vary substantially. Some examples: "BEIRUT, Lebanon, June 2.", "Paris, France", "December 19, 2017 11:43AM Reporting from Washington", "Beijing/Moscow", "QUEZON CITY, Philippines".
      """ ;
    schema:name "dateline" .

schema:dayOfWeek a rdf:Property ;
    schema:description "The day of the week for which these opening hours are valid." ;
    schema:name "day of week" .

schema:deathDate a rdf:Property ;
    schema:description "Date of death." ;
    schema:name "death date" .

schema:deathPlace a rdf:Property ;
    schema:description "The place where the person died." ;
    schema:name "death place" .

schema:defaultValue a rdf:Property ;
    schema:description "The default value of the input.  For properties that expect a literal, the default is a literal value, for properties that expect an object, it's an ID reference to one of the current values." ;
    schema:name "default value" .

schema:deliveryAddress a rdf:Property ;
    schema:description "Destination address." ;
    schema:name "delivery address" .

schema:deliveryLeadTime a rdf:Property ;
    schema:description "The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup." ;
    schema:name "delivery lead time" .

schema:deliveryMethod a rdf:Property ;
    schema:description "A sub property of instrument. The method of delivery." ;
    schema:name "delivery method" .

schema:deliveryStatus a rdf:Property ;
    schema:description "New entry added as the package passes through each leg of its journey (from shipment to final delivery)." ;
    schema:name "delivery status" .

schema:deliveryTime a rdf:Property ;
    schema:description "The total delay between the receipt of the order and the goods reaching the final customer." ;
    schema:name "delivery time" .

schema:department a rdf:Property ;
    schema:description "A relationship between an organization and a department of that organization, also described as an organization (allowing different urls, logos, opening hours). For example: a store with a pharmacy, or a bakery with a cafe." ;
    schema:name "department" .

schema:departureAirport a rdf:Property ;
    schema:description "The airport where the flight originates." ;
    schema:name "departure airport" .

schema:departureBoatTerminal a rdf:Property ;
    schema:description "The terminal or port from which the boat departs." ;
    schema:name "departure boat terminal" .

schema:departureBusStop a rdf:Property ;
    schema:description "The stop or station from which the bus departs." ;
    schema:name "departure bus stop" .

schema:departureGate a rdf:Property ;
    schema:description "Identifier of the flight's departure gate." ;
    schema:name "departure gate" .

schema:departurePlatform a rdf:Property ;
    schema:description "The platform from which the train departs." ;
    schema:name "departure platform" .

schema:departureStation a rdf:Property ;
    schema:description "The station from which the train departs." ;
    schema:name "departure station" .

schema:departureTerminal a rdf:Property ;
    schema:description "Identifier of the flight's departure terminal." ;
    schema:name "departure terminal" .

schema:departureTime a rdf:Property ;
    schema:description "The expected departure time." ;
    schema:name "departure time" .

schema:dependencies a rdf:Property ;
    schema:description "Prerequisites needed to fulfill steps in article." ;
    schema:name "dependencies" .

schema:depth a rdf:Property ;
    schema:description "The depth of the item." ;
    schema:name "depth" .

schema:description a rdf:Property ;
    schema:description "A description of the item." ;
    schema:name "description" .

schema:device a rdf:Property ;
    schema:description "Device required to run the application. Used in cases where a specific make/model is required to run the application." ;
    schema:name "device" .

schema:diagnosis a rdf:Property ;
    schema:description "One or more alternative conditions considered in the differential diagnosis process as output of a diagnosis process." ;
    schema:name "diagnosis" .

schema:diagram a rdf:Property ;
    schema:description "An image containing a diagram that illustrates the structure and/or its component substructures and/or connections with other structures." ;
    schema:name "diagram" .

schema:diet a rdf:Property ;
    schema:description "A sub property of instrument. The diet used in this action." ;
    schema:name "diet" .

schema:dietFeatures a rdf:Property ;
    schema:description "Nutritional information specific to the dietary plan. May include dietary recommendations on what foods to avoid, what foods to consume, and specific alterations/deviations from the USDA or other regulatory body's approved dietary guidelines." ;
    schema:name "diet features" .

schema:differentialDiagnosis a rdf:Property ;
    schema:description "One of a set of differential diagnoses for the condition. Specifically, a closely-related or competing diagnosis typically considered later in the cognitive process whereby this medical condition is distinguished from others most likely responsible for a similar collection of signs and symptoms to reach the most parsimonious diagnosis or diagnoses in a patient." ;
    schema:name "differential diagnosis" .

schema:directApply a rdf:Property ;
    schema:description "Indicates whether an [[url]] that is associated with a [[JobPosting]] enables direct application for the job, via the posting website. A job posting is considered to have directApply of [[True]] if an application process for the specified job can be directly initiated via the url(s) given (noting that e.g. multiple internet domains might nevertheless be involved at an implementation level). A value of [[False]] is appropriate if there is no clear path to applying directly online for the specified job, navigating directly from the JobPosting url(s) supplied." ;
    schema:name "direct apply" .

schema:director a rdf:Property ;
    schema:description "A director of e.g. tv, radio, movie, video gaming etc. content, or of an event. Directors can be associated with individual items or with a series, episode, clip." ;
    schema:name "director" .

schema:directors a rdf:Property ;
    schema:description "A director of e.g. tv, radio, movie, video games etc. content. Directors can be associated with individual items or with a series, episode, clip." ;
    schema:name "directors" .

schema:disambiguatingDescription a rdf:Property ;
    schema:description "A sub property of description. A short description of the item used to disambiguate from other, similar items. Information from other properties (in particular, name) may be necessary for the description to be useful for disambiguation." ;
    schema:name "disambiguating description" .

schema:discount a rdf:Property ;
    schema:description "Any discount applied (to an Order)." ;
    schema:name "discount" .

schema:discountCode a rdf:Property ;
    schema:description "Code used to redeem a discount." ;
    schema:name "discount code" .

schema:discountCurrency a rdf:Property ;
    schema:description "The currency of the discount.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." ;
    schema:name "discount currency" .

schema:discusses a rdf:Property ;
    schema:description "Specifies the CreativeWork associated with the UserComment." ;
    schema:name "discusses" .

schema:discussionUrl a rdf:Property ;
    schema:description "A link to the page containing the comments of the CreativeWork." ;
    schema:name "discussion url" .

schema:diseasePreventionInfo a rdf:Property ;
    schema:description "Information about disease prevention." ;
    schema:name "disease prevention info" .

schema:diseaseSpreadStatistics a rdf:Property ;
    schema:description """Statistical information about the spread of a disease, either as [[WebContent]], or
  described directly as a [[Dataset]], or the specific [[Observation]]s in the dataset. When a [[WebContent]] URL is
  provided, the page indicated might also contain more such markup.""" ;
    schema:name "disease spread statistics" .

schema:dissolutionDate a rdf:Property ;
    schema:description "The date that this organization was dissolved." ;
    schema:name "dissolution date" .

schema:distance a rdf:Property ;
    schema:description "The distance travelled, e.g. exercising or travelling." ;
    schema:name "distance" .

schema:distinguishingSign a rdf:Property ;
    schema:description "One of a set of signs and symptoms that can be used to distinguish this diagnosis from others in the differential diagnosis." ;
    schema:name "distinguishing sign" .

schema:distribution a rdf:Property ;
    schema:description "A downloadable form of this dataset, at a specific location, in a specific format." ;
    schema:name "distribution" .

schema:diversityPolicy a rdf:Property ;
    schema:description "Statement on diversity policy by an [[Organization]] e.g. a [[NewsMediaOrganization]]. For a [[NewsMediaOrganization]], a statement describing the newsroom’s diversity policy on both staffing and sources, typically providing staffing data." ;
    schema:name "diversity policy" .

schema:diversityStaffingReport a rdf:Property ;
    schema:description "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a report on staffing diversity issues. In a news context this might be for example ASNE or RTDNA (US) reports, or self-reported." ;
    schema:name "diversity staffing report" .

schema:documentation a rdf:Property ;
    schema:description "Further documentation describing the Web API in more detail." ;
    schema:name "documentation" .

schema:doesNotShip a rdf:Property ;
    schema:description "Indicates when shipping to a particular [[shippingDestination]] is not available." ;
    schema:name "does not ship" .

schema:domainIncludes a rdf:Property ;
    schema:description "Relates a property to a class that is (one of) the type(s) the property is expected to be used on." ;
    schema:name "domain includes" .

schema:domiciledMortgage a rdf:Property ;
    schema:description "Whether borrower is a resident of the jurisdiction where the property is located." ;
    schema:name "domiciled mortgage" .

schema:doorTime a rdf:Property ;
    schema:description "The time admission will commence." ;
    schema:name "door time" .

schema:dosageForm a rdf:Property ;
    schema:description "A dosage form in which this drug/supplement is available, e.g. 'tablet', 'suspension', 'injection'." ;
    schema:name "dosage form" .

schema:doseSchedule a rdf:Property ;
    schema:description "A dosing schedule for the drug for a given population, either observed, recommended, or maximum dose based on the type used." ;
    schema:name "dose schedule" .

schema:doseUnit a rdf:Property ;
    schema:description "The unit of the dose, e.g. 'mg'." ;
    schema:name "dose unit" .

schema:doseValue a rdf:Property ;
    schema:description "The value of the dose, e.g. 500." ;
    schema:name "dose value" .

schema:downPayment a rdf:Property ;
    schema:description "a type of payment made in cash during the onset of the purchase of an expensive good/service. The payment typically represents only a percentage of the full purchase price." ;
    schema:name "down payment" .

schema:downloadUrl a rdf:Property ;
    schema:description "If the file can be downloaded, URL to download the binary." ;
    schema:name "download url" .

schema:downvoteCount a rdf:Property ;
    schema:description "The number of downvotes this question, answer or comment has received from the community." ;
    schema:name "downvote count" .

schema:drainsTo a rdf:Property ;
    schema:description "The vasculature that the vein drains into." ;
    schema:name "drains to" .

schema:driveWheelConfiguration a rdf:Property ;
    schema:description "The drive wheel configuration, i.e. which roadwheels will receive torque from the vehicle's engine via the drivetrain." ;
    schema:name "drive wheel configuration" .

schema:dropoffLocation a rdf:Property ;
    schema:description "Where a rental car can be dropped off." ;
    schema:name "dropoff location" .

schema:dropoffTime a rdf:Property ;
    schema:description "When a rental car can be dropped off." ;
    schema:name "dropoff time" .

schema:drug a rdf:Property ;
    schema:description "Specifying a drug or medicine used in a medication procedure." ;
    schema:name "drug" .

schema:drugClass a rdf:Property ;
    schema:description "The class of drug this belongs to (e.g., statins)." ;
    schema:name "drug class" .

schema:drugUnit a rdf:Property ;
    schema:description "The unit in which the drug is measured, e.g. '5 mg tablet'." ;
    schema:name "drug unit" .

schema:duns a rdf:Property ;
    schema:description "The Dun & Bradstreet DUNS number for identifying an organization or business person." ;
    schema:name "duns" .

schema:duplicateTherapy a rdf:Property ;
    schema:description "A therapy that duplicates or overlaps this one." ;
    schema:name "duplicate therapy" .

schema:duration a rdf:Property ;
    schema:description "The duration of the item (movie, audio recording, event, etc.) in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    schema:name "duration" .

schema:durationOfWarranty a rdf:Property ;
    schema:description "The duration of the warranty promise. Common unitCode values are ANN for year, MON for months, or DAY for days." ;
    schema:name "duration of warranty" .

schema:duringMedia a rdf:Property ;
    schema:description "A media object representing the circumstances while performing this direction." ;
    schema:name "during media" .

schema:earlyPrepaymentPenalty a rdf:Property ;
    schema:description "The amount to be paid as a penalty in the event of early payment of the loan." ;
    schema:name "early prepayment penalty" .

schema:editEIDR a rdf:Property ;
    schema:description """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing a specific edit / edition for a work of film or television.

For example, the motion picture known as "Ghostbusters" whose [[titleEIDR]] is "10.5240/7EC7-228A-510A-053E-CBB8-J", has several edits e.g. "10.5240/1F2A-E1C5-680A-14C6-E76B-I" and "10.5240/8A35-3BEE-6497-5D12-9E4F-3".

Since schema.org types like [[Movie]] and [[TVEpisode]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" ;
    schema:name "edit eidr" .

schema:editor a rdf:Property ;
    schema:description "Specifies the Person who edited the CreativeWork." ;
    schema:name "editor" .

schema:eduQuestionType a rdf:Property ;
    schema:description "For questions that are part of learning resources (e.g. Quiz), eduQuestionType indicates the format of question being given. Example: \"Multiple choice\", \"Open ended\", \"Flashcard\"." ;
    schema:name "edu question type" .

schema:educationRequirements a rdf:Property ;
    schema:description "Educational background needed for the position or Occupation." ;
    schema:name "education requirements" .

schema:educationalAlignment a rdf:Property ;
    schema:description """An alignment to an established educational framework.

This property should not be used where the nature of the alignment can be described using a simple property, for example to express that a resource [[teaches]] or [[assesses]] a competency.""" ;
    schema:name "educational alignment" .

schema:educationalCredentialAwarded a rdf:Property ;
    schema:description "A description of the qualification, award, certificate, diploma or other educational credential awarded as a consequence of successful completion of this course or program." ;
    schema:name "educational credential awarded" .

schema:educationalFramework a rdf:Property ;
    schema:description "The framework to which the resource being described is aligned." ;
    schema:name "educational framework" .

schema:educationalLevel a rdf:Property ;
    schema:description "The level in terms of progression through an educational or training context. Examples of educational levels include 'beginner', 'intermediate' or 'advanced', and formal sets of level indicators." ;
    schema:name "educational level" .

schema:educationalProgramMode a rdf:Property ;
    schema:description "Similar to courseMode, The medium or means of delivery of the program as a whole. The value may either be a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous )." ;
    schema:name "educational program mode" .

schema:educationalRole a rdf:Property ;
    schema:description "An educationalRole of an EducationalAudience." ;
    schema:name "educational role" .

schema:educationalUse a rdf:Property ;
    schema:description "The purpose of a work in the context of education; for example, 'assignment', 'group work'." ;
    schema:name "educational use" .

schema:elevation a rdf:Property ;
    schema:description "The elevation of a location ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System)). Values may be of the form 'NUMBER UNIT_OF_MEASUREMENT' (e.g., '1,000 m', '3,200 ft') while numbers alone should be assumed to be a value in meters." ;
    schema:name "elevation" .

schema:eligibilityToWorkRequirement a rdf:Property ;
    schema:description "The legal requirements such as citizenship, visa and other documentation required for an applicant to this job." ;
    schema:name "eligibility to work requirement" .

schema:eligibleCustomerType a rdf:Property ;
    schema:description "The type(s) of customers for which the given offer is valid." ;
    schema:name "eligible customer type" .

schema:eligibleDuration a rdf:Property ;
    schema:description "The duration for which the given offer is valid." ;
    schema:name "eligible duration" .

schema:eligibleQuantity a rdf:Property ;
    schema:description "The interval and unit of measurement of ordering quantities for which the offer or price specification is valid. This allows e.g. specifying that a certain freight charge is valid only for a certain quantity." ;
    schema:name "eligible quantity" .

schema:eligibleRegion a rdf:Property ;
    schema:description """The ISO 3166-1 (ISO 3166-1 alpha-2) or ISO 3166-2 code, the place, or the GeoShape for the geo-political region(s) for which the offer or delivery charge specification is valid.\\n\\nSee also [[ineligibleRegion]].
    """ ;
    schema:name "eligible region" .

schema:eligibleTransactionVolume a rdf:Property ;
    schema:description "The transaction volume, in a monetary unit, for which the offer or price specification is valid, e.g. for indicating a minimal purchasing volume, to express free shipping above a certain order volume, or to limit the acceptance of credit cards to purchases to a certain minimal amount." ;
    schema:name "eligible transaction volume" .

schema:email a rdf:Property ;
    schema:description "Email address." ;
    schema:name "email" .

schema:embedUrl a rdf:Property ;
    schema:description "A URL pointing to a player for a specific video. In general, this is the information in the ```src``` element of an ```embed``` tag and should not be the same as the content of the ```loc``` tag." ;
    schema:name "embed url" .

schema:embeddedTextCaption a rdf:Property ;
    schema:description "Represents textual captioning from a [[MediaObject]], e.g. text of a 'meme'." ;
    schema:name "embedded text caption" .

schema:emissionsCO2 a rdf:Property ;
    schema:description "The CO2 emissions in g/km. When used in combination with a QuantitativeValue, put \"g/km\" into the unitText property of that value, since there is no UN/CEFACT Common Code for \"g/km\"." ;
    schema:name "emissions co2" .

schema:employee a rdf:Property ;
    schema:description "Someone working for this organization." ;
    schema:name "employee" .

schema:employees a rdf:Property ;
    schema:description "People working for this organization." ;
    schema:name "employees" .

schema:employerOverview a rdf:Property ;
    schema:description "A description of the employer, career opportunities and work environment for this position." ;
    schema:name "employer overview" .

schema:employmentType a rdf:Property ;
    schema:description "Type of employment (e.g. full-time, part-time, contract, temporary, seasonal, internship)." ;
    schema:name "employment type" .

schema:employmentUnit a rdf:Property ;
    schema:description "Indicates the department, unit and/or facility where the employee reports and/or in which the job is to be performed." ;
    schema:name "employment unit" .

schema:encodesBioChemEntity a rdf:Property ;
    schema:description "Another BioChemEntity encoded by this one. " ;
    schema:name "encodes bio chem entity" .

schema:encodesCreativeWork a rdf:Property ;
    schema:description "The CreativeWork encoded by this media object." ;
    schema:name "encodes creative work" .

schema:encoding a rdf:Property ;
    schema:description "A media object that encodes this CreativeWork. This property is a synonym for associatedMedia." ;
    schema:name "encoding" .

schema:encodingFormat a rdf:Property ;
    schema:description """Media type typically expressed using a MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml) and [MDN reference](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types)) e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.).

In cases where a [[CreativeWork]] has several media type representations, [[encoding]] can be used to indicate each [[MediaObject]] alongside particular [[encodingFormat]] information.

Unregistered or niche encoding and file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia/Wikidata entry.""" ;
    schema:name "encoding format" .

schema:encodingType a rdf:Property ;
    schema:description "The supported encoding type(s) for an EntryPoint request." ;
    schema:name "encoding type" .

schema:encodings a rdf:Property ;
    schema:description "A media object that encodes this CreativeWork." ;
    schema:name "encodings" .

schema:endDate a rdf:Property ;
    schema:description "The end date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." ;
    schema:name "end date" .

schema:endOffset a rdf:Property ;
    schema:description "The end time of the clip expressed as the number of seconds from the beginning of the work." ;
    schema:name "end offset" .

schema:endTime a rdf:Property ;
    schema:description "The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. e.g. John wrote a book from January to *December*. For media, including audio and video, it's the time offset of the end of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." ;
    schema:name "end time" .

schema:endorsee a rdf:Property ;
    schema:description "A sub property of participant. The person/organization being supported." ;
    schema:name "endorsee" .

schema:endorsers a rdf:Property ;
    schema:description "People or organizations that endorse the plan." ;
    schema:name "endorsers" .

schema:energyEfficiencyScaleMax a rdf:Property ;
    schema:description "Specifies the most energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." ;
    schema:name "energy efficiency scale max" .

schema:energyEfficiencyScaleMin a rdf:Property ;
    schema:description "Specifies the least energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." ;
    schema:name "energy efficiency scale min" .

schema:engineDisplacement a rdf:Property ;
    schema:description "The volume swept by all of the pistons inside the cylinders of an internal combustion engine in a single movement. \\n\\nTypical unit code(s): CMQ for cubic centimeter, LTR for liters, INQ for cubic inches\\n* Note 1: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "engine displacement" .

schema:enginePower a rdf:Property ;
    schema:description """The power of the vehicle's engine.
    Typical unit code(s): KWT for kilowatt, BHP for brake horsepower, N12 for metric horsepower (PS, with 1 PS = 735,49875 W)\\n\\n* Note 1: There are many different ways of measuring an engine's power. For an overview, see  [http://en.wikipedia.org/wiki/Horsepower#Engine_power_test_codes](http://en.wikipedia.org/wiki/Horsepower#Engine_power_test_codes).\\n* Note 2: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 3: You can use [[minValue]] and [[maxValue]] to indicate ranges.""" ;
    schema:name "engine power" .

schema:engineType a rdf:Property ;
    schema:description "The type of engine or engines powering the vehicle." ;
    schema:name "engine type" .

schema:entertainmentBusiness a rdf:Property ;
    schema:description "A sub property of location. The entertainment business where the action occurred." ;
    schema:name "entertainment business" .

schema:epidemiology a rdf:Property ;
    schema:description "The characteristics of associated patients, such as age, gender, race etc." ;
    schema:name "epidemiology" .

schema:episode a rdf:Property ;
    schema:description "An episode of a tv, radio or game media within a series or season." ;
    schema:name "episode" .

schema:episodeNumber a rdf:Property ;
    schema:description "Position of the episode within an ordered group of episodes." ;
    schema:name "episode number" .

schema:episodes a rdf:Property ;
    schema:description "An episode of a TV/radio series or season." ;
    schema:name "episodes" .

schema:equal a rdf:Property ;
    schema:description "This ordering relation for qualitative values indicates that the subject is equal to the object." ;
    schema:name "equal" .

schema:error a rdf:Property ;
    schema:description "For failed actions, more information on the cause of the failure." ;
    schema:name "error" .

schema:estimatedCost a rdf:Property ;
    schema:description "The estimated cost of the supply or supplies consumed when performing instructions." ;
    schema:name "estimated cost" .

schema:estimatedFlightDuration a rdf:Property ;
    schema:description "The estimated time the flight will take." ;
    schema:name "estimated flight duration" .

schema:estimatedSalary a rdf:Property ;
    schema:description "An estimated salary for a job posting or occupation, based on a variety of variables including, but not limited to industry, job title, and location. Estimated salaries  are often computed by outside organizations rather than the hiring organization, who may not have committed to the estimated value." ;
    schema:name "estimated salary" .

schema:estimatesRiskOf a rdf:Property ;
    schema:description "The condition, complication, or symptom whose risk is being estimated." ;
    schema:name "estimates risk of" .

schema:ethicsPolicy a rdf:Property ;
    schema:description "Statement about ethics policy, e.g. of a [[NewsMediaOrganization]] regarding journalistic and publishing practices, or of a [[Restaurant]], a page describing food source policies. In the case of a [[NewsMediaOrganization]], an ethicsPolicy is typically a statement describing the personal, organizational, and corporate standards of behavior expected by the organization." ;
    schema:name "ethics policy" .

schema:event a rdf:Property ;
    schema:description "Upcoming or past event associated with this place, organization, or action." ;
    schema:name "event" .

schema:eventAttendanceMode a rdf:Property ;
    schema:description "The eventAttendanceMode of an event indicates whether it occurs online, offline, or a mix." ;
    schema:name "event attendance mode" .

schema:eventSchedule a rdf:Property ;
    schema:description """Associates an [[Event]] with a [[Schedule]]. There are circumstances where it is preferable to share a schedule for a series of
      repeating events rather than data on the individual events themselves. For example, a website or application might prefer to publish a schedule for a weekly
      gym class rather than provide data on every event. A schedule could be processed by applications to add forthcoming events to a calendar. An [[Event]] that
      is associated with a [[Schedule]] using this property should not have [[startDate]] or [[endDate]] properties. These are instead defined within the associated
      [[Schedule]], this avoids any ambiguity for clients using the data. The property might have repeated values to specify different schedules, e.g. for different months
      or seasons.""" ;
    schema:name "event schedule" .

schema:eventStatus a rdf:Property ;
    schema:description "An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled." ;
    schema:name "event status" .

schema:events a rdf:Property ;
    schema:description "Upcoming or past events associated with this place or organization." ;
    schema:name "events" .

schema:evidenceLevel a rdf:Property ;
    schema:description "Strength of evidence of the data used to formulate the guideline (enumerated)." ;
    schema:name "evidence level" .

schema:evidenceOrigin a rdf:Property ;
    schema:description "Source of the data used to formulate the guidance, e.g. RCT, consensus opinion, etc." ;
    schema:name "evidence origin" .

schema:exampleOfWork a rdf:Property ;
    schema:description "A creative work that this work is an example/instance/realization/derivation of." ;
    schema:name "example of work" .

schema:exceptDate a rdf:Property ;
    schema:description """Defines a [[Date]] or [[DateTime]] during which a scheduled [[Event]] will not take place. The property allows exceptions to
      a [[Schedule]] to be specified. If an exception is specified as a [[DateTime]] then only the event that would have started at that specific date and time
      should be excluded from the schedule. If an exception is specified as a [[Date]] then any event that is scheduled for that 24 hour period should be
      excluded from the schedule. This allows a whole day to be excluded from the schedule without having to itemise every scheduled event.""" ;
    schema:name "except date" .

schema:exchangeRateSpread a rdf:Property ;
    schema:description "The difference between the price at which a broker or other intermediary buys and sells foreign currency." ;
    schema:name "exchange rate spread" .

schema:executableLibraryName a rdf:Property ;
    schema:description "Library file name e.g., mscorlib.dll, system.web.dll." ;
    schema:name "executable library name" .

schema:exerciseCourse a rdf:Property ;
    schema:description "A sub property of location. The course where this action was taken." ;
    schema:name "exercise course" .

schema:exercisePlan a rdf:Property ;
    schema:description "A sub property of instrument. The exercise plan used on this action." ;
    schema:name "exercise plan" .

schema:exerciseRelatedDiet a rdf:Property ;
    schema:description "A sub property of instrument. The diet used in this action." ;
    schema:name "exercise related diet" .

schema:exerciseType a rdf:Property ;
    schema:description "Type(s) of exercise or activity, such as strength training, flexibility training, aerobics, cardiac rehabilitation, etc." ;
    schema:name "exercise type" .

schema:exifData a rdf:Property ;
    schema:description "exif data for this object." ;
    schema:name "exif data" .

schema:expectedArrivalFrom a rdf:Property ;
    schema:description "The earliest date the package may arrive." ;
    schema:name "expected arrival from" .

schema:expectedArrivalUntil a rdf:Property ;
    schema:description "The latest date the package may arrive." ;
    schema:name "expected arrival until" .

schema:expectedPrognosis a rdf:Property ;
    schema:description "The likely outcome in either the short term or long term of the medical condition." ;
    schema:name "expected prognosis" .

schema:expectsAcceptanceOf a rdf:Property ;
    schema:description "An Offer which must be accepted before the user can perform the Action. For example, the user may need to buy a movie before being able to watch it." ;
    schema:name "expects acceptance of" .

schema:experienceInPlaceOfEducation a rdf:Property ;
    schema:description "Indicates whether a [[JobPosting]] will accept experience (as indicated by [[OccupationalExperienceRequirements]]) in place of its formal educational qualifications (as indicated by [[educationRequirements]]). If true, indicates that satisfying one of these requirements is sufficient." ;
    schema:name "experience in place of education" .

schema:experienceRequirements a rdf:Property ;
    schema:description "Description of skills and experience needed for the position or Occupation." ;
    schema:name "experience requirements" .

schema:expertConsiderations a rdf:Property ;
    schema:description "Medical expert advice related to the plan." ;
    schema:name "expert considerations" .

schema:expires a rdf:Property ;
    schema:description "Date the content expires and is no longer useful or available. For example a [[VideoObject]] or [[NewsArticle]] whose availability or relevance is time-limited, or a [[ClaimReview]] fact check whose publisher wants to indicate that it may no longer be relevant (or helpful to highlight) after some date." ;
    schema:name "expires" .

schema:expressedIn a rdf:Property ;
    schema:description "Tissue, organ, biological sample, etc in which activity of this gene has been observed experimentally. For example brain, digestive system." ;
    schema:name "expressed in" .

schema:familyName a rdf:Property ;
    schema:description "Family name. In the U.S., the last name of a Person." ;
    schema:name "family name" .

schema:fatContent a rdf:Property ;
    schema:description "The number of grams of fat." ;
    schema:name "fat content" .

schema:faxNumber a rdf:Property ;
    schema:description "The fax number." ;
    schema:name "fax number" .

schema:featureList a rdf:Property ;
    schema:description "Features or modules provided by this application (and possibly required by other applications)." ;
    schema:name "feature list" .

schema:feesAndCommissionsSpecification a rdf:Property ;
    schema:description "Description of fees, commissions, and other terms applied either to a class of financial product, or by a financial service organization." ;
    schema:name "fees and commissions specification" .

schema:fiberContent a rdf:Property ;
    schema:description "The number of grams of fiber." ;
    schema:name "fiber content" .

schema:fileFormat a rdf:Property ;
    schema:description "Media type, typically MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml)) of the content e.g. application/zip of a SoftwareApplication binary. In cases where a CreativeWork has several media type representations, 'encoding' can be used to indicate each MediaObject alongside particular fileFormat information. Unregistered or niche file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia entry." ;
    schema:name "file format" .

schema:fileSize a rdf:Property ;
    schema:description "Size of the application / package (e.g. 18MB). In the absence of a unit (MB, KB etc.), KB will be assumed." ;
    schema:name "file size" .

schema:financialAidEligible a rdf:Property ;
    schema:description "A financial aid type or program which students may use to pay for tuition or fees associated with the program." ;
    schema:name "financial aid eligible" .

schema:firstAppearance a rdf:Property ;
    schema:description "Indicates the first known occurence of a [[Claim]] in some [[CreativeWork]]." ;
    schema:name "first appearance" .

schema:firstPerformance a rdf:Property ;
    schema:description "The date and place the work was first performed." ;
    schema:name "first performance" .

schema:flightDistance a rdf:Property ;
    schema:description "The distance of the flight." ;
    schema:name "flight distance" .

schema:flightNumber a rdf:Property ;
    schema:description "The unique identifier for a flight including the airline IATA code. For example, if describing United flight 110, where the IATA code for United is 'UA', the flightNumber is 'UA110'." ;
    schema:name "flight number" .

schema:floorLevel a rdf:Property ;
    schema:description """The floor level for an [[Accommodation]] in a multi-storey building. Since counting
  systems [vary internationally](https://en.wikipedia.org/wiki/Storey#Consecutive_number_floor_designations), the local system should be used where possible.""" ;
    schema:name "floor level" .

schema:floorLimit a rdf:Property ;
    schema:description "A floor limit is the amount of money above which credit card transactions must be authorized." ;
    schema:name "floor limit" .

schema:floorSize a rdf:Property ;
    schema:description """The size of the accommodation, e.g. in square meter or squarefoot.
Typical unit code(s): MTK for square meter, FTK for square foot, or YDK for square yard """ ;
    schema:name "floor size" .

schema:followee a rdf:Property ;
    schema:description "A sub property of object. The person or organization being followed." ;
    schema:name "followee" .

schema:follows a rdf:Property ;
    schema:description "The most generic uni-directional social relation." ;
    schema:name "follows" .

schema:followup a rdf:Property ;
    schema:description "Typical or recommended followup care after the procedure is performed." ;
    schema:name "followup" .

schema:foodEstablishment a rdf:Property ;
    schema:description "A sub property of location. The specific food establishment where the action occurred." ;
    schema:name "food establishment" .

schema:foodEvent a rdf:Property ;
    schema:description "A sub property of location. The specific food event where the action occurred." ;
    schema:name "food event" .

schema:foodWarning a rdf:Property ;
    schema:description "Any precaution, guidance, contraindication, etc. related to consumption of specific foods while taking this drug." ;
    schema:name "food warning" .

schema:founder a rdf:Property ;
    schema:description "A person who founded this organization." ;
    schema:name "founder" .

schema:founders a rdf:Property ;
    schema:description "A person who founded this organization." ;
    schema:name "founders" .

schema:foundingDate a rdf:Property ;
    schema:description "The date that this organization was founded." ;
    schema:name "founding date" .

schema:foundingLocation a rdf:Property ;
    schema:description "The place where the Organization was founded." ;
    schema:name "founding location" .

schema:free a rdf:Property ;
    schema:description "A flag to signal that the item, event, or place is accessible for free." ;
    schema:name "free" .

schema:freeShippingThreshold a rdf:Property ;
    schema:description "A monetary value above which (or equal to) the shipping rate becomes free. Intended to be used via an [[OfferShippingDetails]] with [[shippingSettingsLink]] matching this [[ShippingRateSettings]]." ;
    schema:name "free shipping threshold" .

schema:frequency a rdf:Property ;
    schema:description "How often the dose is taken, e.g. 'daily'." ;
    schema:name "frequency" .

schema:fromLocation a rdf:Property ;
    schema:description "A sub property of location. The original location of the object or the agent before the action." ;
    schema:name "from location" .

schema:fuelCapacity a rdf:Property ;
    schema:description "The capacity of the fuel tank or in the case of electric cars, the battery. If there are multiple components for storage, this should indicate the total of all storage of the same type.\\n\\nTypical unit code(s): LTR for liters, GLL of US gallons, GLI for UK / imperial gallons, AMH for ampere-hours (for electrical vehicles)." ;
    schema:name "fuel capacity" .

schema:fuelConsumption a rdf:Property ;
    schema:description "The amount of fuel consumed for traveling a particular distance or temporal duration with the given vehicle (e.g. liters per 100 km).\\n\\n* Note 1: There are unfortunately no standard unit codes for liters per 100 km.  Use [[unitText]] to indicate the unit of measurement, e.g. L/100 km.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel consumption to another value." ;
    schema:name "fuel consumption" .

schema:fuelEfficiency a rdf:Property ;
    schema:description "The distance traveled per unit of fuel used; most commonly miles per gallon (mpg) or kilometers per liter (km/L).\\n\\n* Note 1: There are unfortunately no standard unit codes for miles per gallon or kilometers per liter. Use [[unitText]] to indicate the unit of measurement, e.g. mpg or km/L.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel economy to another value." ;
    schema:name "fuel efficiency" .

schema:fuelType a rdf:Property ;
    schema:description "The type of fuel suitable for the engine or engines of the vehicle. If the vehicle has only one engine, this property can be attached directly to the vehicle." ;
    schema:name "fuel type" .

schema:functionalClass a rdf:Property ;
    schema:description "The degree of mobility the joint allows." ;
    schema:name "functional class" .

schema:fundedItem a rdf:Property ;
    schema:description "Indicates an item funded or sponsored through a [[Grant]]." ;
    schema:name "funded item" .

schema:funder a rdf:Property ;
    schema:description "A person or organization that supports (sponsors) something through some kind of financial contribution." ;
    schema:name "funder" .

schema:game a rdf:Property ;
    schema:description "Video game which is played on this server." ;
    schema:name "game" .

schema:gameItem a rdf:Property ;
    schema:description "An item is an object within the game world that can be collected by a player or, occasionally, a non-player character." ;
    schema:name "game item" .

schema:gameLocation a rdf:Property ;
    schema:description "Real or fictional location of the game (or part of game)." ;
    schema:name "game location" .

schema:gamePlatform a rdf:Property ;
    schema:description "The electronic systems used to play <a href=\"http://en.wikipedia.org/wiki/Category:Video_game_platforms\">video games</a>." ;
    schema:name "game platform" .

schema:gameServer a rdf:Property ;
    schema:description "The server on which  it is possible to play the game." ;
    schema:name "game server" .

schema:gameTip a rdf:Property ;
    schema:description "Links to tips, tactics, etc." ;
    schema:name "game tip" .

schema:gender a rdf:Property ;
    schema:description "Gender of something, typically a [[Person]], but possibly also fictional characters, animals, etc. While https://schema.org/Male and https://schema.org/Female may be used, text strings are also acceptable for people who do not identify as a binary gender. The [[gender]] property can also be used in an extended sense to cover e.g. the gender of sports teams. As with the gender of individuals, we do not try to enumerate all possibilities. A mixed-gender [[SportsTeam]] can be indicated with a text value of \"Mixed\"." ;
    schema:name "gender" .

schema:genre a rdf:Property ;
    schema:description "Genre of the creative work, broadcast channel or group." ;
    schema:name "genre" .

schema:geo a rdf:Property ;
    schema:description "The geo coordinates of the place." ;
    schema:name "geo" .

schema:geoContains a rdf:Property ;
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a containing geometry to a contained geometry. \"a contains b iff no points of b lie in the exterior of a, and at least one point of the interior of b lies in the interior of a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo contains" .

schema:geoCoveredBy a rdf:Property ;
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that covers it. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo covered by" .

schema:geoCovers a rdf:Property ;
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a covering geometry to a covered geometry. \"Every point of b is a point of (the interior or boundary of) a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo covers" .

schema:geoCrosses a rdf:Property ;
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that crosses it: \"a crosses b: they have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo crosses" .

schema:geoDisjoint a rdf:Property ;
    schema:description "Represents spatial relations in which two geometries (or the places they represent) are topologically disjoint: they have no point in common. They form a set of disconnected geometries.\" (a symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM))" ;
    schema:name "geo disjoint" .

schema:geoEquals a rdf:Property ;
    schema:description "Represents spatial relations in which two geometries (or the places they represent) are topologically equal, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM). \"Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other\" (a symmetric relationship)" ;
    schema:name "geo equals" .

schema:geoIntersects a rdf:Property ;
    schema:description "Represents spatial relations in which two geometries (or the places they represent) have at least one point in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo intersects" .

schema:geoMidpoint a rdf:Property ;
    schema:description "Indicates the GeoCoordinates at the centre of a GeoShape e.g. GeoCircle." ;
    schema:name "geo midpoint" .

schema:geoOverlaps a rdf:Property ;
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that geospatially overlaps it, i.e. they have some but not all points in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo overlaps" .

schema:geoRadius a rdf:Property ;
    schema:description "Indicates the approximate radius of a GeoCircle (metres unless indicated otherwise via Distance notation)." ;
    schema:name "geo radius" .

schema:geoTouches a rdf:Property ;
    schema:description "Represents spatial relations in which two geometries (or the places they represent) touch: they have at least one boundary point in common, but no interior points.\" (a symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM) )" ;
    schema:name "geo touches" .

schema:geoWithin a rdf:Property ;
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to one that contains it, i.e. it is inside (i.e. within) its interior. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geo within" .

schema:geographicArea a rdf:Property ;
    schema:description "The geographic area associated with the audience." ;
    schema:name "geographic area" .

schema:gettingTestedInfo a rdf:Property ;
    schema:description "Information about getting tested (for a [[MedicalCondition]]), e.g. in the context of a pandemic." ;
    schema:name "getting tested info" .

schema:givenName a rdf:Property ;
    schema:description "Given name. In the U.S., the first name of a Person." ;
    schema:name "given name" .

schema:globalLocationNumber a rdf:Property ;
    schema:description "The [Global Location Number](http://www.gs1.org/gln) (GLN, sometimes also referred to as International Location Number or ILN) of the respective organization, person, or place. The GLN is a 13-digit number used to identify parties and physical locations." ;
    schema:name "global location number" .

schema:governmentBenefitsInfo a rdf:Property ;
    schema:description "governmentBenefitsInfo provides information about government benefits associated with a SpecialAnnouncement." ;
    schema:name "government benefits info" .

schema:gracePeriod a rdf:Property ;
    schema:description "The period of time after any due date that the borrower has to fulfil its obligations before a default (failure to pay) is deemed to have occurred." ;
    schema:name "grace period" .

schema:grantee a rdf:Property ;
    schema:description "The person, organization, contact point, or audience that has been granted this permission." ;
    schema:name "grantee" .

schema:greater a rdf:Property ;
    schema:description "This ordering relation for qualitative values indicates that the subject is greater than the object." ;
    schema:name "greater" .

schema:greaterOrEqual a rdf:Property ;
    schema:description "This ordering relation for qualitative values indicates that the subject is greater than or equal to the object." ;
    schema:name "greater or equal" .

schema:gtin a rdf:Property ;
    schema:description """A Global Trade Item Number ([GTIN](https://www.gs1.org/standards/id-keys/gtin)). GTINs identify trade items, including products and services, using numeric identification codes. The [[gtin]] property generalizes the earlier [[gtin8]], [[gtin12]], [[gtin13]], and [[gtin14]] properties. The GS1 [digital link specifications](https://www.gs1.org/standards/Digital-Link/) express GTINs as URLs. A correct [[gtin]] value should be a valid GTIN, which means that it should be an all-numeric string of either 8, 12, 13 or 14 digits, or a "GS1 Digital Link" URL based on such a string. The numeric component should also have a [valid GS1 check digit](https://www.gs1.org/services/check-digit-calculator) and meet the other rules for valid GTINs. See also [GS1's GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) and [Wikipedia](https://en.wikipedia.org/wiki/Global_Trade_Item_Number) for more details. Left-padding of the gtin values is not required or encouraged.
   """ ;
    schema:name "gtin" .

schema:gtin12 a rdf:Property ;
    schema:description "The GTIN-12 code of the product, or the product to which the offer refers. The GTIN-12 is the 12-digit GS1 Identification Key composed of a U.P.C. Company Prefix, Item Reference, and Check Digit used to identify trade items. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    schema:name "gtin12" .

schema:gtin13 a rdf:Property ;
    schema:description "The GTIN-13 code of the product, or the product to which the offer refers. This is equivalent to 13-digit ISBN codes and EAN UCC-13. Former 12-digit UPC codes can be converted into a GTIN-13 code by simply adding a preceding zero. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    schema:name "gtin13" .

schema:gtin14 a rdf:Property ;
    schema:description "The GTIN-14 code of the product, or the product to which the offer refers. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    schema:name "gtin14" .

schema:gtin8 a rdf:Property ;
    schema:description "The GTIN-8 code of the product, or the product to which the offer refers. This code is also known as EAN/UCC-8 or 8-digit EAN. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    schema:name "gtin8" .

schema:guideline a rdf:Property ;
    schema:description "A medical guideline related to this entity." ;
    schema:name "guideline" .

schema:guidelineDate a rdf:Property ;
    schema:description "Date on which this guideline's recommendation was made." ;
    schema:name "guideline date" .

schema:guidelineSubject a rdf:Property ;
    schema:description "The medical conditions, treatments, etc. that are the subject of the guideline." ;
    schema:name "guideline subject" .

schema:handlingTime a rdf:Property ;
    schema:description "The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup. Typical properties: minValue, maxValue, unitCode (d for DAY).  This is by common convention assumed to mean business days (if a unitCode is used, coded as \"d\"), i.e. only counting days when the business normally operates." ;
    schema:name "handling time" .

schema:hasBioChemEntityPart a rdf:Property ;
    schema:description "Indicates a BioChemEntity that (in some sense) has this BioChemEntity as a part. " ;
    schema:name "has bio chem entity part" .

schema:hasBioPolymerSequence a rdf:Property ;
    schema:description "A symbolic representation of a BioChemEnity. For example, a nucleotide sequence of a Gene or an amino acid sequence of a Protein." ;
    schema:name "has bio polymer sequence" .

schema:hasBroadcastChannel a rdf:Property ;
    schema:description "A broadcast channel of a broadcast service." ;
    schema:name "has broadcast channel" .

schema:hasCategoryCode a rdf:Property ;
    schema:description "A Category code contained in this code set." ;
    schema:name "has category code" .

schema:hasCourse a rdf:Property ;
    schema:description "A course or class that is one of the learning opportunities that constitute an educational / occupational program. No information is implied about whether the course is mandatory or optional; no guarantee is implied about whether the course will be available to everyone on the program." ;
    schema:name "has course" .

schema:hasCourseInstance a rdf:Property ;
    schema:description "An offering of the course at a specific time and place or through specific media or mode of study or to a specific section of students." ;
    schema:name "has course instance" .

schema:hasCredential a rdf:Property ;
    schema:description "A credential awarded to the Person or Organization." ;
    schema:name "has credential" .

schema:hasDefinedTerm a rdf:Property ;
    schema:description "A Defined Term contained in this term set." ;
    schema:name "has defined term" .

schema:hasDeliveryMethod a rdf:Property ;
    schema:description "Method used for delivery or shipping." ;
    schema:name "has delivery method" .

schema:hasDigitalDocumentPermission a rdf:Property ;
    schema:description "A permission related to the access to this document (e.g. permission to read or write an electronic document). For a public document, specify a grantee with an Audience with audienceType equal to \"public\"." ;
    schema:name "has digital document permission" .

schema:hasDriveThroughService a rdf:Property ;
    schema:description "Indicates whether some facility (e.g. [[FoodEstablishment]], [[CovidTestingFacility]]) offers a service that can be used by driving through in a car. In the case of [[CovidTestingFacility]] such facilities could potentially help with social distancing from other potentially-infected users." ;
    schema:name "has drive through service" .

schema:hasEnergyConsumptionDetails a rdf:Property ;
    schema:description "Defines the energy efficiency Category (also known as \"class\" or \"rating\") for a product according to an international energy efficiency standard." ;
    schema:name "has energy consumption details" .

schema:hasEnergyEfficiencyCategory a rdf:Property ;
    schema:description "Defines the energy efficiency Category (which could be either a rating out of range of values or a yes/no certification) for a product according to an international energy efficiency standard." ;
    schema:name "has energy efficiency category" .

schema:hasHealthAspect a rdf:Property ;
    schema:description "Indicates the aspect or aspects specifically addressed in some [[HealthTopicContent]]. For example, that the content is an overview, or that it talks about treatment, self-care, treatments or their side-effects." ;
    schema:name "has health aspect" .

schema:hasMap a rdf:Property ;
    schema:description "A URL to a map of the place." ;
    schema:name "has map" .

schema:hasMeasurement a rdf:Property ;
    schema:description "A product measurement, for example the inseam of pants, the wheel size of a bicycle, or the gauge of a screw. Usually an exact measurement, but can also be a range of measurements for adjustable products, for example belts and ski bindings." ;
    schema:name "has measurement" .

schema:hasMenu a rdf:Property ;
    schema:description "Either the actual menu as a structured representation, as text, or a URL of the menu." ;
    schema:name "has menu" .

schema:hasMenuItem a rdf:Property ;
    schema:description "A food or drink item contained in a menu or menu section." ;
    schema:name "has menu item" .

schema:hasMenuSection a rdf:Property ;
    schema:description "A subgrouping of the menu (by dishes, course, serving time period, etc.)." ;
    schema:name "has menu section" .

schema:hasMerchantReturnPolicy a rdf:Property ;
    schema:description "Specifies a MerchantReturnPolicy that may be applicable." ;
    schema:name "has merchant return policy" .

schema:hasMolecularFunction a rdf:Property ;
    schema:description "Molecular function performed by this BioChemEntity; please use PropertyValue if you want to include any evidence." ;
    schema:name "has molecular function" .

schema:hasOccupation a rdf:Property ;
    schema:description "The Person's occupation. For past professions, use Role for expressing dates." ;
    schema:name "has occupation" .

schema:hasOfferCatalog a rdf:Property ;
    schema:description "Indicates an OfferCatalog listing for this Organization, Person, or Service." ;
    schema:name "has offer catalog" .

schema:hasPOS a rdf:Property ;
    schema:description "Points-of-Sales operated by the organization or person." ;
    schema:name "has pos" .

schema:hasPart a rdf:Property ;
    schema:description "Indicates an item or CreativeWork that is part of this item, or CreativeWork (in some sense)." ;
    schema:name "has part" .

schema:hasRepresentation a rdf:Property ;
    schema:description "A common representation such as a protein sequence or chemical structure for this entity. For images use schema.org/image." ;
    schema:name "has representation" .

schema:hasVariant a rdf:Property ;
    schema:description "Indicates a [[Product]] that is a member of this [[ProductGroup]] (or [[ProductModel]])." ;
    schema:name "has variant" .

schema:headline a rdf:Property ;
    schema:description "Headline of the article." ;
    schema:name "headline" .

schema:healthCondition a rdf:Property ;
    schema:description "Specifying the health condition(s) of a patient, medical study, or other target audience." ;
    schema:name "health condition" .

schema:healthPlanCoinsuranceOption a rdf:Property ;
    schema:description "Whether the coinsurance applies before or after deductible, etc. TODO: Is this a closed set?" ;
    schema:name "health plan coinsurance option" .

schema:healthPlanCoinsuranceRate a rdf:Property ;
    schema:description "Whether The rate of coinsurance expressed as a number between 0.0 and 1.0." ;
    schema:name "health plan coinsurance rate" .

schema:healthPlanCopay a rdf:Property ;
    schema:description "Whether The copay amount." ;
    schema:name "health plan copay" .

schema:healthPlanCopayOption a rdf:Property ;
    schema:description "Whether the copay is before or after deductible, etc. TODO: Is this a closed set?" ;
    schema:name "health plan copay option" .

schema:healthPlanCostSharing a rdf:Property ;
    schema:description "Whether The costs to the patient for services under this network or formulary." ;
    schema:name "health plan cost sharing" .

schema:healthPlanDrugOption a rdf:Property ;
    schema:description "TODO." ;
    schema:name "health plan drug option" .

schema:healthPlanDrugTier a rdf:Property ;
    schema:description "The tier(s) of drugs offered by this formulary or insurance plan." ;
    schema:name "health plan drug tier" .

schema:healthPlanId a rdf:Property ;
    schema:description "The 14-character, HIOS-generated Plan ID number. (Plan IDs must be unique, even across different markets.)" ;
    schema:name "health plan id" .

schema:healthPlanMarketingUrl a rdf:Property ;
    schema:description "The URL that goes directly to the plan brochure for the specific standard plan or plan variation." ;
    schema:name "health plan marketing url" .

schema:healthPlanNetworkId a rdf:Property ;
    schema:description "Name or unique ID of network. (Networks are often reused across different insurance plans)." ;
    schema:name "health plan network id" .

schema:healthPlanNetworkTier a rdf:Property ;
    schema:description "The tier(s) for this network." ;
    schema:name "health plan network tier" .

schema:healthPlanPharmacyCategory a rdf:Property ;
    schema:description "The category or type of pharmacy associated with this cost sharing." ;
    schema:name "health plan pharmacy category" .

schema:healthcareReportingData a rdf:Property ;
    schema:description "Indicates data describing a hospital, e.g. a CDC [[CDCPMDRecord]] or as some kind of [[Dataset]]." ;
    schema:name "healthcare reporting data" .

schema:height a rdf:Property ;
    schema:description "The height of the item." ;
    schema:name "height" .

schema:highPrice a rdf:Property ;
    schema:description "The highest price of all offers available.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    schema:name "high price" .

schema:hiringOrganization a rdf:Property ;
    schema:description "Organization offering the job position." ;
    schema:name "hiring organization" .

schema:holdingArchive a rdf:Property ;
    schema:description "[[ArchiveOrganization]] that holds, keeps or maintains the [[ArchiveComponent]]."@en ;
    schema:name "holding archive"@en .

schema:homeLocation a rdf:Property ;
    schema:description "A contact location for a person's residence." ;
    schema:name "home location" .

schema:homeTeam a rdf:Property ;
    schema:description "The home team in a sports event." ;
    schema:name "home team" .

schema:honorificPrefix a rdf:Property ;
    schema:description "An honorific prefix preceding a Person's name such as Dr/Mrs/Mr." ;
    schema:name "honorific prefix" .

schema:honorificSuffix a rdf:Property ;
    schema:description "An honorific suffix following a Person's name such as M.D. /PhD/MSCSW." ;
    schema:name "honorific suffix" .

schema:hospitalAffiliation a rdf:Property ;
    schema:description "A hospital with which the physician or office is affiliated." ;
    schema:name "hospital affiliation" .

schema:hostingOrganization a rdf:Property ;
    schema:description "The organization (airline, travelers' club, etc.) the membership is made with." ;
    schema:name "hosting organization" .

schema:hoursAvailable a rdf:Property ;
    schema:description "The hours during which this service or contact is available." ;
    schema:name "hours available" .

schema:howPerformed a rdf:Property ;
    schema:description "How the procedure is performed." ;
    schema:name "how performed" .

schema:httpMethod a rdf:Property ;
    schema:description "An HTTP method that specifies the appropriate HTTP method for a request to an HTTP EntryPoint. Values are capitalized strings as used in HTTP." ;
    schema:name "http method" .

schema:iataCode a rdf:Property ;
    schema:description "IATA identifier for an airline or airport." ;
    schema:name "iata code" .

schema:icaoCode a rdf:Property ;
    schema:description "ICAO identifier for an airport." ;
    schema:name "icao code" .

schema:identifier a rdf:Property ;
    schema:description """The identifier property represents any kind of identifier for any kind of [[Thing]], such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See [background notes](/docs/datamodel.html#identifierBg) for more details.
        """ ;
    schema:name "identifier" .

schema:identifyingExam a rdf:Property ;
    schema:description "A physical examination that can identify this sign." ;
    schema:name "identifying exam" .

schema:identifyingTest a rdf:Property ;
    schema:description "A diagnostic test that can identify this sign." ;
    schema:name "identifying test" .

schema:illustrator a rdf:Property ;
    schema:description "The illustrator of the book." ;
    schema:name "illustrator" .

schema:image a rdf:Property ;
    schema:description "An image of the item. This can be a [[URL]] or a fully described [[ImageObject]]." ;
    schema:name "image" .

schema:imagingTechnique a rdf:Property ;
    schema:description "Imaging technique used." ;
    schema:name "imaging technique" .

schema:inAlbum a rdf:Property ;
    schema:description "The album to which this recording belongs." ;
    schema:name "in album" .

schema:inBroadcastLineup a rdf:Property ;
    schema:description "The CableOrSatelliteService offering the channel." ;
    schema:name "in broadcast lineup" .

schema:inChI a rdf:Property ;
    schema:description "Non-proprietary identifier for molecular entity that can be used in printed and electronic data sources thus enabling easier linking of diverse data compilations." ;
    schema:name "in ch i" .

schema:inChIKey a rdf:Property ;
    schema:description "InChIKey is a hashed version of the full InChI (using the SHA-256 algorithm)." ;
    schema:name "in ch i key" .

schema:inCodeSet a rdf:Property ;
    schema:description "A [[CategoryCodeSet]] that contains this category code." ;
    schema:name "in code set" .

schema:inDefinedTermSet a rdf:Property ;
    schema:description "A [[DefinedTermSet]] that contains this term." ;
    schema:name "in defined term set" .

schema:inLanguage a rdf:Property ;
    schema:description "The language of the content or performance or used in an action. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[availableLanguage]]." ;
    schema:name "in language" .

schema:inPlaylist a rdf:Property ;
    schema:description "The playlist to which this recording belongs." ;
    schema:name "in playlist" .

schema:inProductGroupWithID a rdf:Property ;
    schema:description "Indicates the [[productGroupID]] for a [[ProductGroup]] that this product [[isVariantOf]]. " ;
    schema:name "in product group with id" .

schema:inStoreReturnsOffered a rdf:Property ;
    schema:description "Are in-store returns offered? (for more advanced return methods use the [[returnMethod]] property)" ;
    schema:name "in store returns offered" .

schema:inSupportOf a rdf:Property ;
    schema:description "Qualification, candidature, degree, application that Thesis supports." ;
    schema:name "in support of" .

schema:incentiveCompensation a rdf:Property ;
    schema:description "Description of bonus and commission compensation aspects of the job." ;
    schema:name "incentive compensation" .

schema:incentives a rdf:Property ;
    schema:description "Description of bonus and commission compensation aspects of the job." ;
    schema:name "incentives" .

schema:includedComposition a rdf:Property ;
    schema:description "Smaller compositions included in this work (e.g. a movement in a symphony)." ;
    schema:name "included composition" .

schema:includedDataCatalog a rdf:Property ;
    schema:description "A data catalog which contains this dataset (this property was previously 'catalog', preferred name is now 'includedInDataCatalog')." ;
    schema:name "included data catalog" .

schema:includedInDataCatalog a rdf:Property ;
    schema:description "A data catalog which contains this dataset." ;
    schema:name "included in data catalog" .

schema:includedInHealthInsurancePlan a rdf:Property ;
    schema:description "The insurance plans that cover this drug." ;
    schema:name "included in health insurance plan" .

schema:includedRiskFactor a rdf:Property ;
    schema:description "A modifiable or non-modifiable risk factor included in the calculation, e.g. age, coexisting condition." ;
    schema:name "included risk factor" .

schema:includesAttraction a rdf:Property ;
    schema:description "Attraction located at destination." ;
    schema:name "includes attraction" .

schema:includesHealthPlanFormulary a rdf:Property ;
    schema:description "Formularies covered by this plan." ;
    schema:name "includes health plan formulary" .

schema:includesHealthPlanNetwork a rdf:Property ;
    schema:description "Networks covered by this plan." ;
    schema:name "includes health plan network" .

schema:includesObject a rdf:Property ;
    schema:description "This links to a node or nodes indicating the exact quantity of the products included in  an [[Offer]] or [[ProductCollection]]." ;
    schema:name "includes object" .

schema:increasesRiskOf a rdf:Property ;
    schema:description "The condition, complication, etc. influenced by this factor." ;
    schema:name "increases risk of" .

schema:industry a rdf:Property ;
    schema:description "The industry associated with the job position." ;
    schema:name "industry" .

schema:ineligibleRegion a rdf:Property ;
    schema:description """The ISO 3166-1 (ISO 3166-1 alpha-2) or ISO 3166-2 code, the place, or the GeoShape for the geo-political region(s) for which the offer or delivery charge specification is not valid, e.g. a region where the transaction is not allowed.\\n\\nSee also [[eligibleRegion]].
      """ ;
    schema:name "ineligible region" .

schema:infectiousAgent a rdf:Property ;
    schema:description "The actual infectious agent, such as a specific bacterium." ;
    schema:name "infectious agent" .

schema:infectiousAgentClass a rdf:Property ;
    schema:description "The class of infectious agent (bacteria, prion, etc.) that causes the disease." ;
    schema:name "infectious agent class" .

schema:ingredients a rdf:Property ;
    schema:description "A single ingredient used in the recipe, e.g. sugar, flour or garlic." ;
    schema:name "ingredients" .

schema:inker a rdf:Property ;
    schema:description "The individual who traces over the pencil drawings in ink after pencils are complete." ;
    schema:name "inker" .

schema:insertion a rdf:Property ;
    schema:description "The place of attachment of a muscle, or what the muscle moves." ;
    schema:name "insertion" .

schema:installUrl a rdf:Property ;
    schema:description "URL at which the app may be installed, if different from the URL of the item." ;
    schema:name "install url" .

schema:instructor a rdf:Property ;
    schema:description "A person assigned to instruct or provide instructional assistance for the [[CourseInstance]]." ;
    schema:name "instructor" .

schema:instrument a rdf:Property ;
    schema:description "The object that helped the agent perform the action. e.g. John wrote a book with *a pen*." ;
    schema:name "instrument" .

schema:intensity a rdf:Property ;
    schema:description "Quantitative measure gauging the degree of force involved in the exercise, for example, heartbeats per minute. May include the velocity of the movement." ;
    schema:name "intensity" .

schema:interactingDrug a rdf:Property ;
    schema:description "Another drug that is known to interact with this drug in a way that impacts the effect of this drug or causes a risk to the patient. Note: disease interactions are typically captured as contraindications." ;
    schema:name "interacting drug" .

schema:interactionCount a rdf:Property ;
    schema:description "This property is deprecated, alongside the UserInteraction types on which it depended." ;
    schema:name "interaction count" .

schema:interactionService a rdf:Property ;
    schema:description "The WebSite or SoftwareApplication where the interactions took place." ;
    schema:name "interaction service" .

schema:interactionStatistic a rdf:Property ;
    schema:description "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication. The most specific child type of InteractionCounter should be used." ;
    schema:name "interaction statistic" .

schema:interactionType a rdf:Property ;
    schema:description "The Action representing the type of interaction. For up votes, +1s, etc. use [[LikeAction]]. For down votes use [[DislikeAction]]. Otherwise, use the most specific Action." ;
    schema:name "interaction type" .

schema:interactivityType a rdf:Property ;
    schema:description "The predominant mode of learning supported by the learning resource. Acceptable values are 'active', 'expositive', or 'mixed'." ;
    schema:name "interactivity type" .

schema:interestRate a rdf:Property ;
    schema:description "The interest rate, charged or paid, applicable to the financial product. Note: This is different from the calculated annualPercentageRate." ;
    schema:name "interest rate" .

schema:interpretedAsClaim a rdf:Property ;
    schema:description "Used to indicate a specific claim contained, implied, translated or refined from the content of a [[MediaObject]] or other [[CreativeWork]]. The interpreting party can be indicated using [[claimInterpreter]]." ;
    schema:name "interpreted as claim" .

schema:inventoryLevel a rdf:Property ;
    schema:description "The current approximate inventory level for the item or items." ;
    schema:name "inventory level" .

schema:inverseOf a rdf:Property ;
    schema:description "Relates a property to a property that is its inverse. Inverse properties relate the same pairs of items to each other, but in reversed direction. For example, the 'alumni' and 'alumniOf' properties are inverseOf each other. Some properties don't have explicit inverses; in these situations RDFa and JSON-LD syntax for reverse properties can be used." ;
    schema:name "inverse of" .

schema:isAcceptingNewPatients a rdf:Property ;
    schema:description "Whether the provider is accepting new patients." ;
    schema:name "is accepting new patients" .

schema:isAccessibleForFree a rdf:Property ;
    schema:description "A flag to signal that the item, event, or place is accessible for free." ;
    schema:name "is accessible for free" .

schema:isAccessoryOrSparePartFor a rdf:Property ;
    schema:description "A pointer to another product (or multiple products) for which this product is an accessory or spare part." ;
    schema:name "is accessory or spare part for" .

schema:isAvailableGenerically a rdf:Property ;
    schema:description "True if the drug is available in a generic form (regardless of name)." ;
    schema:name "is available generically" .

schema:isBasedOn a rdf:Property ;
    schema:description "A resource from which this work is derived or from which it is a modification or adaption." ;
    schema:name "is based on" .

schema:isBasedOnUrl a rdf:Property ;
    schema:description "A resource that was used in the creation of this resource. This term can be repeated for multiple sources. For example, http://example.com/great-multiplication-intro.html." ;
    schema:name "is based on url" .

schema:isConsumableFor a rdf:Property ;
    schema:description "A pointer to another product (or multiple products) for which this product is a consumable." ;
    schema:name "is consumable for" .

schema:isEncodedByBioChemEntity a rdf:Property ;
    schema:description "Another BioChemEntity encoding by this one." ;
    schema:name "is encoded by bio chem entity" .

schema:isFamilyFriendly a rdf:Property ;
    schema:description "Indicates whether this content is family friendly." ;
    schema:name "is family friendly" .

schema:isGift a rdf:Property ;
    schema:description "Was the offer accepted as a gift for someone other than the buyer." ;
    schema:name "is gift" .

schema:isInvolvedInBiologicalProcess a rdf:Property ;
    schema:description "Biological process this BioChemEntity is involved in; please use PropertyValue if you want to include any evidence." ;
    schema:name "is involved in biological process" .

schema:isLiveBroadcast a rdf:Property ;
    schema:description "True if the broadcast is of a live event." ;
    schema:name "is live broadcast" .

schema:isLocatedInSubcellularLocation a rdf:Property ;
    schema:description "Subcellular location where this BioChemEntity is located; please use PropertyValue if you want to include any evidence." ;
    schema:name "is located in subcellular location" .

schema:isPartOf a rdf:Property ;
    schema:description "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of." ;
    schema:name "is part of" .

schema:isPartOfBioChemEntity a rdf:Property ;
    schema:description "Indicates a BioChemEntity that is (in some sense) a part of this BioChemEntity. " ;
    schema:name "is part of bio chem entity" .

schema:isPlanForApartment a rdf:Property ;
    schema:description "Indicates some accommodation that this floor plan describes." ;
    schema:name "is plan for apartment" .

schema:isProprietary a rdf:Property ;
    schema:description "True if this item's name is a proprietary/brand name (vs. generic name)." ;
    schema:name "is proprietary" .

schema:isRelatedTo a rdf:Property ;
    schema:description "A pointer to another, somehow related product (or multiple products)." ;
    schema:name "is related to" .

schema:isResizable a rdf:Property ;
    schema:description "Whether the 3DModel allows resizing. For example, room layout applications often do not allow 3DModel elements to be resized to reflect reality." ;
    schema:name "is resizable" .

schema:isSimilarTo a rdf:Property ;
    schema:description "A pointer to another, functionally similar product (or multiple products)." ;
    schema:name "is similar to" .

schema:isUnlabelledFallback a rdf:Property ;
    schema:description "This can be marked 'true' to indicate that some published [[DeliveryTimeSettings]] or [[ShippingRateSettings]] are intended to apply to all [[OfferShippingDetails]] published by the same merchant, when referenced by a [[shippingSettingsLink]] in those settings. It is not meaningful to use a 'true' value for this property alongside a transitTimeLabel (for [[DeliveryTimeSettings]]) or shippingLabel (for [[ShippingRateSettings]]), since this property is for use with unlabelled settings." ;
    schema:name "is unlabelled fallback" .

schema:isVariantOf a rdf:Property ;
    schema:description "Indicates the kind of product that this is a variant of. In the case of [[ProductModel]], this is a pointer (from a ProductModel) to a base product from which this product is a variant. It is safe to infer that the variant inherits all product features from the base model, unless defined locally. This is not transitive. In the case of a [[ProductGroup]], the group description also serves as a template, representing a set of Products that vary on explicitly defined, specific dimensions only (so it defines both a set of variants, as well as which values distinguish amongst those variants). When used with [[ProductGroup]], this property can apply to any [[Product]] included in the group." ;
    schema:name "is variant of" .

schema:isbn a rdf:Property ;
    schema:description "The ISBN of the book." ;
    schema:name "isbn" .

schema:isicV4 a rdf:Property ;
    schema:description "The International Standard of Industrial Classification of All Economic Activities (ISIC), Revision 4 code for a particular organization, business person, or place." ;
    schema:name "isic v4" .

schema:isrcCode a rdf:Property ;
    schema:description "The International Standard Recording Code for the recording." ;
    schema:name "isrc code" .

schema:issn a rdf:Property ;
    schema:description "The International Standard Serial Number (ISSN) that identifies this serial publication. You can repeat this property to identify different formats of, or the linking ISSN (ISSN-L) for, this serial publication." ;
    schema:name "issn" .

schema:issueNumber a rdf:Property ;
    schema:description "Identifies the issue of publication; for example, \"iii\" or \"2\"." ;
    schema:name "issue number" .

schema:issuedBy a rdf:Property ;
    schema:description "The organization issuing the ticket or permit." ;
    schema:name "issued by" .

schema:issuedThrough a rdf:Property ;
    schema:description "The service through with the permit was granted." ;
    schema:name "issued through" .

schema:iswcCode a rdf:Property ;
    schema:description "The International Standard Musical Work Code for the composition." ;
    schema:name "iswc code" .

schema:item a rdf:Property ;
    schema:description "An entity represented by an entry in a list or data feed (e.g. an 'artist' in a list of 'artists')’." ;
    schema:name "item" .

schema:itemCondition a rdf:Property ;
    schema:description "A predefined value from OfferItemCondition specifying the condition of the product or service, or the products or services included in the offer. Also used for product return policies to specify the condition of products accepted for returns." ;
    schema:name "item condition" .

schema:itemDefectReturnFees a rdf:Property ;
    schema:description "The type of return fees for returns of defect products." ;
    schema:name "item defect return fees" .

schema:itemDefectReturnLabelSource a rdf:Property ;
    schema:description "The method (from an enumeration) by which the customer obtains a return shipping label for a defect product." ;
    schema:name "item defect return label source" .

schema:itemDefectReturnShippingFeesAmount a rdf:Property ;
    schema:description "Amount of shipping costs for defect product returns. Applicable when property [[itemDefectReturnFees]] equals [[ReturnShippingFees]]." ;
    schema:name "item defect return shipping fees amount" .

schema:itemListElement a rdf:Property ;
    schema:description "For itemListElement values, you can use simple strings (e.g. \"Peter\", \"Paul\", \"Mary\"), existing entities, or use ListItem.\\n\\nText values are best if the elements in the list are plain strings. Existing entities are best for a simple, unordered list of existing things in your data. ListItem is used with ordered lists when you want to provide additional context about the element in that list or when the same item might be in different places in different lists.\\n\\nNote: The order of elements in your mark-up is not sufficient for indicating the order or elements.  Use ListItem with a 'position' property in such cases." ;
    schema:name "item list element" .

schema:itemListOrder a rdf:Property ;
    schema:description "Type of ordering (e.g. Ascending, Descending, Unordered)." ;
    schema:name "item list order" .

schema:itemLocation a rdf:Property ;
    schema:description "Current location of the item."@en ;
    schema:name "item location"@en .

schema:itemOffered a rdf:Property ;
    schema:description "An item being offered (or demanded). The transactional nature of the offer or demand is documented using [[businessFunction]], e.g. sell, lease etc. While several common expected types are listed explicitly in this definition, others can be used. Using a second type, such as Product or a subtype of Product, can clarify the nature of the offer." ;
    schema:name "item offered" .

schema:itemReviewed a rdf:Property ;
    schema:description "The item that is being reviewed/rated." ;
    schema:name "item reviewed" .

schema:itemShipped a rdf:Property ;
    schema:description "Item(s) being shipped." ;
    schema:name "item shipped" .

schema:itinerary a rdf:Property ;
    schema:description "Destination(s) ( [[Place]] ) that make up a trip. For a trip where destination order is important use [[ItemList]] to specify that order (see examples)." ;
    schema:name "itinerary" .

schema:iupacName a rdf:Property ;
    schema:description "Systematic method of naming chemical compounds as recommended by the International Union of Pure and Applied Chemistry (IUPAC)." ;
    schema:name "iupac name" .

schema:jobBenefits a rdf:Property ;
    schema:description "Description of benefits associated with the job." ;
    schema:name "job benefits" .

schema:jobImmediateStart a rdf:Property ;
    schema:description "An indicator as to whether a position is available for an immediate start." ;
    schema:name "job immediate start" .

schema:jobLocation a rdf:Property ;
    schema:description "A (typically single) geographic location associated with the job position." ;
    schema:name "job location" .

schema:jobLocationType a rdf:Property ;
    schema:description "A description of the job location (e.g TELECOMMUTE for telecommute jobs)." ;
    schema:name "job location type" .

schema:jobStartDate a rdf:Property ;
    schema:description "The date on which a successful applicant for this job would be expected to start work. Choose a specific date in the future or use the jobImmediateStart property to indicate the position is to be filled as soon as possible." ;
    schema:name "job start date" .

schema:jobTitle a rdf:Property ;
    schema:description "The job title of the person (for example, Financial Manager)." ;
    schema:name "job title" .

schema:jurisdiction a rdf:Property ;
    schema:description "Indicates a legal jurisdiction, e.g. of some legislation, or where some government service is based." ;
    schema:name "jurisdiction" .

schema:keywords a rdf:Property ;
    schema:description "Keywords or tags used to describe this content. Multiple entries in a keywords list are typically delimited by commas." ;
    schema:name "keywords" .

schema:knownVehicleDamages a rdf:Property ;
    schema:description "A textual description of known damages, both repaired and unrepaired." ;
    schema:name "known vehicle damages" .

schema:knows a rdf:Property ;
    schema:description "The most generic bi-directional social/work relation." ;
    schema:name "knows" .

schema:knowsAbout a rdf:Property ;
    schema:description "Of a [[Person]], and less typically of an [[Organization]], to indicate a topic that is known about - suggesting possible expertise but not implying it. We do not distinguish skill levels here, or relate this to educational content, events, objectives or [[JobPosting]] descriptions." ;
    schema:name "knows about" .

schema:knowsLanguage a rdf:Property ;
    schema:description "Of a [[Person]], and less typically of an [[Organization]], to indicate a known language. We do not distinguish skill levels or reading/writing/speaking/signing here. Use language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47)." ;
    schema:name "knows language" .

schema:labelDetails a rdf:Property ;
    schema:description "Link to the drug's label details." ;
    schema:name "label details" .

schema:landlord a rdf:Property ;
    schema:description "A sub property of participant. The owner of the real estate property." ;
    schema:name "landlord" .

schema:language a rdf:Property ;
    schema:description "A sub property of instrument. The language used on this action." ;
    schema:name "language" .

schema:lastReviewed a rdf:Property ;
    schema:description "Date on which the content on this web page was last reviewed for accuracy and/or completeness." ;
    schema:name "last reviewed" .

schema:latitude a rdf:Property ;
    schema:description "The latitude of a location. For example ```37.42242``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." ;
    schema:name "latitude" .

schema:layoutImage a rdf:Property ;
    schema:description "A schematic image showing the floorplan layout." ;
    schema:name "layout image" .

schema:learningResourceType a rdf:Property ;
    schema:description "The predominant type or kind characterizing the learning resource. For example, 'presentation', 'handout'." ;
    schema:name "learning resource type" .

schema:leaseLength a rdf:Property ;
    schema:description "Length of the lease for some [[Accommodation]], either particular to some [[Offer]] or in some cases intrinsic to the property." ;
    schema:name "lease length" .

schema:legalName a rdf:Property ;
    schema:description "The official name of the organization, e.g. the registered company name." ;
    schema:name "legal name" .

schema:legalStatus a rdf:Property ;
    schema:description "The drug or supplement's legal status, including any controlled substance schedules that apply." ;
    schema:name "legal status" .

schema:legislationApplies a rdf:Property ;
    schema:description "Indicates that this legislation (or part of a legislation) somehow transfers another legislation in a different legislative context. This is an informative link, and it has no legal value. For legally-binding links of transposition, use the <a href=\"/legislationTransposes\">legislationTransposes</a> property. For example an informative consolidated law of a European Union's member state \"applies\" the consolidated version of the European Directive implemented in it." ;
    schema:name "legislation applies" .

schema:legislationChanges a rdf:Property ;
    schema:description "Another legislation that this legislation changes. This encompasses the notions of amendment, replacement, correction, repeal, or other types of change. This may be a direct change (textual or non-textual amendment) or a consequential or indirect change. The property is to be used to express the existence of a change relationship between two acts rather than the existence of a consolidated version of the text that shows the result of the change. For consolidation relationships, use the <a href=\"/legislationConsolidates\">legislationConsolidates</a> property." ;
    schema:name "legislation changes" .

schema:legislationConsolidates a rdf:Property ;
    schema:description "Indicates another legislation taken into account in this consolidated legislation (which is usually the product of an editorial process that revises the legislation). This property should be used multiple times to refer to both the original version or the previous consolidated version, and to the legislations making the change." ;
    schema:name "legislation consolidates" .

schema:legislationDate a rdf:Property ;
    schema:description "The date of adoption or signature of the legislation. This is the date at which the text is officially aknowledged to be a legislation, even though it might not even be published or in force." ;
    schema:name "legislation date" .

schema:legislationDateVersion a rdf:Property ;
    schema:description "The point-in-time at which the provided description of the legislation is valid (e.g. : when looking at the law on the 2016-04-07 (= dateVersion), I get the consolidation of 2015-04-12 of the \"National Insurance Contributions Act 2015\")" ;
    schema:name "legislation date version" .

schema:legislationIdentifier a rdf:Property ;
    schema:description "An identifier for the legislation. This can be either a string-based identifier, like the CELEX at EU level or the NOR in France, or a web-based, URL/URI identifier, like an ELI (European Legislation Identifier) or an URN-Lex." ;
    schema:name "legislation identifier" .

schema:legislationJurisdiction a rdf:Property ;
    schema:description "The jurisdiction from which the legislation originates." ;
    schema:name "legislation jurisdiction" .

schema:legislationLegalForce a rdf:Property ;
    schema:description "Whether the legislation is currently in force, not in force, or partially in force." ;
    schema:name "legislation legal force" .

schema:legislationLegalValue a rdf:Property ;
    schema:description "The legal value of this legislation file. The same legislation can be written in multiple files with different legal values. Typically a digitally signed PDF have a \"stronger\" legal value than the HTML file of the same act." ;
    schema:name "legislation legal value" .

schema:legislationPassedBy a rdf:Property ;
    schema:description "The person or organization that originally passed or made the law : typically parliament (for primary legislation) or government (for secondary legislation). This indicates the \"legal author\" of the law, as opposed to its physical author." ;
    schema:name "legislation passed by" .

schema:legislationResponsible a rdf:Property ;
    schema:description "An individual or organization that has some kind of responsibility for the legislation. Typically the ministry who is/was in charge of elaborating the legislation, or the adressee for potential questions about the legislation once it is published." ;
    schema:name "legislation responsible" .

schema:legislationTransposes a rdf:Property ;
    schema:description "Indicates that this legislation (or part of legislation) fulfills the objectives set by another legislation, by passing appropriate implementation measures. Typically, some legislations of European Union's member states or regions transpose European Directives. This indicates a legally binding link between the 2 legislations." ;
    schema:name "legislation transposes" .

schema:legislationType a rdf:Property ;
    schema:description "The type of the legislation. Examples of values are \"law\", \"act\", \"directive\", \"decree\", \"regulation\", \"statutory instrument\", \"loi organique\", \"règlement grand-ducal\", etc., depending on the country." ;
    schema:name "legislation type" .

schema:leiCode a rdf:Property ;
    schema:description "An organization identifier that uniquely identifies a legal entity as defined in ISO 17442." ;
    schema:name "lei code" .

schema:lender a rdf:Property ;
    schema:description "A sub property of participant. The person that lends the object being borrowed." ;
    schema:name "lender" .

schema:lesser a rdf:Property ;
    schema:description "This ordering relation for qualitative values indicates that the subject is lesser than the object." ;
    schema:name "lesser" .

schema:lesserOrEqual a rdf:Property ;
    schema:description "This ordering relation for qualitative values indicates that the subject is lesser than or equal to the object." ;
    schema:name "lesser or equal" .

schema:letterer a rdf:Property ;
    schema:description "The individual who adds lettering, including speech balloons and sound effects, to artwork." ;
    schema:name "letterer" .

schema:license a rdf:Property ;
    schema:description "A license document that applies to this content, typically indicated by URL." ;
    schema:name "license" .

schema:line a rdf:Property ;
    schema:description "A line is a point-to-point path consisting of two or more points. A line is expressed as a series of two or more point objects separated by space." ;
    schema:name "line" .

schema:linkRelationship a rdf:Property ;
    schema:description "Indicates the relationship type of a Web link. " ;
    schema:name "link relationship" .

schema:liveBlogUpdate a rdf:Property ;
    schema:description "An update to the LiveBlog." ;
    schema:name "live blog update" .

schema:loanMortgageMandateAmount a rdf:Property ;
    schema:description "Amount of mortgage mandate that can be converted into a proper mortgage at a later stage." ;
    schema:name "loan mortgage mandate amount" .

schema:loanPaymentAmount a rdf:Property ;
    schema:description "The amount of money to pay in a single payment." ;
    schema:name "loan payment amount" .

schema:loanPaymentFrequency a rdf:Property ;
    schema:description "Frequency of payments due, i.e. number of months between payments. This is defined as a frequency, i.e. the reciprocal of a period of time." ;
    schema:name "loan payment frequency" .

schema:loanRepaymentForm a rdf:Property ;
    schema:description "A form of paying back money previously borrowed from a lender. Repayment usually takes the form of periodic payments that normally include part principal plus interest in each payment." ;
    schema:name "loan repayment form" .

schema:loanTerm a rdf:Property ;
    schema:description "The duration of the loan or credit agreement." ;
    schema:name "loan term" .

schema:loanType a rdf:Property ;
    schema:description "The type of a loan or credit." ;
    schema:name "loan type" .

schema:location a rdf:Property ;
    schema:description "The location of, for example, where an event is happening, where an organization is located, or where an action takes place." ;
    schema:name "location" .

schema:locationCreated a rdf:Property ;
    schema:description "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork." ;
    schema:name "location created" .

schema:lodgingUnitDescription a rdf:Property ;
    schema:description "A full description of the lodging unit." ;
    schema:name "lodging unit description" .

schema:lodgingUnitType a rdf:Property ;
    schema:description "Textual description of the unit type (including suite vs. room, size of bed, etc.)." ;
    schema:name "lodging unit type" .

schema:logo a rdf:Property ;
    schema:description "An associated logo." ;
    schema:name "logo" .

schema:longitude a rdf:Property ;
    schema:description "The longitude of a location. For example ```-122.08585``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." ;
    schema:name "longitude" .

schema:loser a rdf:Property ;
    schema:description "A sub property of participant. The loser of the action." ;
    schema:name "loser" .

schema:lowPrice a rdf:Property ;
    schema:description "The lowest price of all offers available.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    schema:name "low price" .

schema:lyricist a rdf:Property ;
    schema:description "The person who wrote the words." ;
    schema:name "lyricist" .

schema:lyrics a rdf:Property ;
    schema:description "The words in the song." ;
    schema:name "lyrics" .

schema:mainContentOfPage a rdf:Property ;
    schema:description "Indicates if this web page element is the main subject of the page." ;
    schema:name "main content of page" .

schema:mainEntity a rdf:Property ;
    schema:description "Indicates the primary entity described in some page or other CreativeWork." ;
    schema:name "main entity" .

schema:mainEntityOfPage a rdf:Property ;
    schema:description "Indicates a page (or other CreativeWork) for which this thing is the main entity being described. See [background notes](/docs/datamodel.html#mainEntityBackground) for details." ;
    schema:name "main entity of page" .

schema:maintainer a rdf:Property ;
    schema:description """A maintainer of a [[Dataset]], software package ([[SoftwareApplication]]), or other [[Project]]. A maintainer is a [[Person]] or [[Organization]] that manages contributions to, and/or publication of, some (typically complex) artifact. It is common for distributions of software and data to be based on "upstream" sources. When [[maintainer]] is applied to a specific version of something e.g. a particular version or packaging of a [[Dataset]], it is always  possible that the upstream source has a different maintainer. The [[isBasedOn]] property can be used to indicate such relationships between datasets to make the different maintenance roles clear. Similarly in the case of software, a package may have dedicated maintainers working on integration into software distributions such as Ubuntu, as well as upstream maintainers of the underlying work.
      """ ;
    schema:name "maintainer" .

schema:makesOffer a rdf:Property ;
    schema:description "A pointer to products or services offered by the organization or person." ;
    schema:name "makes offer" .

schema:manufacturer a rdf:Property ;
    schema:description "The manufacturer of the product." ;
    schema:name "manufacturer" .

schema:map a rdf:Property ;
    schema:description "A URL to a map of the place." ;
    schema:name "map" .

schema:mapType a rdf:Property ;
    schema:description "Indicates the kind of Map, from the MapCategoryType Enumeration." ;
    schema:name "map type" .

schema:maps a rdf:Property ;
    schema:description "A URL to a map of the place." ;
    schema:name "maps" .

schema:marginOfError a rdf:Property ;
    schema:description "A marginOfError for an [[Observation]]." ;
    schema:name "margin of error" .

schema:masthead a rdf:Property ;
    schema:description "For a [[NewsMediaOrganization]], a link to the masthead page or a page listing top editorial management." ;
    schema:name "masthead" .

schema:material a rdf:Property ;
    schema:description "A material that something is made from, e.g. leather, wool, cotton, paper." ;
    schema:name "material" .

schema:materialExtent a rdf:Property ;
    schema:description "The quantity of the materials being described or an expression of the physical space they occupy."@en ;
    schema:name "material extent"@en .

schema:mathExpression a rdf:Property ;
    schema:description "A mathematical expression (e.g. 'x^2-3x=0') that may be solved for a specific variable, simplified, or transformed. This can take many formats, e.g. LaTeX, Ascii-Math, or math as you would write with a keyboard." ;
    schema:name "math expression" .

schema:maxPrice a rdf:Property ;
    schema:description "The highest price if the price is a range." ;
    schema:name "max price" .

schema:maxValue a rdf:Property ;
    schema:description "The upper value of some characteristic or property." ;
    schema:name "max value" .

schema:maximumAttendeeCapacity a rdf:Property ;
    schema:description "The total number of individuals that may attend an event or venue." ;
    schema:name "maximum attendee capacity" .

schema:maximumEnrollment a rdf:Property ;
    schema:description "The maximum number of students who may be enrolled in the program." ;
    schema:name "maximum enrollment" .

schema:maximumIntake a rdf:Property ;
    schema:description "Recommended intake of this supplement for a given population as defined by a specific recommending authority." ;
    schema:name "maximum intake" .

schema:maximumPhysicalAttendeeCapacity a rdf:Property ;
    schema:description "The maximum physical attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OfflineEventAttendanceMode]] (or the offline aspects, in the case of a [[MixedEventAttendanceMode]]). " ;
    schema:name "maximum physical attendee capacity" .

schema:maximumVirtualAttendeeCapacity a rdf:Property ;
    schema:description "The maximum physical attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OnlineEventAttendanceMode]] (or the online aspects, in the case of a [[MixedEventAttendanceMode]]). " ;
    schema:name "maximum virtual attendee capacity" .

schema:mealService a rdf:Property ;
    schema:description "Description of the meals that will be provided or available for purchase." ;
    schema:name "meal service" .

schema:measuredProperty a rdf:Property ;
    schema:description "The measuredProperty of an [[Observation]], either a schema.org property, a property from other RDF-compatible systems e.g. W3C RDF Data Cube, or schema.org extensions such as [GS1's](https://www.gs1.org/voc/?show=properties)." ;
    schema:name "measured property" .

schema:measuredValue a rdf:Property ;
    schema:description "The measuredValue of an [[Observation]]." ;
    schema:name "measured value" .

schema:measurementTechnique a rdf:Property ;
    schema:description """A technique or technology used in a [[Dataset]] (or [[DataDownload]], [[DataCatalog]]),
corresponding to the method used for measuring the corresponding variable(s) (described using [[variableMeasured]]). This is oriented towards scientific and scholarly dataset publication but may have broader applicability; it is not intended as a full representation of measurement, but rather as a high level summary for dataset discovery.

For example, if [[variableMeasured]] is: molecule concentration, [[measurementTechnique]] could be: "mass spectrometry" or "nmr spectroscopy" or "colorimetry" or "immunofluorescence".

If the [[variableMeasured]] is "depression rating", the [[measurementTechnique]] could be "Zung Scale" or "HAM-D" or "Beck Depression Inventory".

If there are several [[variableMeasured]] properties recorded for some given data object, use a [[PropertyValue]] for each [[variableMeasured]] and attach the corresponding [[measurementTechnique]].
      """ ;
    schema:name "measurement technique" .

schema:mechanismOfAction a rdf:Property ;
    schema:description "The specific biochemical interaction through which this drug or supplement produces its pharmacological effect." ;
    schema:name "mechanism of action" .

schema:mediaAuthenticityCategory a rdf:Property ;
    schema:description "Indicates a MediaManipulationRatingEnumeration classification of a media object (in the context of how it was published or shared)." ;
    schema:name "media authenticity category" .

schema:mediaItemAppearance a rdf:Property ;
    schema:description "In the context of a [[MediaReview]], indicates specific media item(s) that are grouped using a [[MediaReviewItem]]." ;
    schema:name "media item appearance" .

schema:median a rdf:Property ;
    schema:description "The median value." ;
    schema:name "median" .

schema:medicalAudience a rdf:Property ;
    schema:description "Medical audience for page." ;
    schema:name "medical audience" .

schema:medicalSpecialty a rdf:Property ;
    schema:description "A medical specialty of the provider." ;
    schema:name "medical specialty" .

schema:medicineSystem a rdf:Property ;
    schema:description "The system of medicine that includes this MedicalEntity, for example 'evidence-based', 'homeopathic', 'chiropractic', etc." ;
    schema:name "medicine system" .

schema:meetsEmissionStandard a rdf:Property ;
    schema:description "Indicates that the vehicle meets the respective emission standard." ;
    schema:name "meets emission standard" .

schema:member a rdf:Property ;
    schema:description "A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals." ;
    schema:name "member" .

schema:memberOf a rdf:Property ;
    schema:description "An Organization (or ProgramMembership) to which this Person or Organization belongs." ;
    schema:name "member of" .

schema:members a rdf:Property ;
    schema:description "A member of this organization." ;
    schema:name "members" .

schema:membershipNumber a rdf:Property ;
    schema:description "A unique identifier for the membership." ;
    schema:name "membership number" .

schema:membershipPointsEarned a rdf:Property ;
    schema:description "The number of membership points earned by the member. If necessary, the unitText can be used to express the units the points are issued in. (e.g. stars, miles, etc.)" ;
    schema:name "membership points earned" .

schema:memoryRequirements a rdf:Property ;
    schema:description "Minimum memory requirements." ;
    schema:name "memory requirements" .

schema:mentions a rdf:Property ;
    schema:description "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept." ;
    schema:name "mentions" .

schema:menu a rdf:Property ;
    schema:description "Either the actual menu as a structured representation, as text, or a URL of the menu." ;
    schema:name "menu" .

schema:menuAddOn a rdf:Property ;
    schema:description "Additional menu item(s) such as a side dish of salad or side order of fries that can be added to this menu item. Additionally it can be a menu section containing allowed add-on menu items for this menu item." ;
    schema:name "menu add on" .

schema:merchant a rdf:Property ;
    schema:description "'merchant' is an out-dated term for 'seller'." ;
    schema:name "merchant" .

schema:merchantReturnDays a rdf:Property ;
    schema:description "Specifies either a fixed return date or the number of days (from the delivery date) that a product can be returned. Used when the [[returnPolicyCategory]] property is specified as [[MerchantReturnFiniteReturnWindow]]." ;
    schema:name "merchant return days" .

schema:merchantReturnLink a rdf:Property ;
    schema:description "Specifies a Web page or service by URL, for product returns." ;
    schema:name "merchant return link" .

schema:messageAttachment a rdf:Property ;
    schema:description "A CreativeWork attached to the message." ;
    schema:name "message attachment" .

schema:mileageFromOdometer a rdf:Property ;
    schema:description "The total distance travelled by the particular vehicle since its initial production, as read from its odometer.\\n\\nTypical unit code(s): KMT for kilometers, SMI for statute miles" ;
    schema:name "mileage from odometer" .

schema:minPrice a rdf:Property ;
    schema:description "The lowest price if the price is a range." ;
    schema:name "min price" .

schema:minValue a rdf:Property ;
    schema:description "The lower value of some characteristic or property." ;
    schema:name "min value" .

schema:minimumPaymentDue a rdf:Property ;
    schema:description "The minimum payment required at this time." ;
    schema:name "minimum payment due" .

schema:missionCoveragePrioritiesPolicy a rdf:Property ;
    schema:description "For a [[NewsMediaOrganization]], a statement on coverage priorities, including any public agenda or stance on issues." ;
    schema:name "mission coverage priorities policy" .

schema:model a rdf:Property ;
    schema:description "The model of the product. Use with the URL of a ProductModel or a textual representation of the model identifier. The URL of the ProductModel can be from an external source. It is recommended to additionally provide strong product identifiers via the gtin8/gtin13/gtin14 and mpn properties." ;
    schema:name "model" .

schema:modelDate a rdf:Property ;
    schema:description "The release date of a vehicle model (often used to differentiate versions of the same make and model)." ;
    schema:name "model date" .

schema:modifiedTime a rdf:Property ;
    schema:description "The date and time the reservation was modified." ;
    schema:name "modified time" .

schema:molecularFormula a rdf:Property ;
    schema:description "The empirical formula is the simplest whole number ratio of all the atoms in a molecule." ;
    schema:name "molecular formula" .

schema:molecularWeight a rdf:Property ;
    schema:description "This is the molecular weight of the entity being described, not of the parent. Units should be included in the form '&lt;Number&gt; &lt;unit&gt;', for example '12 amu' or as '&lt;QuantitativeValue&gt;." ;
    schema:name "molecular weight" .

schema:monoisotopicMolecularWeight a rdf:Property ;
    schema:description "The monoisotopic mass is the sum of the masses of the atoms in a molecule using the unbound, ground-state, rest mass of the principal (most abundant) isotope for each element instead of the isotopic average mass. Please include the units the form '&lt;Number&gt; &lt;unit&gt;', for example '770.230488 g/mol' or as '&lt;QuantitativeValue&gt;." ;
    schema:name "monoisotopic molecular weight" .

schema:monthlyMinimumRepaymentAmount a rdf:Property ;
    schema:description "The minimum payment is the lowest amount of money that one is required to pay on a credit card statement each month." ;
    schema:name "monthly minimum repayment amount" .

schema:monthsOfExperience a rdf:Property ;
    schema:description "Indicates the minimal number of months of experience required for a position." ;
    schema:name "months of experience" .

schema:mpn a rdf:Property ;
    schema:description "The Manufacturer Part Number (MPN) of the product, or the product to which the offer refers." ;
    schema:name "mpn" .

schema:multipleValues a rdf:Property ;
    schema:description "Whether multiple values are allowed for the property.  Default is false." ;
    schema:name "multiple values" .

schema:muscleAction a rdf:Property ;
    schema:description "The movement the muscle generates." ;
    schema:name "muscle action" .

schema:musicArrangement a rdf:Property ;
    schema:description "An arrangement derived from the composition." ;
    schema:name "music arrangement" .

schema:musicBy a rdf:Property ;
    schema:description "The composer of the soundtrack." ;
    schema:name "music by" .

schema:musicCompositionForm a rdf:Property ;
    schema:description "The type of composition (e.g. overture, sonata, symphony, etc.)." ;
    schema:name "music composition form" .

schema:musicGroupMember a rdf:Property ;
    schema:description "A member of a music group&#x2014;for example, John, Paul, George, or Ringo." ;
    schema:name "music group member" .

schema:musicReleaseFormat a rdf:Property ;
    schema:description "Format of this release (the type of recording media used, ie. compact disc, digital media, LP, etc.)." ;
    schema:name "music release format" .

schema:musicalKey a rdf:Property ;
    schema:description "The key, mode, or scale this composition uses." ;
    schema:name "musical key" .

schema:naics a rdf:Property ;
    schema:description "The North American Industry Classification System (NAICS) code for a particular organization or business person." ;
    schema:name "naics" .

schema:name a rdf:Property ;
    schema:description "The name of the item." ;
    schema:name "name" .

schema:namedPosition a rdf:Property ;
    schema:description "A position played, performed or filled by a person or organization, as part of an organization. For example, an athlete in a SportsTeam might play in the position named 'Quarterback'." ;
    schema:name "named position" .

schema:nationality a rdf:Property ;
    schema:description "Nationality of the person." ;
    schema:name "nationality" .

schema:naturalProgression a rdf:Property ;
    schema:description "The expected progression of the condition if it is not treated and allowed to progress naturally." ;
    schema:name "natural progression" .

schema:negativeNotes a rdf:Property ;
    schema:description "Indicates, in the context of a [[Review]] (e.g. framed as 'pro' vs 'con' considerations), negative considerations - either as unstructured text, or a list." ;
    schema:name "negative notes" .

schema:nerve a rdf:Property ;
    schema:description "The underlying innervation associated with the muscle." ;
    schema:name "nerve" .

schema:nerveMotor a rdf:Property ;
    schema:description "The neurological pathway extension that involves muscle control." ;
    schema:name "nerve motor" .

schema:netWorth a rdf:Property ;
    schema:description "The total financial value of the person as calculated by subtracting assets from liabilities." ;
    schema:name "net worth" .

schema:newsUpdatesAndGuidelines a rdf:Property ;
    schema:description "Indicates a page with news updates and guidelines. This could often be (but is not required to be) the main page containing [[SpecialAnnouncement]] markup on a site." ;
    schema:name "news updates and guidelines" .

schema:nextItem a rdf:Property ;
    schema:description "A link to the ListItem that follows the current one." ;
    schema:name "next item" .

schema:noBylinesPolicy a rdf:Property ;
    schema:description "For a [[NewsMediaOrganization]] or other news-related [[Organization]], a statement explaining when authors of articles are not named in bylines." ;
    schema:name "no bylines policy" .

schema:nonEqual a rdf:Property ;
    schema:description "This ordering relation for qualitative values indicates that the subject is not equal to the object." ;
    schema:name "non equal" .

schema:nonProprietaryName a rdf:Property ;
    schema:description "The generic name of this drug or supplement." ;
    schema:name "non proprietary name" .

schema:nonprofitStatus a rdf:Property ;
    schema:description "nonprofit Status indicates the legal status of a non-profit organization in its primary place of business." ;
    schema:name "nonprofit status" .

schema:normalRange a rdf:Property ;
    schema:description "Range of acceptable values for a typical patient, when applicable." ;
    schema:name "normal range" .

schema:nsn a rdf:Property ;
    schema:description "Indicates the [NATO stock number](https://en.wikipedia.org/wiki/NATO_Stock_Number) (nsn) of a [[Product]]. " ;
    schema:name "nsn" .

schema:numAdults a rdf:Property ;
    schema:description "The number of adults staying in the unit." ;
    schema:name "num adults" .

schema:numChildren a rdf:Property ;
    schema:description "The number of children staying in the unit." ;
    schema:name "num children" .

schema:numConstraints a rdf:Property ;
    schema:description "Indicates the number of constraints (not counting [[populationType]]) defined for a particular [[StatisticalPopulation]]. This helps applications understand if they have access to a sufficiently complete description of a [[StatisticalPopulation]]." ;
    schema:name "num constraints" .

schema:numTracks a rdf:Property ;
    schema:description "The number of tracks in this album or playlist." ;
    schema:name "num tracks" .

schema:numberOfAccommodationUnits a rdf:Property ;
    schema:description "Indicates the total (available plus unavailable) number of accommodation units in an [[ApartmentComplex]], or the number of accommodation units for a specific [[FloorPlan]] (within its specific [[ApartmentComplex]]). See also [[numberOfAvailableAccommodationUnits]]." ;
    schema:name "number of accommodation units" .

schema:numberOfAirbags a rdf:Property ;
    schema:description "The number or type of airbags in the vehicle." ;
    schema:name "number of airbags" .

schema:numberOfAvailableAccommodationUnits a rdf:Property ;
    schema:description "Indicates the number of available accommodation units in an [[ApartmentComplex]], or the number of accommodation units for a specific [[FloorPlan]] (within its specific [[ApartmentComplex]]). See also [[numberOfAccommodationUnits]]." ;
    schema:name "number of available accommodation units" .

schema:numberOfAxles a rdf:Property ;
    schema:description "The number of axles.\\n\\nTypical unit code(s): C62" ;
    schema:name "number of axles" .

schema:numberOfBathroomsTotal a rdf:Property ;
    schema:description "The total integer number of bathrooms in a some [[Accommodation]], following real estate conventions as [documented in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsTotalInteger+Field): \"The simple sum of the number of bathrooms. For example for a property with two Full Bathrooms and one Half Bathroom, the Bathrooms Total Integer will be 3.\". See also [[numberOfRooms]]." ;
    schema:name "number of bathrooms total" .

schema:numberOfBedrooms a rdf:Property ;
    schema:description "The total integer number of bedrooms in a some [[Accommodation]], [[ApartmentComplex]] or [[FloorPlan]]." ;
    schema:name "number of bedrooms" .

schema:numberOfBeds a rdf:Property ;
    schema:description "The quantity of the given bed type available in the HotelRoom, Suite, House, or Apartment." ;
    schema:name "number of beds" .

schema:numberOfCredits a rdf:Property ;
    schema:description "The number of credits or units awarded by a Course or required to complete an EducationalOccupationalProgram." ;
    schema:name "number of credits" .

schema:numberOfDoors a rdf:Property ;
    schema:description "The number of doors.\\n\\nTypical unit code(s): C62" ;
    schema:name "number of doors" .

schema:numberOfEmployees a rdf:Property ;
    schema:description "The number of employees in an organization e.g. business." ;
    schema:name "number of employees" .

schema:numberOfEpisodes a rdf:Property ;
    schema:description "The number of episodes in this season or series." ;
    schema:name "number of episodes" .

schema:numberOfForwardGears a rdf:Property ;
    schema:description "The total number of forward gears available for the transmission system of the vehicle.\\n\\nTypical unit code(s): C62" ;
    schema:name "number of forward gears" .

schema:numberOfFullBathrooms a rdf:Property ;
    schema:description "Number of full bathrooms - The total number of full and ¾ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsFull field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsFull+Field)." ;
    schema:name "number of full bathrooms" .

schema:numberOfItems a rdf:Property ;
    schema:description "The number of items in an ItemList. Note that some descriptions might not fully describe all items in a list (e.g., multi-page pagination); in such cases, the numberOfItems would be for the entire list." ;
    schema:name "number of items" .

schema:numberOfLoanPayments a rdf:Property ;
    schema:description "The number of payments contractually required at origination to repay the loan. For monthly paying loans this is the number of months from the contractual first payment date to the maturity date." ;
    schema:name "number of loan payments" .

schema:numberOfPages a rdf:Property ;
    schema:description "The number of pages in the book." ;
    schema:name "number of pages" .

schema:numberOfPartialBathrooms a rdf:Property ;
    schema:description "Number of partial bathrooms - The total number of half and ¼ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsPartial field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsPartial+Field). " ;
    schema:name "number of partial bathrooms" .

schema:numberOfPlayers a rdf:Property ;
    schema:description "Indicate how many people can play this game (minimum, maximum, or range)." ;
    schema:name "number of players" .

schema:numberOfPreviousOwners a rdf:Property ;
    schema:description "The number of owners of the vehicle, including the current one.\\n\\nTypical unit code(s): C62" ;
    schema:name "number of previous owners" .

schema:numberOfRooms a rdf:Property ;
    schema:description """The number of rooms (excluding bathrooms and closets) of the accommodation or lodging business.
Typical unit code(s): ROM for room or C62 for no unit. The type of room can be put in the unitText property of the QuantitativeValue.""" ;
    schema:name "number of rooms" .

schema:numberOfSeasons a rdf:Property ;
    schema:description "The number of seasons in this series." ;
    schema:name "number of seasons" .

schema:numberedPosition a rdf:Property ;
    schema:description "A number associated with a role in an organization, for example, the number on an athlete's jersey." ;
    schema:name "numbered position" .

schema:nutrition a rdf:Property ;
    schema:description "Nutrition information about the recipe or menu item." ;
    schema:name "nutrition" .

schema:object a rdf:Property ;
    schema:description "The object upon which the action is carried out, whose state is kept intact or changed. Also known as the semantic roles patient, affected or undergoer (which change their state) or theme (which doesn't). e.g. John read *a book*." ;
    schema:name "object" .

schema:observationDate a rdf:Property ;
    schema:description "The observationDate of an [[Observation]]." ;
    schema:name "observation date" .

schema:observedNode a rdf:Property ;
    schema:description "The observedNode of an [[Observation]], often a [[StatisticalPopulation]]." ;
    schema:name "observed node" .

schema:occupancy a rdf:Property ;
    schema:description """The allowed total occupancy for the accommodation in persons (including infants etc). For individual accommodations, this is not necessarily the legal maximum but defines the permitted usage as per the contractual agreement (e.g. a double room used by a single person).
Typical unit code(s): C62 for person""" ;
    schema:name "occupancy" .

schema:occupationLocation a rdf:Property ;
    schema:description " The region/country for which this occupational description is appropriate. Note that educational requirements and qualifications can vary between jurisdictions." ;
    schema:name "occupation location" .

schema:occupationalCategory a rdf:Property ;
    schema:description """A category describing the job, preferably using a term from a taxonomy such as [BLS O*NET-SOC](http://www.onetcenter.org/taxonomy.html), [ISCO-08](https://www.ilo.org/public/english/bureau/stat/isco/isco08/) or similar, with the property repeated for each applicable value. Ideally the taxonomy should be identified, and both the textual label and formal code for the category should be provided.\\n
Note: for historical reasons, any textual label and formal code provided as a literal may be assumed to be from O*NET-SOC.""" ;
    schema:name "occupational category" .

schema:occupationalCredentialAwarded a rdf:Property ;
    schema:description "A description of the qualification, award, certificate, diploma or other occupational credential awarded as a consequence of successful completion of this course or program." ;
    schema:name "occupational credential awarded" .

schema:offerCount a rdf:Property ;
    schema:description "The number of offers for the product." ;
    schema:name "offer count" .

schema:offeredBy a rdf:Property ;
    schema:description "A pointer to the organization or person making the offer." ;
    schema:name "offered by" .

schema:offers a rdf:Property ;
    schema:description """An offer to provide this item&#x2014;for example, an offer to sell a product, rent the DVD of a movie, perform a service, or give away tickets to an event. Use [[businessFunction]] to indicate the kind of transaction offered, i.e. sell, lease, etc. This property can also be used to describe a [[Demand]]. While this property is listed as expected on a number of common types, it can be used in others. In that case, using a second type, such as Product or a subtype of Product, can clarify the nature of the offer.
      """ ;
    schema:name "offers" .

schema:offersPrescriptionByMail a rdf:Property ;
    schema:description "Whether prescriptions can be delivered by mail." ;
    schema:name "offers prescription by mail" .

schema:openingHours a rdf:Property ;
    schema:description "The general opening hours for a business. Opening hours can be specified as a weekly time range, starting with days, then times per day. Multiple days can be listed with commas ',' separating each day. Day or time ranges are specified using a hyphen '-'.\\n\\n* Days are specified using the following two-letter combinations: ```Mo```, ```Tu```, ```We```, ```Th```, ```Fr```, ```Sa```, ```Su```.\\n* Times are specified using 24:00 format. For example, 3pm is specified as ```15:00```, 10am as ```10:00```. \\n* Here is an example: <code>&lt;time itemprop=\"openingHours\" datetime=&quot;Tu,Th 16:00-20:00&quot;&gt;Tuesdays and Thursdays 4-8pm&lt;/time&gt;</code>.\\n* If a business is open 7 days a week, then it can be specified as <code>&lt;time itemprop=&quot;openingHours&quot; datetime=&quot;Mo-Su&quot;&gt;Monday through Sunday, all day&lt;/time&gt;</code>." ;
    schema:name "opening hours" .

schema:openingHoursSpecification a rdf:Property ;
    schema:description "The opening hours of a certain place." ;
    schema:name "opening hours specification" .

schema:opens a rdf:Property ;
    schema:description "The opening hour of the place or service on the given day(s) of the week." ;
    schema:name "opens" .

schema:operatingSystem a rdf:Property ;
    schema:description "Operating systems supported (Windows 7, OSX 10.6, Android 1.6)." ;
    schema:name "operating system" .

schema:opponent a rdf:Property ;
    schema:description "A sub property of participant. The opponent on this action." ;
    schema:name "opponent" .

schema:option a rdf:Property ;
    schema:description "A sub property of object. The options subject to this action." ;
    schema:name "option" .

schema:orderDate a rdf:Property ;
    schema:description "Date order was placed." ;
    schema:name "order date" .

schema:orderDelivery a rdf:Property ;
    schema:description "The delivery of the parcel related to this order or order item." ;
    schema:name "order delivery" .

schema:orderItemNumber a rdf:Property ;
    schema:description "The identifier of the order item." ;
    schema:name "order item number" .

schema:orderItemStatus a rdf:Property ;
    schema:description "The current status of the order item." ;
    schema:name "order item status" .

schema:orderNumber a rdf:Property ;
    schema:description "The identifier of the transaction." ;
    schema:name "order number" .

schema:orderQuantity a rdf:Property ;
    schema:description "The number of the item ordered. If the property is not set, assume the quantity is one." ;
    schema:name "order quantity" .

schema:orderStatus a rdf:Property ;
    schema:description "The current status of the order." ;
    schema:name "order status" .

schema:orderedItem a rdf:Property ;
    schema:description "The item ordered." ;
    schema:name "ordered item" .

schema:organizer a rdf:Property ;
    schema:description "An organizer of an Event." ;
    schema:name "organizer" .

schema:originAddress a rdf:Property ;
    schema:description "Shipper's address." ;
    schema:name "origin address" .

schema:originalMediaContextDescription a rdf:Property ;
    schema:description "Describes, in a [[MediaReview]] when dealing with [[DecontextualizedContent]], background information that can contribute to better interpretation of the [[MediaObject]]." ;
    schema:name "original media context description" .

schema:originalMediaLink a rdf:Property ;
    schema:description "Link to the page containing an original version of the content, or directly to an online copy of the original [[MediaObject]] content, e.g. video file." ;
    schema:name "original media link" .

schema:originatesFrom a rdf:Property ;
    schema:description "The vasculature the lymphatic structure originates, or afferents, from." ;
    schema:name "originates from" .

schema:overdosage a rdf:Property ;
    schema:description "Any information related to overdose on a drug, including signs or symptoms, treatments, contact information for emergency response." ;
    schema:name "overdosage" .

schema:ownedFrom a rdf:Property ;
    schema:description "The date and time of obtaining the product." ;
    schema:name "owned from" .

schema:ownedThrough a rdf:Property ;
    schema:description "The date and time of giving up ownership on the product." ;
    schema:name "owned through" .

schema:ownershipFundingInfo a rdf:Property ;
    schema:description "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a description of organizational ownership structure; funding and grants. In a news/media setting, this is with particular reference to editorial independence.   Note that the [[funder]] is also available and can be used to make basic funder information machine-readable." ;
    schema:name "ownership funding info" .

schema:owns a rdf:Property ;
    schema:description "Products owned by the organization or person." ;
    schema:name "owns" .

schema:pageEnd a rdf:Property ;
    schema:description "The page on which the work ends; for example \"138\" or \"xvi\"." ;
    schema:name "page end" .

schema:pageStart a rdf:Property ;
    schema:description "The page on which the work starts; for example \"135\" or \"xiii\"." ;
    schema:name "page start" .

schema:pagination a rdf:Property ;
    schema:description "Any description of pages that is not separated into pageStart and pageEnd; for example, \"1-6, 9, 55\" or \"10-12, 46-49\"." ;
    schema:name "pagination" .

schema:parent a rdf:Property ;
    schema:description "A parent of this person." ;
    schema:name "parent" .

schema:parentItem a rdf:Property ;
    schema:description "The parent of a question, answer or item in general." ;
    schema:name "parent item" .

schema:parentOrganization a rdf:Property ;
    schema:description "The larger organization that this organization is a [[subOrganization]] of, if any." ;
    schema:name "parent organization" .

schema:parentService a rdf:Property ;
    schema:description "A broadcast service to which the broadcast service may belong to such as regional variations of a national channel." ;
    schema:name "parent service" .

schema:parentTaxon a rdf:Property ;
    schema:description "Closest parent taxon of the taxon in question." ;
    schema:name "parent taxon" .

schema:parents a rdf:Property ;
    schema:description "A parents of the person." ;
    schema:name "parents" .

schema:partOfEpisode a rdf:Property ;
    schema:description "The episode to which this clip belongs." ;
    schema:name "part of episode" .

schema:partOfInvoice a rdf:Property ;
    schema:description "The order is being paid as part of the referenced Invoice." ;
    schema:name "part of invoice" .

schema:partOfOrder a rdf:Property ;
    schema:description "The overall order the items in this delivery were included in." ;
    schema:name "part of order" .

schema:partOfSeason a rdf:Property ;
    schema:description "The season to which this episode belongs." ;
    schema:name "part of season" .

schema:partOfSeries a rdf:Property ;
    schema:description "The series to which this episode or season belongs." ;
    schema:name "part of series" .

schema:partOfSystem a rdf:Property ;
    schema:description "The anatomical or organ system that this structure is part of." ;
    schema:name "part of system" .

schema:partOfTVSeries a rdf:Property ;
    schema:description "The TV series to which this episode or season belongs." ;
    schema:name "part of tv series" .

schema:partOfTrip a rdf:Property ;
    schema:description "Identifies that this [[Trip]] is a subTrip of another Trip.  For example Day 1, Day 2, etc. of a multi-day trip." ;
    schema:name "part of trip" .

schema:participant a rdf:Property ;
    schema:description "Other co-agents that participated in the action indirectly. e.g. John wrote a book with *Steve*." ;
    schema:name "participant" .

schema:partySize a rdf:Property ;
    schema:description "Number of people the reservation should accommodate." ;
    schema:name "party size" .

schema:passengerPriorityStatus a rdf:Property ;
    schema:description "The priority status assigned to a passenger for security or boarding (e.g. FastTrack or Priority)." ;
    schema:name "passenger priority status" .

schema:passengerSequenceNumber a rdf:Property ;
    schema:description "The passenger's sequence number as assigned by the airline." ;
    schema:name "passenger sequence number" .

schema:pathophysiology a rdf:Property ;
    schema:description "Changes in the normal mechanical, physical, and biochemical functions that are associated with this activity or condition." ;
    schema:name "pathophysiology" .

schema:pattern a rdf:Property ;
    schema:description "A pattern that something has, for example 'polka dot', 'striped', 'Canadian flag'. Values are typically expressed as text, although links to controlled value schemes are also supported." ;
    schema:name "pattern" .

schema:payload a rdf:Property ;
    schema:description "The permitted weight of passengers and cargo, EXCLUDING the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: Many databases specify the permitted TOTAL weight instead, which is the sum of [[weight]] and [[payload]]\\n* Note 2: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 3: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 4: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "payload" .

schema:paymentAccepted a rdf:Property ;
    schema:description "Cash, Credit Card, Cryptocurrency, Local Exchange Tradings System, etc." ;
    schema:name "payment accepted" .

schema:paymentDue a rdf:Property ;
    schema:description "The date that payment is due." ;
    schema:name "payment due" .

schema:paymentDueDate a rdf:Property ;
    schema:description "The date that payment is due." ;
    schema:name "payment due date" .

schema:paymentMethod a rdf:Property ;
    schema:description "The name of the credit card or other method of payment for the order." ;
    schema:name "payment method" .

schema:paymentMethodId a rdf:Property ;
    schema:description "An identifier for the method of payment used (e.g. the last 4 digits of the credit card)." ;
    schema:name "payment method id" .

schema:paymentStatus a rdf:Property ;
    schema:description "The status of payment; whether the invoice has been paid or not." ;
    schema:name "payment status" .

schema:paymentUrl a rdf:Property ;
    schema:description "The URL for sending a payment." ;
    schema:name "payment url" .

schema:penciler a rdf:Property ;
    schema:description "The individual who draws the primary narrative artwork." ;
    schema:name "penciler" .

schema:percentile10 a rdf:Property ;
    schema:description "The 10th percentile value." ;
    schema:name "percentile10" .

schema:percentile25 a rdf:Property ;
    schema:description "The 25th percentile value." ;
    schema:name "percentile25" .

schema:percentile75 a rdf:Property ;
    schema:description "The 75th percentile value." ;
    schema:name "percentile75" .

schema:percentile90 a rdf:Property ;
    schema:description "The 90th percentile value." ;
    schema:name "percentile90" .

schema:performTime a rdf:Property ;
    schema:description "The length of time it takes to perform instructions or a direction (not including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    schema:name "perform time" .

schema:performer a rdf:Property ;
    schema:description "A performer at the event&#x2014;for example, a presenter, musician, musical group or actor." ;
    schema:name "performer" .

schema:performerIn a rdf:Property ;
    schema:description "Event that this person is a performer or participant in." ;
    schema:name "performer in" .

schema:performers a rdf:Property ;
    schema:description "The main performer or performers of the event&#x2014;for example, a presenter, musician, or actor." ;
    schema:name "performers" .

schema:permissionType a rdf:Property ;
    schema:description "The type of permission granted the person, organization, or audience." ;
    schema:name "permission type" .

schema:permissions a rdf:Property ;
    schema:description "Permission(s) required to run the app (for example, a mobile app may require full internet access or may run only on wifi)." ;
    schema:name "permissions" .

schema:permitAudience a rdf:Property ;
    schema:description "The target audience for this permit." ;
    schema:name "permit audience" .

schema:permittedUsage a rdf:Property ;
    schema:description "Indications regarding the permitted usage of the accommodation." ;
    schema:name "permitted usage" .

schema:petsAllowed a rdf:Property ;
    schema:description "Indicates whether pets are allowed to enter the accommodation or lodging business. More detailed information can be put in a text value." ;
    schema:name "pets allowed" .

schema:phoneticText a rdf:Property ;
    schema:description "Representation of a text [[textValue]] using the specified [[speechToTextMarkup]]. For example the city name of Houston in IPA: /ˈhjuːstən/." ;
    schema:name "phonetic text" .

schema:photo a rdf:Property ;
    schema:description "A photograph of this place." ;
    schema:name "photo" .

schema:photos a rdf:Property ;
    schema:description "Photographs of this place." ;
    schema:name "photos" .

schema:physicalRequirement a rdf:Property ;
    schema:description "A description of the types of physical activity associated with the job. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." ;
    schema:name "physical requirement" .

schema:physiologicalBenefits a rdf:Property ;
    schema:description "Specific physiologic benefits associated to the plan." ;
    schema:name "physiological benefits" .

schema:pickupLocation a rdf:Property ;
    schema:description "Where a taxi will pick up a passenger or a rental car can be picked up." ;
    schema:name "pickup location" .

schema:pickupTime a rdf:Property ;
    schema:description "When a taxi will pickup a passenger or a rental car can be picked up." ;
    schema:name "pickup time" .

schema:playMode a rdf:Property ;
    schema:description "Indicates whether this game is multi-player, co-op or single-player.  The game can be marked as multi-player, co-op and single-player at the same time." ;
    schema:name "play mode" .

schema:playerType a rdf:Property ;
    schema:description "Player type required&#x2014;for example, Flash or Silverlight." ;
    schema:name "player type" .

schema:playersOnline a rdf:Property ;
    schema:description "Number of players on the server." ;
    schema:name "players online" .

schema:polygon a rdf:Property ;
    schema:description "A polygon is the area enclosed by a point-to-point path for which the starting and ending points are the same. A polygon is expressed as a series of four or more space delimited points where the first and final points are identical." ;
    schema:name "polygon" .

schema:populationType a rdf:Property ;
    schema:description "Indicates the populationType common to all members of a [[StatisticalPopulation]]." ;
    schema:name "population type" .

schema:position a rdf:Property ;
    schema:description "The position of an item in a series or sequence of items." ;
    schema:name "position" .

schema:positiveNotes a rdf:Property ;
    schema:description "Indicates, in the context of a [[Review]] (e.g. framed as 'pro' vs 'con' considerations), positive considerations - either as unstructured text, or a list." ;
    schema:name "positive notes" .

schema:possibleComplication a rdf:Property ;
    schema:description "A possible unexpected and unfavorable evolution of a medical condition. Complications may include worsening of the signs or symptoms of the disease, extension of the condition to other organ systems, etc." ;
    schema:name "possible complication" .

schema:possibleTreatment a rdf:Property ;
    schema:description "A possible treatment to address this condition, sign or symptom." ;
    schema:name "possible treatment" .

schema:postOfficeBoxNumber a rdf:Property ;
    schema:description "The post office box number for PO box addresses." ;
    schema:name "post office box number" .

schema:postOp a rdf:Property ;
    schema:description "A description of the postoperative procedures, care, and/or followups for this device." ;
    schema:name "post op" .

schema:postalCode a rdf:Property ;
    schema:description "The postal code. For example, 94043." ;
    schema:name "postal code" .

schema:postalCodeBegin a rdf:Property ;
    schema:description "First postal code in a range (included)." ;
    schema:name "postal code begin" .

schema:postalCodeEnd a rdf:Property ;
    schema:description "Last postal code in the range (included). Needs to be after [[postalCodeBegin]]." ;
    schema:name "postal code end" .

schema:postalCodePrefix a rdf:Property ;
    schema:description "A defined range of postal codes indicated by a common textual prefix. Used for non-numeric systems such as UK." ;
    schema:name "postal code prefix" .

schema:postalCodeRange a rdf:Property ;
    schema:description "A defined range of postal codes." ;
    schema:name "postal code range" .

schema:potentialAction a rdf:Property ;
    schema:description "Indicates a potential Action, which describes an idealized action in which this thing would play an 'object' role." ;
    schema:name "potential action" .

schema:potentialUse a rdf:Property ;
    schema:description "Intended use of the BioChemEntity by humans." ;
    schema:name "potential use" .

schema:preOp a rdf:Property ;
    schema:description "A description of the workup, testing, and other preparations required before implanting this device." ;
    schema:name "pre op" .

schema:predecessorOf a rdf:Property ;
    schema:description "A pointer from a previous, often discontinued variant of the product to its newer variant." ;
    schema:name "predecessor of" .

schema:pregnancyCategory a rdf:Property ;
    schema:description "Pregnancy category of this drug." ;
    schema:name "pregnancy category" .

schema:pregnancyWarning a rdf:Property ;
    schema:description "Any precaution, guidance, contraindication, etc. related to this drug's use during pregnancy." ;
    schema:name "pregnancy warning" .

schema:prepTime a rdf:Property ;
    schema:description "The length of time it takes to prepare the items to be used in instructions or a direction, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    schema:name "prep time" .

schema:preparation a rdf:Property ;
    schema:description "Typical preparation that a patient must undergo before having the procedure performed." ;
    schema:name "preparation" .

schema:prescribingInfo a rdf:Property ;
    schema:description "Link to prescribing information for the drug." ;
    schema:name "prescribing info" .

schema:prescriptionStatus a rdf:Property ;
    schema:description "Indicates the status of drug prescription eg. local catalogs classifications or whether the drug is available by prescription or over-the-counter, etc." ;
    schema:name "prescription status" .

schema:previousItem a rdf:Property ;
    schema:description "A link to the ListItem that preceeds the current one." ;
    schema:name "previous item" .

schema:previousStartDate a rdf:Property ;
    schema:description "Used in conjunction with eventStatus for rescheduled or cancelled events. This property contains the previously scheduled start date. For rescheduled events, the startDate property should be used for the newly scheduled start date. In the (rare) case of an event that has been postponed and rescheduled multiple times, this field may be repeated." ;
    schema:name "previous start date" .

schema:price a rdf:Property ;
    schema:description """The offer price of a product, or of a price component when attached to PriceSpecification and its subtypes.\\n\\nUsage guidelines:\\n\\n* Use the [[priceCurrency]] property (with standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. "USD"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. "BTC"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. "Ithaca HOUR") instead of including [ambiguous symbols](http://en.wikipedia.org/wiki/Dollar_sign#Currencies_that_use_the_dollar_or_peso_sign) such as '$' in the value.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.\\n* Note that both [RDFa](http://www.w3.org/TR/xhtml-rdfa-primer/#using-the-content-attribute) and Microdata syntax allow the use of a "content=" attribute for publishing simple machine-readable values alongside more human-friendly formatting.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.
      """ ;
    schema:name "price" .

schema:priceComponent a rdf:Property ;
    schema:description "This property links to all [[UnitPriceSpecification]] nodes that apply in parallel for the [[CompoundPriceSpecification]] node." ;
    schema:name "price component" .

schema:priceComponentType a rdf:Property ;
    schema:description "Identifies a price component (for example, a line item on an invoice), part of the total price for an offer." ;
    schema:name "price component type" .

schema:priceCurrency a rdf:Property ;
    schema:description "The currency of the price, or a price component when attached to [[PriceSpecification]] and its subtypes.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217) e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies e.g. \"BTC\"; well known names for [Local Exchange Tradings Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types e.g. \"Ithaca HOUR\"." ;
    schema:name "price currency" .

schema:priceRange a rdf:Property ;
    schema:description "The price range of the business, for example ```$$$```." ;
    schema:name "price range" .

schema:priceSpecification a rdf:Property ;
    schema:description "One or more detailed price specifications, indicating the unit price and delivery or payment charges." ;
    schema:name "price specification" .

schema:priceType a rdf:Property ;
    schema:description "Defines the type of a price specified for an offered product, for example a list price, a (temporary) sale price or a manufacturer suggested retail price. If multiple prices are specified for an offer the [[priceType]] property can be used to identify the type of each such specified price. The value of priceType can be specified as a value from enumeration PriceTypeEnumeration or as a free form text string for price types that are not already predefined in PriceTypeEnumeration." ;
    schema:name "price type" .

schema:priceValidUntil a rdf:Property ;
    schema:description "The date after which the price is no longer available." ;
    schema:name "price valid until" .

schema:primaryImageOfPage a rdf:Property ;
    schema:description "Indicates the main image on the page." ;
    schema:name "primary image of page" .

schema:primaryPrevention a rdf:Property ;
    schema:description "A preventative therapy used to prevent an initial occurrence of the medical condition, such as vaccination." ;
    schema:name "primary prevention" .

schema:printColumn a rdf:Property ;
    schema:description "The number of the column in which the NewsArticle appears in the print edition." ;
    schema:name "print column" .

schema:printEdition a rdf:Property ;
    schema:description "The edition of the print product in which the NewsArticle appears." ;
    schema:name "print edition" .

schema:printPage a rdf:Property ;
    schema:description "If this NewsArticle appears in print, this field indicates the name of the page on which the article is found. Please note that this field is intended for the exact page name (e.g. A5, B18)." ;
    schema:name "print page" .

schema:printSection a rdf:Property ;
    schema:description "If this NewsArticle appears in print, this field indicates the print section in which the article appeared." ;
    schema:name "print section" .

schema:procedure a rdf:Property ;
    schema:description "A description of the procedure involved in setting up, using, and/or installing the device." ;
    schema:name "procedure" .

schema:procedureType a rdf:Property ;
    schema:description "The type of procedure, for example Surgical, Noninvasive, or Percutaneous." ;
    schema:name "procedure type" .

schema:processingTime a rdf:Property ;
    schema:description "Estimated processing time for the service using this channel." ;
    schema:name "processing time" .

schema:processorRequirements a rdf:Property ;
    schema:description "Processor architecture required to run the application (e.g. IA64)." ;
    schema:name "processor requirements" .

schema:producer a rdf:Property ;
    schema:description "The person or organization who produced the work (e.g. music album, movie, tv/radio series etc.)." ;
    schema:name "producer" .

schema:produces a rdf:Property ;
    schema:description "The tangible thing generated by the service, e.g. a passport, permit, etc." ;
    schema:name "produces" .

schema:productGroupID a rdf:Property ;
    schema:description "Indicates a textual identifier for a ProductGroup." ;
    schema:name "product group id" .

schema:productID a rdf:Property ;
    schema:description "The product identifier, such as ISBN. For example: ``` meta itemprop=\"productID\" content=\"isbn:123-456-789\" ```." ;
    schema:name "product id" .

schema:productSupported a rdf:Property ;
    schema:description "The product or service this support contact point is related to (such as product support for a particular product line). This can be a specific product or product line (e.g. \"iPhone\") or a general category of products or services (e.g. \"smartphones\")." ;
    schema:name "product supported" .

schema:productionCompany a rdf:Property ;
    schema:description "The production company or studio responsible for the item e.g. series, video game, episode etc." ;
    schema:name "production company" .

schema:productionDate a rdf:Property ;
    schema:description "The date of production of the item, e.g. vehicle." ;
    schema:name "production date" .

schema:proficiencyLevel a rdf:Property ;
    schema:description "Proficiency needed for this content; expected values: 'Beginner', 'Expert'." ;
    schema:name "proficiency level" .

schema:programMembershipUsed a rdf:Property ;
    schema:description "Any membership in a frequent flyer, hotel loyalty program, etc. being applied to the reservation." ;
    schema:name "program membership used" .

schema:programName a rdf:Property ;
    schema:description "The program providing the membership." ;
    schema:name "program name" .

schema:programPrerequisites a rdf:Property ;
    schema:description "Prerequisites for enrolling in the program." ;
    schema:name "program prerequisites" .

schema:programType a rdf:Property ;
    schema:description "The type of educational or occupational program. For example, classroom, internship, alternance, etc.." ;
    schema:name "program type" .

schema:programmingLanguage a rdf:Property ;
    schema:description "The computer programming language." ;
    schema:name "programming language" .

schema:programmingModel a rdf:Property ;
    schema:description "Indicates whether API is managed or unmanaged." ;
    schema:name "programming model" .

schema:propertyID a rdf:Property ;
    schema:description """A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be
(1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific id of the property), or (3)
a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry).
Standards bodies should promote a standard prefix for the identifiers of properties from their standards.""" ;
    schema:name "property id" .

schema:proprietaryName a rdf:Property ;
    schema:description "Proprietary name given to the diet plan, typically by its originator or creator." ;
    schema:name "proprietary name" .

schema:proteinContent a rdf:Property ;
    schema:description "The number of grams of protein." ;
    schema:name "protein content" .

schema:provider a rdf:Property ;
    schema:description "The service provider, service operator, or service performer; the goods producer. Another party (a seller) may offer those services or goods on behalf of the provider. A provider may also serve as the seller." ;
    schema:name "provider" .

schema:providerMobility a rdf:Property ;
    schema:description "Indicates the mobility of a provided service (e.g. 'static', 'dynamic')." ;
    schema:name "provider mobility" .

schema:providesBroadcastService a rdf:Property ;
    schema:description "The BroadcastService offered on this channel." ;
    schema:name "provides broadcast service" .

schema:providesService a rdf:Property ;
    schema:description "The service provided by this channel." ;
    schema:name "provides service" .

schema:publicAccess a rdf:Property ;
    schema:description "A flag to signal that the [[Place]] is open to public visitors.  If this property is omitted there is no assumed default boolean value" ;
    schema:name "public access" .

schema:publicTransportClosuresInfo a rdf:Property ;
    schema:description "Information about public transport closures." ;
    schema:name "public transport closures info" .

schema:publication a rdf:Property ;
    schema:description "A publication event associated with the item." ;
    schema:name "publication" .

schema:publicationType a rdf:Property ;
    schema:description "The type of the medical article, taken from the US NLM MeSH publication type catalog. See also [MeSH documentation](http://www.nlm.nih.gov/mesh/pubtypes.html)." ;
    schema:name "publication type" .

schema:publishedBy a rdf:Property ;
    schema:description "An agent associated with the publication event." ;
    schema:name "published by" .

schema:publishedOn a rdf:Property ;
    schema:description "A broadcast service associated with the publication event." ;
    schema:name "published on" .

schema:publisher a rdf:Property ;
    schema:description "The publisher of the creative work." ;
    schema:name "publisher" .

schema:publisherImprint a rdf:Property ;
    schema:description "The publishing division which published the comic." ;
    schema:name "publisher imprint" .

schema:publishingPrinciples a rdf:Property ;
    schema:description """The publishingPrinciples property indicates (typically via [[URL]]) a document describing the editorial principles of an [[Organization]] (or individual e.g. a [[Person]] writing a blog) that relate to their activities as a publisher, e.g. ethics or diversity policies. When applied to a [[CreativeWork]] (e.g. [[NewsArticle]]) the principles are those of the party primarily responsible for the creation of the [[CreativeWork]].

While such policies are most typically expressed in natural language, sometimes related information (e.g. indicating a [[funder]]) can be expressed using schema.org terminology.
""" ;
    schema:name "publishing principles" .

schema:purchaseDate a rdf:Property ;
    schema:description "The date the item e.g. vehicle was purchased by the current owner." ;
    schema:name "purchase date" .

schema:qualifications a rdf:Property ;
    schema:description "Specific qualifications required for this role or Occupation." ;
    schema:name "qualifications" .

schema:quarantineGuidelines a rdf:Property ;
    schema:description "Guidelines about quarantine rules, e.g. in the context of a pandemic." ;
    schema:name "quarantine guidelines" .

schema:query a rdf:Property ;
    schema:description "A sub property of instrument. The query used on this action." ;
    schema:name "query" .

schema:quest a rdf:Property ;
    schema:description "The task that a player-controlled character, or group of characters may complete in order to gain a reward." ;
    schema:name "quest" .

schema:question a rdf:Property ;
    schema:description "A sub property of object. A question." ;
    schema:name "question" .

schema:rangeIncludes a rdf:Property ;
    schema:description "Relates a property to a class that constitutes (one of) the expected type(s) for values of the property." ;
    schema:name "range includes" .

schema:ratingCount a rdf:Property ;
    schema:description "The count of total number of ratings." ;
    schema:name "rating count" .

schema:ratingExplanation a rdf:Property ;
    schema:description "A short explanation (e.g. one to two sentences) providing background context and other information that led to the conclusion expressed in the rating. This is particularly applicable to ratings associated with \"fact check\" markup using [[ClaimReview]]." ;
    schema:name "rating explanation" .

schema:ratingValue a rdf:Property ;
    schema:description "The rating for the content.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    schema:name "rating value" .

schema:readBy a rdf:Property ;
    schema:description "A person who reads (performs) the audiobook." ;
    schema:name "read by" .

schema:readonlyValue a rdf:Property ;
    schema:description "Whether or not a property is mutable.  Default is false. Specifying this for a property that also has a value makes it act similar to a \"hidden\" input in an HTML form." ;
    schema:name "readonly value" .

schema:realEstateAgent a rdf:Property ;
    schema:description "A sub property of participant. The real estate agent involved in the action." ;
    schema:name "real estate agent" .

schema:recipe a rdf:Property ;
    schema:description "A sub property of instrument. The recipe/instructions used to perform the action." ;
    schema:name "recipe" .

schema:recipeCategory a rdf:Property ;
    schema:description "The category of the recipe—for example, appetizer, entree, etc." ;
    schema:name "recipe category" .

schema:recipeCuisine a rdf:Property ;
    schema:description "The cuisine of the recipe (for example, French or Ethiopian)." ;
    schema:name "recipe cuisine" .

schema:recipeIngredient a rdf:Property ;
    schema:description "A single ingredient used in the recipe, e.g. sugar, flour or garlic." ;
    schema:name "recipe ingredient" .

schema:recipeInstructions a rdf:Property ;
    schema:description "A step in making the recipe, in the form of a single item (document, video, etc.) or an ordered list with HowToStep and/or HowToSection items." ;
    schema:name "recipe instructions" .

schema:recipeYield a rdf:Property ;
    schema:description "The quantity produced by the recipe (for example, number of people served, number of servings, etc)." ;
    schema:name "recipe yield" .

schema:recipient a rdf:Property ;
    schema:description "A sub property of participant. The participant who is at the receiving end of the action." ;
    schema:name "recipient" .

schema:recognizedBy a rdf:Property ;
    schema:description "An organization that acknowledges the validity, value or utility of a credential. Note: recognition may include a process of quality assurance or accreditation." ;
    schema:name "recognized by" .

schema:recognizingAuthority a rdf:Property ;
    schema:description "If applicable, the organization that officially recognizes this entity as part of its endorsed system of medicine." ;
    schema:name "recognizing authority" .

schema:recommendationStrength a rdf:Property ;
    schema:description "Strength of the guideline's recommendation (e.g. 'class I')." ;
    schema:name "recommendation strength" .

schema:recommendedIntake a rdf:Property ;
    schema:description "Recommended intake of this supplement for a given population as defined by a specific recommending authority." ;
    schema:name "recommended intake" .

schema:recordLabel a rdf:Property ;
    schema:description "The label that issued the release." ;
    schema:name "record label" .

schema:recordedAs a rdf:Property ;
    schema:description "An audio recording of the work." ;
    schema:name "recorded as" .

schema:recordedAt a rdf:Property ;
    schema:description "The Event where the CreativeWork was recorded. The CreativeWork may capture all or part of the event." ;
    schema:name "recorded at" .

schema:recordedIn a rdf:Property ;
    schema:description "The CreativeWork that captured all or part of this Event." ;
    schema:name "recorded in" .

schema:recordingOf a rdf:Property ;
    schema:description "The composition this track is a recording of." ;
    schema:name "recording of" .

schema:recourseLoan a rdf:Property ;
    schema:description "The only way you get the money back in the event of default is the security. Recourse is where you still have the opportunity to go back to the borrower for the rest of the money." ;
    schema:name "recourse loan" .

schema:referenceQuantity a rdf:Property ;
    schema:description "The reference quantity for which a certain price applies, e.g. 1 EUR per 4 kWh of electricity. This property is a replacement for unitOfMeasurement for the advanced cases where the price does not relate to a standard unit." ;
    schema:name "reference quantity" .

schema:referencesOrder a rdf:Property ;
    schema:description "The Order(s) related to this Invoice. One or more Orders may be combined into a single Invoice." ;
    schema:name "references order" .

schema:refundType a rdf:Property ;
    schema:description "A refund type, from an enumerated list." ;
    schema:name "refund type" .

schema:regionDrained a rdf:Property ;
    schema:description "The anatomical or organ system drained by this vessel; generally refers to a specific part of an organ." ;
    schema:name "region drained" .

schema:regionsAllowed a rdf:Property ;
    schema:description "The regions where the media is allowed. If not specified, then it's assumed to be allowed everywhere. Specify the countries in [ISO 3166 format](http://en.wikipedia.org/wiki/ISO_3166)." ;
    schema:name "regions allowed" .

schema:relatedAnatomy a rdf:Property ;
    schema:description "Anatomical systems or structures that relate to the superficial anatomy." ;
    schema:name "related anatomy" .

schema:relatedCondition a rdf:Property ;
    schema:description "A medical condition associated with this anatomy." ;
    schema:name "related condition" .

schema:relatedDrug a rdf:Property ;
    schema:description "Any other drug related to this one, for example commonly-prescribed alternatives." ;
    schema:name "related drug" .

schema:relatedLink a rdf:Property ;
    schema:description "A link related to this web page, for example to other related web pages." ;
    schema:name "related link" .

schema:relatedStructure a rdf:Property ;
    schema:description "Related anatomical structure(s) that are not part of the system but relate or connect to it, such as vascular bundles associated with an organ system." ;
    schema:name "related structure" .

schema:relatedTherapy a rdf:Property ;
    schema:description "A medical therapy related to this anatomy." ;
    schema:name "related therapy" .

schema:relatedTo a rdf:Property ;
    schema:description "The most generic familial relation." ;
    schema:name "related to" .

schema:releaseDate a rdf:Property ;
    schema:description "The release date of a product or product model. This can be used to distinguish the exact variant of a product." ;
    schema:name "release date" .

schema:releaseNotes a rdf:Property ;
    schema:description "Description of what changed in this version." ;
    schema:name "release notes" .

schema:releaseOf a rdf:Property ;
    schema:description "The album this is a release of." ;
    schema:name "release of" .

schema:releasedEvent a rdf:Property ;
    schema:description "The place and time the release was issued, expressed as a PublicationEvent." ;
    schema:name "released event" .

schema:relevantOccupation a rdf:Property ;
    schema:description "The Occupation for the JobPosting." ;
    schema:name "relevant occupation" .

schema:relevantSpecialty a rdf:Property ;
    schema:description "If applicable, a medical specialty in which this entity is relevant." ;
    schema:name "relevant specialty" .

schema:remainingAttendeeCapacity a rdf:Property ;
    schema:description "The number of attendee places for an event that remain unallocated." ;
    schema:name "remaining attendee capacity" .

schema:renegotiableLoan a rdf:Property ;
    schema:description "Whether the terms for payment of interest can be renegotiated during the life of the loan." ;
    schema:name "renegotiable loan" .

schema:repeatCount a rdf:Property ;
    schema:description "Defines the number of times a recurring [[Event]] will take place" ;
    schema:name "repeat count" .

schema:repeatFrequency a rdf:Property ;
    schema:description """Defines the frequency at which [[Event]]s will occur according to a schedule [[Schedule]]. The intervals between
      events should be defined as a [[Duration]] of time.""" ;
    schema:name "repeat frequency" .

schema:repetitions a rdf:Property ;
    schema:description "Number of times one should repeat the activity." ;
    schema:name "repetitions" .

schema:replacee a rdf:Property ;
    schema:description "A sub property of object. The object that is being replaced." ;
    schema:name "replacee" .

schema:replacer a rdf:Property ;
    schema:description "A sub property of object. The object that replaces." ;
    schema:name "replacer" .

schema:replyToUrl a rdf:Property ;
    schema:description "The URL at which a reply may be posted to the specified UserComment." ;
    schema:name "reply to url" .

schema:reportNumber a rdf:Property ;
    schema:description "The number or other unique designator assigned to a Report by the publishing organization." ;
    schema:name "report number" .

schema:representativeOfPage a rdf:Property ;
    schema:description "Indicates whether this image is representative of the content of the page." ;
    schema:name "representative of page" .

schema:requiredCollateral a rdf:Property ;
    schema:description "Assets required to secure loan or credit repayments. It may take form of third party pledge, goods, financial instruments (cash, securities, etc.)" ;
    schema:name "required collateral" .

schema:requiredGender a rdf:Property ;
    schema:description "Audiences defined by a person's gender." ;
    schema:name "required gender" .

schema:requiredMaxAge a rdf:Property ;
    schema:description "Audiences defined by a person's maximum age." ;
    schema:name "required max age" .

schema:requiredMinAge a rdf:Property ;
    schema:description "Audiences defined by a person's minimum age." ;
    schema:name "required min age" .

schema:requiredQuantity a rdf:Property ;
    schema:description "The required quantity of the item(s)." ;
    schema:name "required quantity" .

schema:requirements a rdf:Property ;
    schema:description "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (Examples: DirectX, Java or .NET runtime)." ;
    schema:name "requirements" .

schema:requiresSubscription a rdf:Property ;
    schema:description "Indicates if use of the media require a subscription  (either paid or free). Allowed values are ```true``` or ```false``` (note that an earlier version had 'yes', 'no')." ;
    schema:name "requires subscription" .

schema:reservationFor a rdf:Property ;
    schema:description "The thing -- flight, event, restaurant,etc. being reserved." ;
    schema:name "reservation for" .

schema:reservationId a rdf:Property ;
    schema:description "A unique identifier for the reservation." ;
    schema:name "reservation id" .

schema:reservationStatus a rdf:Property ;
    schema:description "The current status of the reservation." ;
    schema:name "reservation status" .

schema:reservedTicket a rdf:Property ;
    schema:description "A ticket associated with the reservation." ;
    schema:name "reserved ticket" .

schema:responsibilities a rdf:Property ;
    schema:description "Responsibilities associated with this role or Occupation." ;
    schema:name "responsibilities" .

schema:restPeriods a rdf:Property ;
    schema:description "How often one should break from the activity." ;
    schema:name "rest periods" .

schema:restockingFee a rdf:Property ;
    schema:description "Use [[MonetaryAmount]] to specify a fixed restocking fee for product returns, or use [[Number]] to specify a percentage of the product price paid by the customer." ;
    schema:name "restocking fee" .

schema:result a rdf:Property ;
    schema:description "The result produced in the action. e.g. John wrote *a book*." ;
    schema:name "result" .

schema:resultComment a rdf:Property ;
    schema:description "A sub property of result. The Comment created or sent as a result of this action." ;
    schema:name "result comment" .

schema:resultReview a rdf:Property ;
    schema:description "A sub property of result. The review that resulted in the performing of the action." ;
    schema:name "result review" .

schema:returnFees a rdf:Property ;
    schema:description "The type of return fees for purchased products (for any return reason)" ;
    schema:name "return fees" .

schema:returnLabelSource a rdf:Property ;
    schema:description "The method (from an enumeration) by which the customer obtains a return shipping label for a product returned for any reason." ;
    schema:name "return label source" .

schema:returnMethod a rdf:Property ;
    schema:description "The type of return method offered, specified from an enumeration." ;
    schema:name "return method" .

schema:returnPolicyCategory a rdf:Property ;
    schema:description "Specifies an applicable return policy (from an enumeration)." ;
    schema:name "return policy category" .

schema:returnPolicyCountry a rdf:Property ;
    schema:description "The country where the product has to be sent to for returns, for example \"Ireland\" using the [[name]] property of [[Country]]. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1). Note that this can be different from the country where the product was originally shipped from or sent too." ;
    schema:name "return policy country" .

schema:returnPolicySeasonalOverride a rdf:Property ;
    schema:description "Seasonal override of a return policy." ;
    schema:name "return policy seasonal override" .

schema:returnShippingFeesAmount a rdf:Property ;
    schema:description "Amount of shipping costs for product returns (for any reason). Applicable when property [[returnFees]] equals [[ReturnShippingFees]]." ;
    schema:name "return shipping fees amount" .

schema:review a rdf:Property ;
    schema:description "A review of the item." ;
    schema:name "review" .

schema:reviewAspect a rdf:Property ;
    schema:description "This Review or Rating is relevant to this part or facet of the itemReviewed." ;
    schema:name "review aspect" .

schema:reviewBody a rdf:Property ;
    schema:description "The actual body of the review." ;
    schema:name "review body" .

schema:reviewCount a rdf:Property ;
    schema:description "The count of total number of reviews." ;
    schema:name "review count" .

schema:reviewRating a rdf:Property ;
    schema:description "The rating given in this review. Note that reviews can themselves be rated. The ```reviewRating``` applies to rating given by the review. The [[aggregateRating]] property applies to the review itself, as a creative work." ;
    schema:name "review rating" .

schema:reviewedBy a rdf:Property ;
    schema:description "People or organizations that have reviewed the content on this web page for accuracy and/or completeness." ;
    schema:name "reviewed by" .

schema:reviews a rdf:Property ;
    schema:description "Review of the item." ;
    schema:name "reviews" .

schema:riskFactor a rdf:Property ;
    schema:description "A modifiable or non-modifiable factor that increases the risk of a patient contracting this condition, e.g. age,  coexisting condition." ;
    schema:name "risk factor" .

schema:risks a rdf:Property ;
    schema:description "Specific physiologic risks associated to the diet plan." ;
    schema:name "risks" .

schema:roleName a rdf:Property ;
    schema:description "A role played, performed or filled by a person or organization. For example, the team of creators for a comic book might fill the roles named 'inker', 'penciller', and 'letterer'; or an athlete in a SportsTeam might play in the position named 'Quarterback'." ;
    schema:name "role name" .

schema:roofLoad a rdf:Property ;
    schema:description "The permitted total weight of cargo and installations (e.g. a roof rack) on top of the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]]\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "roof load" .

schema:rsvpResponse a rdf:Property ;
    schema:description "The response (yes, no, maybe) to the RSVP." ;
    schema:name "rsvp response" .

schema:runsTo a rdf:Property ;
    schema:description "The vasculature the lymphatic structure runs, or efferents, to." ;
    schema:name "runs to" .

schema:runtime a rdf:Property ;
    schema:description "Runtime platform or script interpreter dependencies (Example - Java v1, Python2.3, .Net Framework 3.0)." ;
    schema:name "runtime" .

schema:runtimePlatform a rdf:Property ;
    schema:description "Runtime platform or script interpreter dependencies (Example - Java v1, Python2.3, .Net Framework 3.0)." ;
    schema:name "runtime platform" .

schema:rxcui a rdf:Property ;
    schema:description "The RxCUI drug identifier from RXNORM." ;
    schema:name "rxcui" .

schema:safetyConsideration a rdf:Property ;
    schema:description "Any potential safety concern associated with the supplement. May include interactions with other drugs and foods, pregnancy, breastfeeding, known adverse reactions, and documented efficacy of the supplement." ;
    schema:name "safety consideration" .

schema:salaryCurrency a rdf:Property ;
    schema:description "The currency (coded using [ISO 4217](http://en.wikipedia.org/wiki/ISO_4217) ) used for the main salary information in this job posting or for this employee." ;
    schema:name "salary currency" .

schema:salaryUponCompletion a rdf:Property ;
    schema:description "The expected salary upon completing the training." ;
    schema:name "salary upon completion" .

schema:sameAs a rdf:Property ;
    schema:description "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website." ;
    schema:name "same as" .

schema:sampleType a rdf:Property ;
    schema:description "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." ;
    schema:name "sample type" .

schema:saturatedFatContent a rdf:Property ;
    schema:description "The number of grams of saturated fat." ;
    schema:name "saturated fat content" .

schema:scheduleTimezone a rdf:Property ;
    schema:description "Indicates the timezone for which the time(s) indicated in the [[Schedule]] are given. The value provided should be among those listed in the IANA Time Zone Database." ;
    schema:name "schedule timezone" .

schema:scheduledPaymentDate a rdf:Property ;
    schema:description "The date the invoice is scheduled to be paid." ;
    schema:name "scheduled payment date" .

schema:scheduledTime a rdf:Property ;
    schema:description "The time the object is scheduled to." ;
    schema:name "scheduled time" .

schema:schemaVersion a rdf:Property ;
    schema:description """Indicates (by URL or string) a particular version of a schema used in some CreativeWork. This property was created primarily to
    indicate the use of a specific schema.org release, e.g. ```10.0``` as a simple string, or more explicitly via URL, ```https://schema.org/docs/releases.html#v10.0```. There may be situations in which other schemas might usefully be referenced this way, e.g. ```http://dublincore.org/specifications/dublin-core/dces/1999-07-02/``` but this has not been carefully explored in the community.""" ;
    schema:name "schema version" .

schema:schoolClosuresInfo a rdf:Property ;
    schema:description "Information about school closures." ;
    schema:name "school closures info" .

schema:screenCount a rdf:Property ;
    schema:description "The number of screens in the movie theater." ;
    schema:name "screen count" .

schema:screenshot a rdf:Property ;
    schema:description "A link to a screenshot image of the app." ;
    schema:name "screenshot" .

schema:sdDatePublished a rdf:Property ;
    schema:description "Indicates the date on which the current structured data was generated / published. Typically used alongside [[sdPublisher]]" ;
    schema:name "sd date published" .

schema:sdLicense a rdf:Property ;
    schema:description "A license document that applies to this structured data, typically indicated by URL." ;
    schema:name "sd license" .

schema:sdPublisher a rdf:Property ;
    schema:description """Indicates the party responsible for generating and publishing the current structured data markup, typically in cases where the structured data is derived automatically from existing published content but published on a different site. For example, student projects and open data initiatives often re-publish existing content with more explicitly structured metadata. The
[[sdPublisher]] property helps make such practices more explicit.""" ;
    schema:name "sd publisher" .

schema:season a rdf:Property ;
    schema:description "A season in a media series." ;
    schema:name "season" .

schema:seasonNumber a rdf:Property ;
    schema:description "Position of the season within an ordered group of seasons." ;
    schema:name "season number" .

schema:seasons a rdf:Property ;
    schema:description "A season in a media series." ;
    schema:name "seasons" .

schema:seatNumber a rdf:Property ;
    schema:description "The location of the reserved seat (e.g., 27)." ;
    schema:name "seat number" .

schema:seatRow a rdf:Property ;
    schema:description "The row location of the reserved seat (e.g., B)." ;
    schema:name "seat row" .

schema:seatSection a rdf:Property ;
    schema:description "The section location of the reserved seat (e.g. Orchestra)." ;
    schema:name "seat section" .

schema:seatingCapacity a rdf:Property ;
    schema:description "The number of persons that can be seated (e.g. in a vehicle), both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons " ;
    schema:name "seating capacity" .

schema:seatingType a rdf:Property ;
    schema:description "The type/class of the seat." ;
    schema:name "seating type" .

schema:secondaryPrevention a rdf:Property ;
    schema:description "A preventative therapy used to prevent reoccurrence of the medical condition after an initial episode of the condition." ;
    schema:name "secondary prevention" .

schema:securityClearanceRequirement a rdf:Property ;
    schema:description "A description of any security clearance requirements of the job." ;
    schema:name "security clearance requirement" .

schema:securityScreening a rdf:Property ;
    schema:description "The type of security screening the passenger is subject to." ;
    schema:name "security screening" .

schema:seeks a rdf:Property ;
    schema:description "A pointer to products or services sought by the organization or person (demand)." ;
    schema:name "seeks" .

schema:seller a rdf:Property ;
    schema:description "An entity which offers (sells / leases / lends / loans) the services / goods.  A seller may also be a provider." ;
    schema:name "seller" .

schema:sender a rdf:Property ;
    schema:description "A sub property of participant. The participant who is at the sending end of the action." ;
    schema:name "sender" .

schema:sensoryRequirement a rdf:Property ;
    schema:description "A description of any sensory requirements and levels necessary to function on the job, including hearing and vision. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." ;
    schema:name "sensory requirement" .

schema:sensoryUnit a rdf:Property ;
    schema:description "The neurological pathway extension that inputs and sends information to the brain or spinal cord." ;
    schema:name "sensory unit" .

schema:serialNumber a rdf:Property ;
    schema:description "The serial number or any alphanumeric identifier of a particular product. When attached to an offer, it is a shortcut for the serial number of the product included in the offer." ;
    schema:name "serial number" .

schema:seriousAdverseOutcome a rdf:Property ;
    schema:description "A possible serious complication and/or serious side effect of this therapy. Serious adverse outcomes include those that are life-threatening; result in death, disability, or permanent damage; require hospitalization or prolong existing hospitalization; cause congenital anomalies or birth defects; or jeopardize the patient and may require medical or surgical intervention to prevent one of the outcomes in this definition." ;
    schema:name "serious adverse outcome" .

schema:serverStatus a rdf:Property ;
    schema:description "Status of a game server." ;
    schema:name "server status" .

schema:servesCuisine a rdf:Property ;
    schema:description "The cuisine of the restaurant." ;
    schema:name "serves cuisine" .

schema:serviceArea a rdf:Property ;
    schema:description "The geographic area where the service is provided." ;
    schema:name "service area" .

schema:serviceAudience a rdf:Property ;
    schema:description "The audience eligible for this service." ;
    schema:name "service audience" .

schema:serviceLocation a rdf:Property ;
    schema:description "The location (e.g. civic structure, local business, etc.) where a person can go to access the service." ;
    schema:name "service location" .

schema:serviceOperator a rdf:Property ;
    schema:description "The operating organization, if different from the provider.  This enables the representation of services that are provided by an organization, but operated by another organization like a subcontractor." ;
    schema:name "service operator" .

schema:serviceOutput a rdf:Property ;
    schema:description "The tangible thing generated by the service, e.g. a passport, permit, etc." ;
    schema:name "service output" .

schema:servicePhone a rdf:Property ;
    schema:description "The phone number to use to access the service." ;
    schema:name "service phone" .

schema:servicePostalAddress a rdf:Property ;
    schema:description "The address for accessing the service by mail." ;
    schema:name "service postal address" .

schema:serviceSmsNumber a rdf:Property ;
    schema:description "The number to access the service by text message." ;
    schema:name "service sms number" .

schema:serviceType a rdf:Property ;
    schema:description "The type of service being offered, e.g. veterans' benefits, emergency relief, etc." ;
    schema:name "service type" .

schema:serviceUrl a rdf:Property ;
    schema:description "The website to access the service." ;
    schema:name "service url" .

schema:servingSize a rdf:Property ;
    schema:description "The serving size, in terms of the number of volume or mass." ;
    schema:name "serving size" .

schema:sha256 a rdf:Property ;
    schema:description "The [SHA-2](https://en.wikipedia.org/wiki/SHA-2) SHA256 hash of the content of the item. For example, a zero-length input has value 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'" ;
    schema:name "sha256" .

schema:sharedContent a rdf:Property ;
    schema:description "A CreativeWork such as an image, video, or audio clip shared as part of this posting." ;
    schema:name "shared content" .

schema:shippingDestination a rdf:Property ;
    schema:description "indicates (possibly multiple) shipping destinations. These can be defined in several ways e.g. postalCode ranges." ;
    schema:name "shipping destination" .

schema:shippingDetails a rdf:Property ;
    schema:description "Indicates information about the shipping policies and options associated with an [[Offer]]." ;
    schema:name "shipping details" .

schema:shippingLabel a rdf:Property ;
    schema:description "Label to match an [[OfferShippingDetails]] with a [[ShippingRateSettings]] (within the context of a [[shippingSettingsLink]] cross-reference)." ;
    schema:name "shipping label" .

schema:shippingRate a rdf:Property ;
    schema:description "The shipping rate is the cost of shipping to the specified destination. Typically, the maxValue and currency values (of the [[MonetaryAmount]]) are most appropriate." ;
    schema:name "shipping rate" .

schema:shippingSettingsLink a rdf:Property ;
    schema:description "Link to a page containing [[ShippingRateSettings]] and [[DeliveryTimeSettings]] details." ;
    schema:name "shipping settings link" .

schema:sibling a rdf:Property ;
    schema:description "A sibling of the person." ;
    schema:name "sibling" .

schema:siblings a rdf:Property ;
    schema:description "A sibling of the person." ;
    schema:name "siblings" .

schema:signDetected a rdf:Property ;
    schema:description "A sign detected by the test." ;
    schema:name "sign detected" .

schema:signOrSymptom a rdf:Property ;
    schema:description "A sign or symptom of this condition. Signs are objective or physically observable manifestations of the medical condition while symptoms are the subjective experience of the medical condition." ;
    schema:name "sign or symptom" .

schema:significance a rdf:Property ;
    schema:description "The significance associated with the superficial anatomy; as an example, how characteristics of the superficial anatomy can suggest underlying medical conditions or courses of treatment." ;
    schema:name "significance" .

schema:significantLink a rdf:Property ;
    schema:description "One of the more significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." ;
    schema:name "significant link" .

schema:significantLinks a rdf:Property ;
    schema:description "The most significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." ;
    schema:name "significant links" .

schema:size a rdf:Property ;
    schema:description "A standardized size of a product or creative work, specified either through a simple textual string (for example 'XL', '32Wx34L'), a  QuantitativeValue with a unitCode, or a comprehensive and structured [[SizeSpecification]]; in other cases, the [[width]], [[height]], [[depth]] and [[weight]] properties may be more applicable. " ;
    schema:name "size" .

schema:sizeGroup a rdf:Property ;
    schema:description "The size group (also known as \"size type\") for a product's size. Size groups are common in the fashion industry to define size segments and suggested audiences for wearable products. Multiple values can be combined, for example \"men's big and tall\", \"petite maternity\" or \"regular\"" ;
    schema:name "size group" .

schema:sizeSystem a rdf:Property ;
    schema:description "The size system used to identify a product's size. Typically either a standard (for example, \"GS1\" or \"ISO-EN13402\"), country code (for example \"US\" or \"JP\"), or a measuring system (for example \"Metric\" or \"Imperial\")." ;
    schema:name "size system" .

schema:skills a rdf:Property ;
    schema:description "A statement of knowledge, skill, ability, task or any other assertion expressing a competency that is desired or required to fulfill this role or to work in this occupation." ;
    schema:name "skills" .

schema:sku a rdf:Property ;
    schema:description "The Stock Keeping Unit (SKU), i.e. a merchant-specific identifier for a product or service, or the product to which the offer refers." ;
    schema:name "sku" .

schema:slogan a rdf:Property ;
    schema:description "A slogan or motto associated with the item." ;
    schema:name "slogan" .

schema:smiles a rdf:Property ;
    schema:description "A specification in form of a line notation for describing the structure of chemical species using short ASCII strings.  Double bond stereochemistry \\ indicators may need to be escaped in the string in formats where the backslash is an escape character." ;
    schema:name "smiles" .

schema:smokingAllowed a rdf:Property ;
    schema:description "Indicates whether it is allowed to smoke in the place, e.g. in the restaurant, hotel or hotel room." ;
    schema:name "smoking allowed" .

schema:sodiumContent a rdf:Property ;
    schema:description "The number of milligrams of sodium." ;
    schema:name "sodium content" .

schema:softwareAddOn a rdf:Property ;
    schema:description "Additional content for a software application." ;
    schema:name "software add on" .

schema:softwareHelp a rdf:Property ;
    schema:description "Software application help." ;
    schema:name "software help" .

schema:softwareRequirements a rdf:Property ;
    schema:description "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (Examples: DirectX, Java or .NET runtime)." ;
    schema:name "software requirements" .

schema:softwareVersion a rdf:Property ;
    schema:description "Version of the software instance." ;
    schema:name "software version" .

schema:sourceOrganization a rdf:Property ;
    schema:description "The Organization on whose behalf the creator was working." ;
    schema:name "source organization" .

schema:sourcedFrom a rdf:Property ;
    schema:description "The neurological pathway that originates the neurons." ;
    schema:name "sourced from" .

schema:spatial a rdf:Property ;
    schema:description """The "spatial" property can be used in cases when more specific properties
(e.g. [[locationCreated]], [[spatialCoverage]], [[contentLocation]]) are not known to be appropriate.""" ;
    schema:name "spatial" .

schema:spatialCoverage a rdf:Property ;
    schema:description """The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content. It is a subproperty of
      contentLocation intended primarily for more technical and detailed materials. For example with a Dataset, it indicates
      areas that the dataset describes: a dataset of New York weather would have spatialCoverage which was the place: the state of New York.""" ;
    schema:name "spatial coverage" .

schema:speakable a rdf:Property ;
    schema:description """Indicates sections of a Web page that are particularly 'speakable' in the sense of being highlighted as being especially appropriate for text-to-speech conversion. Other sections of a page may also be usefully spoken in particular circumstances; the 'speakable' property serves to indicate the parts most likely to be generally useful for speech.

The *speakable* property can be repeated an arbitrary number of times, with three kinds of possible 'content-locator' values:

1.) *id-value* URL references - uses *id-value* of an element in the page being annotated. The simplest use of *speakable* has (potentially relative) URL values, referencing identified sections of the document concerned.

2.) CSS Selectors - addresses content in the annotated page, eg. via class attribute. Use the [[cssSelector]] property.

3.)  XPaths - addresses content via XPaths (assuming an XML view of the content). Use the [[xpath]] property.


For more sophisticated markup of speakable sections beyond simple ID references, either CSS selectors or XPath expressions to pick out document section(s) as speakable. For this
we define a supporting type, [[SpeakableSpecification]]  which is defined to be a possible value of the *speakable* property.
         """ ;
    schema:name "speakable" .

schema:specialCommitments a rdf:Property ;
    schema:description "Any special commitments associated with this job posting. Valid entries include VeteranCommit, MilitarySpouseCommit, etc." ;
    schema:name "special commitments" .

schema:specialOpeningHoursSpecification a rdf:Property ;
    schema:description """The special opening hours of a certain place.\\n\\nUse this to explicitly override general opening hours brought in scope by [[openingHoursSpecification]] or [[openingHours]].
      """ ;
    schema:name "special opening hours specification" .

schema:specialty a rdf:Property ;
    schema:description "One of the domain specialities to which this web page's content applies." ;
    schema:name "specialty" .

schema:speechToTextMarkup a rdf:Property ;
    schema:description "Form of markup used. eg. [SSML](https://www.w3.org/TR/speech-synthesis11) or [IPA](https://www.wikidata.org/wiki/Property:P898)." ;
    schema:name "speech to text markup" .

schema:speed a rdf:Property ;
    schema:description "The speed range of the vehicle. If the vehicle is powered by an engine, the upper limit of the speed range (indicated by [[maxValue]] should be the maximum speed achievable under regular conditions.\\n\\nTypical unit code(s): KMH for km/h, HM for mile per hour (0.447 04 m/s), KNT for knot\\n\\n*Note 1: Use [[minValue]] and [[maxValue]] to indicate the range. Typically, the minimal value is zero.\\n* Note 2: There are many different ways of measuring the speed range. You can link to information about how the given value has been determined using the [[valueReference]] property." ;
    schema:name "speed" .

schema:spokenByCharacter a rdf:Property ;
    schema:description "The (e.g. fictional) character, Person or Organization to whom the quotation is attributed within the containing CreativeWork." ;
    schema:name "spoken by character" .

schema:sponsor a rdf:Property ;
    schema:description "A person or organization that supports a thing through a pledge, promise, or financial contribution. e.g. a sponsor of a Medical Study or a corporate sponsor of an event." ;
    schema:name "sponsor" .

schema:sport a rdf:Property ;
    schema:description "A type of sport (e.g. Baseball)." ;
    schema:name "sport" .

schema:sportsActivityLocation a rdf:Property ;
    schema:description "A sub property of location. The sports activity location where this action occurred." ;
    schema:name "sports activity location" .

schema:sportsEvent a rdf:Property ;
    schema:description "A sub property of location. The sports event where this action occurred." ;
    schema:name "sports event" .

schema:sportsTeam a rdf:Property ;
    schema:description "A sub property of participant. The sports team that participated on this action." ;
    schema:name "sports team" .

schema:spouse a rdf:Property ;
    schema:description "The person's spouse." ;
    schema:name "spouse" .

schema:stage a rdf:Property ;
    schema:description "The stage of the condition, if applicable." ;
    schema:name "stage" .

schema:stageAsNumber a rdf:Property ;
    schema:description "The stage represented as a number, e.g. 3." ;
    schema:name "stage as number" .

schema:starRating a rdf:Property ;
    schema:description "An official rating for a lodging business or food establishment, e.g. from national associations or standards bodies. Use the author property to indicate the rating organization, e.g. as an Organization with name such as (e.g. HOTREC, DEHOGA, WHR, or Hotelstars)." ;
    schema:name "star rating" .

schema:startDate a rdf:Property ;
    schema:description "The start date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." ;
    schema:name "start date" .

schema:startOffset a rdf:Property ;
    schema:description "The start time of the clip expressed as the number of seconds from the beginning of the work." ;
    schema:name "start offset" .

schema:startTime a rdf:Property ;
    schema:description "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. e.g. John wrote a book from *January* to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." ;
    schema:name "start time" .

schema:status a rdf:Property ;
    schema:description "The status of the study (enumerated)." ;
    schema:name "status" .

schema:steeringPosition a rdf:Property ;
    schema:description "The position of the steering wheel or similar device (mostly for cars)." ;
    schema:name "steering position" .

schema:step a rdf:Property ;
    schema:description "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection." ;
    schema:name "step" .

schema:stepValue a rdf:Property ;
    schema:description "The stepValue attribute indicates the granularity that is expected (and required) of the value in a PropertyValueSpecification." ;
    schema:name "step value" .

schema:steps a rdf:Property ;
    schema:description "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection (originally misnamed 'steps'; 'step' is preferred)." ;
    schema:name "steps" .

schema:storageRequirements a rdf:Property ;
    schema:description "Storage requirements (free space required)." ;
    schema:name "storage requirements" .

schema:streetAddress a rdf:Property ;
    schema:description "The street address. For example, 1600 Amphitheatre Pkwy." ;
    schema:name "street address" .

schema:strengthUnit a rdf:Property ;
    schema:description "The units of an active ingredient's strength, e.g. mg." ;
    schema:name "strength unit" .

schema:strengthValue a rdf:Property ;
    schema:description "The value of an active ingredient's strength, e.g. 325." ;
    schema:name "strength value" .

schema:structuralClass a rdf:Property ;
    schema:description "The name given to how bone physically connects to each other." ;
    schema:name "structural class" .

schema:study a rdf:Property ;
    schema:description "A medical study or trial related to this entity." ;
    schema:name "study" .

schema:studyDesign a rdf:Property ;
    schema:description "Specifics about the observational study design (enumerated)." ;
    schema:name "study design" .

schema:studyLocation a rdf:Property ;
    schema:description "The location in which the study is taking/took place." ;
    schema:name "study location" .

schema:studySubject a rdf:Property ;
    schema:description "A subject of the study, i.e. one of the medical conditions, therapies, devices, drugs, etc. investigated by the study." ;
    schema:name "study subject" .

schema:subEvent a rdf:Property ;
    schema:description "An Event that is part of this event. For example, a conference event includes many presentations, each of which is a subEvent of the conference." ;
    schema:name "sub event" .

schema:subEvents a rdf:Property ;
    schema:description "Events that are a part of this event. For example, a conference event includes many presentations, each subEvents of the conference." ;
    schema:name "sub events" .

schema:subOrganization a rdf:Property ;
    schema:description "A relationship between two organizations where the first includes the second, e.g., as a subsidiary. See also: the more specific 'department' property." ;
    schema:name "sub organization" .

schema:subReservation a rdf:Property ;
    schema:description "The individual reservations included in the package. Typically a repeated property." ;
    schema:name "sub reservation" .

schema:subStageSuffix a rdf:Property ;
    schema:description "The substage, e.g. 'a' for Stage IIIa." ;
    schema:name "sub stage suffix" .

schema:subStructure a rdf:Property ;
    schema:description "Component (sub-)structure(s) that comprise this anatomical structure." ;
    schema:name "sub structure" .

schema:subTest a rdf:Property ;
    schema:description "A component test of the panel." ;
    schema:name "sub test" .

schema:subTrip a rdf:Property ;
    schema:description "Identifies a [[Trip]] that is a subTrip of this Trip.  For example Day 1, Day 2, etc. of a multi-day trip." ;
    schema:name "sub trip" .

schema:subjectOf a rdf:Property ;
    schema:description "A CreativeWork or Event about this Thing." ;
    schema:name "subject of" .

schema:subtitleLanguage a rdf:Property ;
    schema:description "Languages in which subtitles/captions are available, in [IETF BCP 47 standard format](http://tools.ietf.org/html/bcp47)." ;
    schema:name "subtitle language" .

schema:successorOf a rdf:Property ;
    schema:description "A pointer from a newer variant of a product  to its previous, often discontinued predecessor." ;
    schema:name "successor of" .

schema:sugarContent a rdf:Property ;
    schema:description "The number of grams of sugar." ;
    schema:name "sugar content" .

schema:suggestedAge a rdf:Property ;
    schema:description "The age or age range for the intended audience or person, for example 3-12 months for infants, 1-5 years for toddlers." ;
    schema:name "suggested age" .

schema:suggestedAnswer a rdf:Property ;
    schema:description "An answer (possibly one of several, possibly incorrect) to a Question, e.g. on a Question/Answer site." ;
    schema:name "suggested answer" .

schema:suggestedGender a rdf:Property ;
    schema:description "The suggested gender of the intended person or audience, for example \"male\", \"female\", or \"unisex\"." ;
    schema:name "suggested gender" .

schema:suggestedMaxAge a rdf:Property ;
    schema:description "Maximum recommended age in years for the audience or user." ;
    schema:name "suggested max age" .

schema:suggestedMeasurement a rdf:Property ;
    schema:description "A suggested range of body measurements for the intended audience or person, for example inseam between 32 and 34 inches or height between 170 and 190 cm. Typically found on a size chart for wearable products." ;
    schema:name "suggested measurement" .

schema:suggestedMinAge a rdf:Property ;
    schema:description "Minimum recommended age in years for the audience or user." ;
    schema:name "suggested min age" .

schema:suitableForDiet a rdf:Property ;
    schema:description "Indicates a dietary restriction or guideline for which this recipe or menu item is suitable, e.g. diabetic, halal etc." ;
    schema:name "suitable for diet" .

schema:superEvent a rdf:Property ;
    schema:description "An event that this event is a part of. For example, a collection of individual music performances might each have a music festival as their superEvent." ;
    schema:name "super event" .

schema:supersededBy a rdf:Property ;
    schema:description "Relates a term (i.e. a property, class or enumeration) to one that supersedes it." ;
    schema:name "superseded by" .

schema:supply a rdf:Property ;
    schema:description "A sub-property of instrument. A supply consumed when performing instructions or a direction." ;
    schema:name "supply" .

schema:supplyTo a rdf:Property ;
    schema:description "The area to which the artery supplies blood." ;
    schema:name "supply to" .

schema:supportingData a rdf:Property ;
    schema:description "Supporting data for a SoftwareApplication." ;
    schema:name "supporting data" .

schema:surface a rdf:Property ;
    schema:description "A material used as a surface in some artwork, e.g. Canvas, Paper, Wood, Board, etc." ;
    schema:name "surface" .

schema:target a rdf:Property ;
    schema:description "Indicates a target EntryPoint for an Action." ;
    schema:name "target" .

schema:targetCollection a rdf:Property ;
    schema:description "A sub property of object. The collection target of the action." ;
    schema:name "target collection" .

schema:targetDescription a rdf:Property ;
    schema:description "The description of a node in an established educational framework." ;
    schema:name "target description" .

schema:targetName a rdf:Property ;
    schema:description "The name of a node in an established educational framework." ;
    schema:name "target name" .

schema:targetPlatform a rdf:Property ;
    schema:description "Type of app development: phone, Metro style, desktop, XBox, etc." ;
    schema:name "target platform" .

schema:targetPopulation a rdf:Property ;
    schema:description "Characteristics of the population for which this is intended, or which typically uses it, e.g. 'adults'." ;
    schema:name "target population" .

schema:targetProduct a rdf:Property ;
    schema:description "Target Operating System / Product to which the code applies.  If applies to several versions, just the product name can be used." ;
    schema:name "target product" .

schema:targetUrl a rdf:Property ;
    schema:description "The URL of a node in an established educational framework." ;
    schema:name "target url" .

schema:taxID a rdf:Property ;
    schema:description "The Tax / Fiscal ID of the organization or person, e.g. the TIN in the US or the CIF/NIF in Spain." ;
    schema:name "tax id" .

schema:taxonRank a rdf:Property ;
    schema:description "The taxonomic rank of this taxon given preferably as a URI from a controlled vocabulary – (typically the ranks from TDWG TaxonRank ontology or equivalent Wikidata URIs)." ;
    schema:name "taxon rank" .

schema:taxonomicRange a rdf:Property ;
    schema:description "The taxonomic grouping of the organism that expresses, encodes, or in someway related to the BioChemEntity." ;
    schema:name "taxonomic range" .

schema:teaches a rdf:Property ;
    schema:description "The item being described is intended to help a person learn the competency or learning outcome defined by the referenced term." ;
    schema:name "teaches" .

schema:telephone a rdf:Property ;
    schema:description "The telephone number." ;
    schema:name "telephone" .

schema:temporal a rdf:Property ;
    schema:description """The "temporal" property can be used in cases where more specific properties
(e.g. [[temporalCoverage]], [[dateCreated]], [[dateModified]], [[datePublished]]) are not known to be appropriate.""" ;
    schema:name "temporal" .

schema:temporalCoverage a rdf:Property ;
    schema:description """The temporalCoverage of a CreativeWork indicates the period that the content applies to, i.e. that it describes, either as a DateTime or as a textual string indicating a time period in [ISO 8601 time interval format](https://en.wikipedia.org/wiki/ISO_8601#Time_intervals). In
      the case of a Dataset it will typically indicate the relevant time period in a precise notation (e.g. for a 2011 census dataset, the year 2011 would be written "2011/2012"). Other forms of content e.g. ScholarlyArticle, Book, TVSeries or TVEpisode may indicate their temporalCoverage in broader terms - textually or via well-known URL.
      Written works such as books may sometimes have precise temporal coverage too, e.g. a work set in 1939 - 1945 can be indicated in ISO 8601 interval format format via "1939/1945".

Open-ended date ranges can be written with ".." in place of the end date. For example, "2015-11/.." indicates a range beginning in November 2015 and with no specified final date. This is tentative and might be updated in future when ISO 8601 is officially updated.""" ;
    schema:name "temporal coverage" .

schema:termCode a rdf:Property ;
    schema:description "A code that identifies this [[DefinedTerm]] within a [[DefinedTermSet]]" ;
    schema:name "term code" .

schema:termDuration a rdf:Property ;
    schema:description "The amount of time in a term as defined by the institution. A term is a length of time where students take one or more classes. Semesters and quarters are common units for term." ;
    schema:name "term duration" .

schema:termsOfService a rdf:Property ;
    schema:description "Human-readable terms of service documentation." ;
    schema:name "terms of service" .

schema:termsPerYear a rdf:Property ;
    schema:description "The number of times terms of study are offered per year. Semesters and quarters are common units for term. For example, if the student can only take 2 semesters for the program in one year, then termsPerYear should be 2." ;
    schema:name "terms per year" .

schema:text a rdf:Property ;
    schema:description "The textual content of this CreativeWork." ;
    schema:name "text" .

schema:textValue a rdf:Property ;
    schema:description "Text value being annotated." ;
    schema:name "text value" .

schema:thumbnail a rdf:Property ;
    schema:description "Thumbnail image for an image or video." ;
    schema:name "thumbnail" .

schema:thumbnailUrl a rdf:Property ;
    schema:description "A thumbnail image relevant to the Thing." ;
    schema:name "thumbnail url" .

schema:tickerSymbol a rdf:Property ;
    schema:description "The exchange traded instrument associated with a Corporation object. The tickerSymbol is expressed as an exchange and an instrument name separated by a space character. For the exchange component of the tickerSymbol attribute, we recommend using the controlled vocabulary of Market Identifier Codes (MIC) specified in ISO15022." ;
    schema:name "ticker symbol" .

schema:ticketNumber a rdf:Property ;
    schema:description "The unique identifier for the ticket." ;
    schema:name "ticket number" .

schema:ticketToken a rdf:Property ;
    schema:description "Reference to an asset (e.g., Barcode, QR code image or PDF) usable for entrance." ;
    schema:name "ticket token" .

schema:ticketedSeat a rdf:Property ;
    schema:description "The seat associated with the ticket." ;
    schema:name "ticketed seat" .

schema:timeOfDay a rdf:Property ;
    schema:description "The time of day the program normally runs. For example, \"evenings\"." ;
    schema:name "time of day" .

schema:timeRequired a rdf:Property ;
    schema:description "Approximate or typical time it takes to work with or through this learning resource for the typical intended target audience, e.g. 'PT30M', 'PT1H25M'." ;
    schema:name "time required" .

schema:timeToComplete a rdf:Property ;
    schema:description "The expected length of time to complete the program if attending full-time." ;
    schema:name "time to complete" .

schema:tissueSample a rdf:Property ;
    schema:description "The type of tissue sample required for the test." ;
    schema:name "tissue sample" .

schema:title a rdf:Property ;
    schema:description "The title of the job." ;
    schema:name "title" .

schema:titleEIDR a rdf:Property ;
    schema:description """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing at the most general/abstract level, a work of film or television.

For example, the motion picture known as "Ghostbusters" has a titleEIDR of  "10.5240/7EC7-228A-510A-053E-CBB8-J". This title (or work) may have several variants, which EIDR calls "edits". See [[editEIDR]].

Since schema.org types like [[Movie]] and [[TVEpisode]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" ;
    schema:name "title eidr" .

schema:toLocation a rdf:Property ;
    schema:description "A sub property of location. The final location of the object or the agent after the action." ;
    schema:name "to location" .

schema:toRecipient a rdf:Property ;
    schema:description "A sub property of recipient. The recipient who was directly sent the message." ;
    schema:name "to recipient" .

schema:tocContinuation a rdf:Property ;
    schema:description "A [[HyperTocEntry]] can have a [[tocContinuation]] indicated, which is another [[HyperTocEntry]] that would be the default next item to play or render." ;
    schema:name "toc continuation" .

schema:tocEntry a rdf:Property ;
    schema:description "Indicates a [[HyperTocEntry]] in a [[HyperToc]]." ;
    schema:name "toc entry" .

schema:tongueWeight a rdf:Property ;
    schema:description "The permitted vertical load (TWR) of a trailer attached to the vehicle. Also referred to as Tongue Load Rating (TLR) or Vertical Load Rating (VLR)\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "tongue weight" .

schema:tool a rdf:Property ;
    schema:description "A sub property of instrument. An object used (but not consumed) when performing instructions or a direction." ;
    schema:name "tool" .

schema:torque a rdf:Property ;
    schema:description "The torque (turning force) of the vehicle's engine.\\n\\nTypical unit code(s): NU for newton metre (N m), F17 for pound-force per foot, or F48 for pound-force per inch\\n\\n* Note 1: You can link to information about how the given value has been determined (e.g. reference RPM) using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "torque" .

schema:totalJobOpenings a rdf:Property ;
    schema:description "The number of positions open for this job posting. Use a positive integer. Do not use if the number of positions is unclear or not known." ;
    schema:name "total job openings" .

schema:totalPaymentDue a rdf:Property ;
    schema:description "The total amount due." ;
    schema:name "total payment due" .

schema:totalPrice a rdf:Property ;
    schema:description "The total price for the reservation or ticket, including applicable taxes, shipping, etc.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    schema:name "total price" .

schema:totalTime a rdf:Property ;
    schema:description "The total time required to perform instructions or a direction (including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    schema:name "total time" .

schema:tourBookingPage a rdf:Property ;
    schema:description "A page providing information on how to book a tour of some [[Place]], such as an [[Accommodation]] or [[ApartmentComplex]] in a real estate setting, as well as other kinds of tours as appropriate." ;
    schema:name "tour booking page" .

schema:touristType a rdf:Property ;
    schema:description "Attraction suitable for type(s) of tourist. eg. Children, visitors from a particular country, etc. " ;
    schema:name "tourist type" .

schema:track a rdf:Property ;
    schema:description "A music recording (track)&#x2014;usually a single song. If an ItemList is given, the list should contain items of type MusicRecording." ;
    schema:name "track" .

schema:trackingNumber a rdf:Property ;
    schema:description "Shipper tracking number." ;
    schema:name "tracking number" .

schema:trackingUrl a rdf:Property ;
    schema:description "Tracking url for the parcel delivery." ;
    schema:name "tracking url" .

schema:tracks a rdf:Property ;
    schema:description "A music recording (track)&#x2014;usually a single song." ;
    schema:name "tracks" .

schema:trailer a rdf:Property ;
    schema:description "The trailer of a movie or tv/radio series, season, episode, etc." ;
    schema:name "trailer" .

schema:trailerWeight a rdf:Property ;
    schema:description "The permitted weight of a trailer attached to the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "trailer weight" .

schema:trainName a rdf:Property ;
    schema:description "The name of the train (e.g. The Orient Express)." ;
    schema:name "train name" .

schema:trainNumber a rdf:Property ;
    schema:description "The unique identifier for the train." ;
    schema:name "train number" .

schema:trainingSalary a rdf:Property ;
    schema:description "The estimated salary earned while in the program." ;
    schema:name "training salary" .

schema:transFatContent a rdf:Property ;
    schema:description "The number of grams of trans fat." ;
    schema:name "trans fat content" .

schema:transcript a rdf:Property ;
    schema:description "If this MediaObject is an AudioObject or VideoObject, the transcript of that object." ;
    schema:name "transcript" .

schema:transitTime a rdf:Property ;
    schema:description "The typical delay the order has been sent for delivery and the goods reach the final customer. Typical properties: minValue, maxValue, unitCode (d for DAY)." ;
    schema:name "transit time" .

schema:transitTimeLabel a rdf:Property ;
    schema:description "Label to match an [[OfferShippingDetails]] with a [[DeliveryTimeSettings]] (within the context of a [[shippingSettingsLink]] cross-reference)." ;
    schema:name "transit time label" .

schema:translationOfWork a rdf:Property ;
    schema:description "The work that this work has been translated from. e.g. 物种起源 is a translationOf “On the Origin of Species”" ;
    schema:name "translation of work" .

schema:translator a rdf:Property ;
    schema:description "Organization or person who adapts a creative work to different languages, regional differences and technical requirements of a target market, or that translates during some event." ;
    schema:name "translator" .

schema:transmissionMethod a rdf:Property ;
    schema:description "How the disease spreads, either as a route or vector, for example 'direct contact', 'Aedes aegypti', etc." ;
    schema:name "transmission method" .

schema:travelBans a rdf:Property ;
    schema:description "Information about travel bans, e.g. in the context of a pandemic." ;
    schema:name "travel bans" .

schema:trialDesign a rdf:Property ;
    schema:description "Specifics about the trial design (enumerated)." ;
    schema:name "trial design" .

schema:tributary a rdf:Property ;
    schema:description "The anatomical or organ system that the vein flows into; a larger structure that the vein connects to." ;
    schema:name "tributary" .

schema:typeOfBed a rdf:Property ;
    schema:description "The type of bed to which the BedDetail refers, i.e. the type of bed available in the quantity indicated by quantity." ;
    schema:name "type of bed" .

schema:typeOfGood a rdf:Property ;
    schema:description "The product that this structured value is referring to." ;
    schema:name "type of good" .

schema:typicalAgeRange a rdf:Property ;
    schema:description "The typical expected age range, e.g. '7-9', '11-'." ;
    schema:name "typical age range" .

schema:typicalCreditsPerTerm a rdf:Property ;
    schema:description "The number of credits or units a full-time student would be expected to take in 1 term however 'term' is defined by the institution." ;
    schema:name "typical credits per term" .

schema:typicalTest a rdf:Property ;
    schema:description "A medical test typically performed given this condition." ;
    schema:name "typical test" .

schema:underName a rdf:Property ;
    schema:description "The person or organization the reservation or ticket is for." ;
    schema:name "under name" .

schema:unitCode a rdf:Property ;
    schema:description "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL. Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon." ;
    schema:name "unit code" .

schema:unitText a rdf:Property ;
    schema:description """A string or text indicating the unit of measurement. Useful if you cannot provide a standard unit code for
<a href='unitCode'>unitCode</a>.""" ;
    schema:name "unit text" .

schema:unnamedSourcesPolicy a rdf:Property ;
    schema:description "For an [[Organization]] (typically a [[NewsMediaOrganization]]), a statement about policy on use of unnamed sources and the decision process required." ;
    schema:name "unnamed sources policy" .

schema:unsaturatedFatContent a rdf:Property ;
    schema:description "The number of grams of unsaturated fat." ;
    schema:name "unsaturated fat content" .

schema:uploadDate a rdf:Property ;
    schema:description "Date when this media object was uploaded to this site." ;
    schema:name "upload date" .

schema:upvoteCount a rdf:Property ;
    schema:description "The number of upvotes this question, answer or comment has received from the community." ;
    schema:name "upvote count" .

schema:url a rdf:Property ;
    schema:description "URL of the item." ;
    schema:name "url" .

schema:urlTemplate a rdf:Property ;
    schema:description "An url template (RFC6570) that will be used to construct the target of the execution of the action." ;
    schema:name "url template" .

schema:usageInfo a rdf:Property ;
    schema:description """The schema.org [[usageInfo]] property indicates further information about a [[CreativeWork]]. This property is applicable both to works that are freely available and to those that require payment or other transactions. It can reference additional information e.g. community expectations on preferred linking and citation conventions, as well as purchasing details. For something that can be commercially licensed, usageInfo can provide detailed, resource-specific information about licensing options.

This property can be used alongside the license property which indicates license(s) applicable to some piece of content. The usageInfo property can provide information about other licensing options, e.g. acquiring commercial usage rights for an image that is also available under non-commercial creative commons licenses.""" ;
    schema:name "usage info" .

schema:usedToDiagnose a rdf:Property ;
    schema:description "A condition the test is used to diagnose." ;
    schema:name "used to diagnose" .

schema:userInteractionCount a rdf:Property ;
    schema:description "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication." ;
    schema:name "user interaction count" .

schema:usesDevice a rdf:Property ;
    schema:description "Device used to perform the test." ;
    schema:name "uses device" .

schema:usesHealthPlanIdStandard a rdf:Property ;
    schema:description "The standard for interpreting thePlan ID. The preferred is \"HIOS\". See the Centers for Medicare & Medicaid Services for more details." ;
    schema:name "uses health plan id standard" .

schema:utterances a rdf:Property ;
    schema:description "Text of an utterances (spoken words, lyrics etc.) that occurs at a certain section of a media object, represented as a [[HyperTocEntry]]." ;
    schema:name "utterances" .

schema:validFor a rdf:Property ;
    schema:description "The duration of validity of a permit or similar thing." ;
    schema:name "valid for" .

schema:validFrom a rdf:Property ;
    schema:description "The date when the item becomes valid." ;
    schema:name "valid from" .

schema:validIn a rdf:Property ;
    schema:description "The geographic area where a permit or similar thing is valid." ;
    schema:name "valid in" .

schema:validThrough a rdf:Property ;
    schema:description "The date after when the item is not valid. For example the end of an offer, salary period, or a period of opening hours." ;
    schema:name "valid through" .

schema:validUntil a rdf:Property ;
    schema:description "The date when the item is no longer valid." ;
    schema:name "valid until" .

schema:value a rdf:Property ;
    schema:description "The value of the quantitative value or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text;', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    schema:name "value" .

schema:valueAddedTaxIncluded a rdf:Property ;
    schema:description "Specifies whether the applicable value-added tax (VAT) is included in the price specification or not." ;
    schema:name "value added tax included" .

schema:valueMaxLength a rdf:Property ;
    schema:description "Specifies the allowed range for number of characters in a literal value." ;
    schema:name "value max length" .

schema:valueMinLength a rdf:Property ;
    schema:description "Specifies the minimum allowed range for number of characters in a literal value." ;
    schema:name "value min length" .

schema:valueName a rdf:Property ;
    schema:description "Indicates the name of the PropertyValueSpecification to be used in URL templates and form encoding in a manner analogous to HTML's input@name." ;
    schema:name "value name" .

schema:valuePattern a rdf:Property ;
    schema:description "Specifies a regular expression for testing literal values according to the HTML spec." ;
    schema:name "value pattern" .

schema:valueReference a rdf:Property ;
    schema:description "A secondary value that provides additional information on the original value, e.g. a reference temperature or a type of measurement." ;
    schema:name "value reference" .

schema:valueRequired a rdf:Property ;
    schema:description "Whether the property must be filled in to complete the action.  Default is false." ;
    schema:name "value required" .

schema:variableMeasured a rdf:Property ;
    schema:description "The variableMeasured property can indicate (repeated as necessary) the  variables that are measured in some dataset, either described as text or as pairs of identifier and description using PropertyValue." ;
    schema:name "variable measured" .

schema:variantCover a rdf:Property ;
    schema:description """A description of the variant cover
    	for the issue, if the issue is a variant printing. For example, "Bryan Hitch
    	Variant Cover" or "2nd Printing Variant".""" ;
    schema:name "variant cover" .

schema:variesBy a rdf:Property ;
    schema:description "Indicates the property or properties by which the variants in a [[ProductGroup]] vary, e.g. their size, color etc. Schema.org properties can be referenced by their short name e.g. \"color\"; terms defined elsewhere can be referenced with their URIs." ;
    schema:name "varies by" .

schema:vatID a rdf:Property ;
    schema:description "The Value-added Tax ID of the organization or person." ;
    schema:name "vat id" .

schema:vehicleConfiguration a rdf:Property ;
    schema:description "A short text indicating the configuration of the vehicle, e.g. '5dr hatchback ST 2.5 MT 225 hp' or 'limited edition'." ;
    schema:name "vehicle configuration" .

schema:vehicleEngine a rdf:Property ;
    schema:description "Information about the engine or engines of the vehicle." ;
    schema:name "vehicle engine" .

schema:vehicleIdentificationNumber a rdf:Property ;
    schema:description "The Vehicle Identification Number (VIN) is a unique serial number used by the automotive industry to identify individual motor vehicles." ;
    schema:name "vehicle identification number" .

schema:vehicleInteriorColor a rdf:Property ;
    schema:description "The color or color combination of the interior of the vehicle." ;
    schema:name "vehicle interior color" .

schema:vehicleInteriorType a rdf:Property ;
    schema:description "The type or material of the interior of the vehicle (e.g. synthetic fabric, leather, wood, etc.). While most interior types are characterized by the material used, an interior type can also be based on vehicle usage or target audience." ;
    schema:name "vehicle interior type" .

schema:vehicleModelDate a rdf:Property ;
    schema:description "The release date of a vehicle model (often used to differentiate versions of the same make and model)." ;
    schema:name "vehicle model date" .

schema:vehicleSeatingCapacity a rdf:Property ;
    schema:description "The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons." ;
    schema:name "vehicle seating capacity" .

schema:vehicleSpecialUsage a rdf:Property ;
    schema:description "Indicates whether the vehicle has been used for special purposes, like commercial rental, driving school, or as a taxi. The legislation in many countries requires this information to be revealed when offering a car for sale." ;
    schema:name "vehicle special usage" .

schema:vehicleTransmission a rdf:Property ;
    schema:description "The type of component used for transmitting the power from a rotating power source to the wheels or other relevant component(s) (\"gearbox\" for cars)." ;
    schema:name "vehicle transmission" .

schema:vendor a rdf:Property ;
    schema:description "'vendor' is an earlier term for 'seller'." ;
    schema:name "vendor" .

schema:verificationFactCheckingPolicy a rdf:Property ;
    schema:description "Disclosure about verification and fact-checking processes for a [[NewsMediaOrganization]] or other fact-checking [[Organization]]." ;
    schema:name "verification fact checking policy" .

schema:version a rdf:Property ;
    schema:description "The version of the CreativeWork embodied by a specified resource." ;
    schema:name "version" .

schema:video a rdf:Property ;
    schema:description "An embedded video object." ;
    schema:name "video" .

schema:videoFormat a rdf:Property ;
    schema:description "The type of screening or video broadcast used (e.g. IMAX, 3D, SD, HD, etc.)." ;
    schema:name "video format" .

schema:videoFrameSize a rdf:Property ;
    schema:description "The frame size of the video." ;
    schema:name "video frame size" .

schema:videoQuality a rdf:Property ;
    schema:description "The quality of the video." ;
    schema:name "video quality" .

schema:volumeNumber a rdf:Property ;
    schema:description "Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\"." ;
    schema:name "volume number" .

schema:warning a rdf:Property ;
    schema:description "Any FDA or other warnings about the drug (text or URL)." ;
    schema:name "warning" .

schema:warranty a rdf:Property ;
    schema:description "The warranty promise(s) included in the offer." ;
    schema:name "warranty" .

schema:warrantyPromise a rdf:Property ;
    schema:description "The warranty promise(s) included in the offer." ;
    schema:name "warranty promise" .

schema:warrantyScope a rdf:Property ;
    schema:description "The scope of the warranty promise." ;
    schema:name "warranty scope" .

schema:webCheckinTime a rdf:Property ;
    schema:description "The time when a passenger can check into the flight online." ;
    schema:name "web checkin time" .

schema:webFeed a rdf:Property ;
    schema:description "The URL for a feed, e.g. associated with a podcast series, blog, or series of date-stamped updates. This is usually RSS or Atom." ;
    schema:name "web feed" .

schema:weight a rdf:Property ;
    schema:description "The weight of the product or person." ;
    schema:name "weight" .

schema:weightTotal a rdf:Property ;
    schema:description "The permitted total weight of the loaded vehicle, including passengers and cargo and the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    schema:name "weight total" .

schema:wheelbase a rdf:Property ;
    schema:description "The distance between the centers of the front and rear wheels.\\n\\nTypical unit code(s): CMT for centimeters, MTR for meters, INH for inches, FOT for foot/feet" ;
    schema:name "wheelbase" .

schema:width a rdf:Property ;
    schema:description "The width of the item." ;
    schema:name "width" .

schema:winner a rdf:Property ;
    schema:description "A sub property of participant. The winner of the action." ;
    schema:name "winner" .

schema:wordCount a rdf:Property ;
    schema:description "The number of words in the text of the Article." ;
    schema:name "word count" .

schema:workExample a rdf:Property ;
    schema:description "Example/instance/realization/derivation of the concept of this creative work. eg. The paperback edition, first edition, or eBook." ;
    schema:name "work example" .

schema:workFeatured a rdf:Property ;
    schema:description """A work featured in some event, e.g. exhibited in an ExhibitionEvent.
       Specific subproperties are available for workPerformed (e.g. a play), or a workPresented (a Movie at a ScreeningEvent).""" ;
    schema:name "work featured" .

schema:workHours a rdf:Property ;
    schema:description "The typical working hours for this job (e.g. 1st shift, night shift, 8am-5pm)." ;
    schema:name "work hours" .

schema:workLocation a rdf:Property ;
    schema:description "A contact location for a person's place of work." ;
    schema:name "work location" .

schema:workPerformed a rdf:Property ;
    schema:description "A work performed in some event, for example a play performed in a TheaterEvent." ;
    schema:name "work performed" .

schema:workPresented a rdf:Property ;
    schema:description "The movie presented during this event." ;
    schema:name "work presented" .

schema:workTranslation a rdf:Property ;
    schema:description "A work that is a translation of the content of this work. e.g. 西遊記 has an English workTranslation “Journey to the West”,a German workTranslation “Monkeys Pilgerfahrt” and a Vietnamese  translation Tây du ký bình khảo." ;
    schema:name "work translation" .

schema:workload a rdf:Property ;
    schema:description "Quantitative measure of the physiologic output of the exercise; also referred to as energy expenditure." ;
    schema:name "workload" .

schema:worksFor a rdf:Property ;
    schema:description "Organizations that the person works for." ;
    schema:name "works for" .

schema:worstRating a rdf:Property ;
    schema:description "The lowest value allowed in this rating system. If worstRating is omitted, 1 is assumed." ;
    schema:name "worst rating" .

schema:xpath a rdf:Property ;
    schema:description "An XPath, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." ;
    schema:name "xpath" .

schema:yearBuilt a rdf:Property ;
    schema:description "The year an [[Accommodation]] was constructed. This corresponds to the [YearBuilt field in RESO](https://ddwiki.reso.org/display/DDW17/YearBuilt+Field). " ;
    schema:name "year built" .

schema:yearlyRevenue a rdf:Property ;
    schema:description "The size of the business in annual revenue." ;
    schema:name "yearly revenue" .

schema:yearsInOperation a rdf:Property ;
    schema:description "The age of the business." ;
    schema:name "years in operation" .

schema:yield a rdf:Property ;
    schema:description "The quantity that results by performing instructions. For example, a paper airplane, 10 personalized candles." ;
    schema:name "yield" .

