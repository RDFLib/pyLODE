@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

sh:AbstractResult a rdfs:Class ;
    schema:description "The base class of validation results, typically not instantiated directly."@en ;
    schema:name "Abstract Result"@en .

sh:ConstraintComponent a rdfs:Class ;
    schema:description "The class of constraint components."@en ;
    schema:name "Constraint Component"@en .

sh:DataGraph a rdfs:Class ;
    schema:description "The class of graphs that typically act in the role of a SHACL data graph."@en ;
    schema:name "Data Graph"@en .

sh:Function a rdfs:Class ;
    schema:description "The class of SHACL functions."@en ;
    schema:name "Function"@en .

sh:Graph a rdfs:Class ;
    schema:description "The class of graphs."@en ;
    schema:name "Graph"@en .

sh:ListParameterExpression a rdfs:Class ;
    schema:description "The base class of node expressions (instances) that take a list of parameters."@en ;
    schema:name "List Parameter Expression"@en .

sh:ListParameterExpressionFunction a rdfs:Class ;
    schema:description "The base class of node expression functions that take a list of parameters."@en ;
    schema:name "List Parameter Expression Function"@en .

sh:NamedParameterExpression a rdfs:Class ;
    schema:description "The base class of node expressions (instances) that take named parameters."@en ;
    schema:name "Named Parameter Expression"@en .

sh:NamedParameterExpressionFunction a rdfs:Class ;
    schema:description "The base class of node expression functions that take named parameters."@en ;
    schema:name "Named Parameter Expression Function"@en .

sh:NodeExpression a rdfs:Class ;
    schema:description "The base class of node expression (instances)."@en ;
    schema:name "Node Expression"@en .

sh:NodeExpressionFunction a rdfs:Class ;
    schema:description "The base (meta) class of node expression functions."@en ;
    schema:name "Node Expression Function"@en .

sh:NodeKind a rdfs:Class ;
    schema:description "The class of all node kinds, including sh:BlankNode, sh:IRI, sh:Literal or the combinations of these: sh:BlankNodeOrIRI, sh:BlankNodeOrLiteral, sh:IRIOrLiteral."@en ;
    schema:name "Node Kind"@en .

sh:NodeShape a rdfs:Class ;
    schema:description "A node shape is a shape that specifies constraints that need to be met with respect to focus nodes."@en ;
    schema:name "Node Shape"@en .

sh:Parameter a rdfs:Class ;
    schema:description "The class of parameter declarations, consisting of a path predicate and (possibly) information about allowed value type, cardinality and other characteristics."@en ;
    schema:name "Parameter"@en .

sh:Parameterizable a rdfs:Class ;
    schema:description "Superclass of components that can take parameters, especially functions and constraint components."@en ;
    schema:name "Parameterizable"@en .

sh:PrefixDeclaration a rdfs:Class ;
    schema:description "The class of prefix declarations, consisting of pairs of a prefix with a namespace."@en ;
    schema:name "Prefix Declaration"@en .

sh:PropertyGroup a rdfs:Class ;
    schema:description "Instances of this class represent groups of property shapes that belong together."@en ;
    schema:name "Property Group"@en .

sh:PropertyShape a rdfs:Class ;
    schema:description "A property shape is a shape that specifies constraints on the values of a focus node for a given property or path."@en ;
    schema:name "Property Shape"@en .

sh:ResultAnnotation a rdfs:Class ;
    schema:description "A class of result annotations, which define the rules to derive the values of a given annotation property as extra values for a validation result."@en ;
    schema:name "Result Annotation"@en .

sh:Rule a rdfs:Class ;
    schema:description "The class of SHACL rules. Never instantiated directly."@en ;
    schema:name "Rule"@en .

sh:SPARQLAskExecutable a rdfs:Class ;
    schema:description "The class of SPARQL executables that are based on an ASK query."@en ;
    schema:name "Sparql Ask Executable"@en .

sh:SPARQLAskValidator a rdfs:Class ;
    schema:description "The class of validators based on SPARQL ASK queries. The queries are evaluated for each value node and are supposed to return true if the given node conforms."@en ;
    schema:name "Sparql Ask Validator"@en .

sh:SPARQLConstraint a rdfs:Class ;
    schema:description "The class of constraints based on SPARQL SELECT queries."@en ;
    schema:name "Sparql Constraint"@en .

sh:SPARQLConstructExecutable a rdfs:Class ;
    schema:description "The class of SPARQL executables that are based on a CONSTRUCT query."@en ;
    schema:name "Sparql Construct Executable"@en .

sh:SPARQLDescribeExecutable a rdfs:Class ;
    schema:description "The class of SPARQL executables based on a SPARQL DESCRIBE."@en ;
    schema:name "Sparql Describe Executable"@en .

sh:SPARQLExecutable a rdfs:Class ;
    schema:description "The class of resources that encapsulate a SPARQL query."@en ;
    schema:name "Sparql Executable"@en .

sh:SPARQLFunction a rdfs:Class ;
    schema:description "A function backed by a SPARQL query - either ASK or SELECT."@en ;
    schema:name "Sparql Function"@en .

sh:SPARQLRule a rdfs:Class ;
    schema:description "The class of SHACL rules based on SPARQL CONSTRUCT queries."@en ;
    schema:name "Sparql Construct Rule"@en .

sh:SPARQLSelectExecutable a rdfs:Class ;
    schema:description "The class of SPARQL executables based on a SELECT query."@en ;
    schema:name "Sparql Select Executable"@en .

sh:SPARQLSelectValidator a rdfs:Class ;
    schema:description "The class of validators based on SPARQL SELECT queries. The queries are evaluated for each focus node and are supposed to produce bindings for all focus nodes that do not conform."@en ;
    schema:name "Sparql Select Validator"@en .

sh:SPARQLTarget a rdfs:Class ;
    schema:description "The class of targets that are based on SPARQL queries."@en ;
    schema:name "Sparql Target"@en .

sh:SPARQLTargetType a rdfs:Class ;
    schema:description "The (meta) class for parameterizable targets that are based on SPARQL queries."@en ;
    schema:name "Sparql Target Type"@en .

sh:SPARQLUpdateExecutable a rdfs:Class ;
    schema:description "The class of SPARQL executables based on a SPARQL UPDATE."@en ;
    schema:name "Sparql Update Executable"@en .

sh:Severity a rdfs:Class ;
    schema:description "The class of validation result severity levels, including violation and warning levels."@en ;
    schema:name "Severity"@en .

sh:Shape a rdfs:Class ;
    schema:description "A shape is a collection of constraints that may be targeted for certain nodes."@en ;
    schema:name "Shape"@en .

sh:ShapeClass a rdfs:Class ;
    schema:description "A shape class is a class that is also a node shape. sh:ShapeClass can be used as rdf:type instead of the combination of rdfs:Class and sh:NodeShape."@en ;
    schema:name "Shape Class"@en .

sh:ShapesGraph a rdfs:Class ;
    schema:description "The class of graphs that typically act in the role of a SHACL shapes graph."@en ;
    schema:name "Shapes Graph"@en .

sh:Target a rdfs:Class ;
    schema:description "The base class of targets such as those based on SPARQL queries."@en ;
    schema:name "Target"@en .

sh:TargetType a rdfs:Class ;
    schema:description "The (meta) class for parameterizable targets.	Instances of this are instantiated as values of the sh:target property."@en ;
    schema:name "Target Type"@en .

sh:TripleRule a rdfs:Class ;
    schema:description "A rule based on triple (subject, predicate, object) pattern."@en ;
    schema:name "Triple Rule"@en .

sh:ValidationReport a rdfs:Class ;
    schema:description "The class of SHACL validation reports."@en ;
    schema:name "Validation Report"@en .

sh:ValidationResult a rdfs:Class ;
    schema:description "The class of validation results."@en ;
    schema:name "Validation Result"@en .

sh:Validator a rdfs:Class ;
    schema:description "The class of validators, which provide instructions on how to process a constraint definition. This class serves as base class for the SPARQL-based validators and other possible implementations."@en ;
    schema:name "Validator"@en .

sh: a owl:Ontology ;
    schema:description "This vocabulary defines terms used in SHACL, the W3C Shapes Constraint Language."@en ;
    schema:name "W3C Shapes Constraint Language (SHACL) Vocabulary"@en .

sh:AndConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to test whether a value node conforms to all members of a provided list of shapes."@en ;
    schema:name "And constraint component"@en .

sh:AndConstraintComponent-and a sh:Parameter .

sh:BlankNode a sh:NodeKind ;
    schema:description "The node kind of all blank nodes."@en ;
    schema:name "Blank node"@en .

sh:BlankNodeOrIRI a sh:NodeKind ;
    schema:description "The node kind of all blank nodes or IRIs."@en ;
    schema:name "Blank node or IRI"@en .

sh:BlankNodeOrLiteral a sh:NodeKind ;
    schema:description "The node kind of all blank nodes or literals."@en ;
    schema:name "Blank node or literal"@en .

sh:ClassConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that each value node is an instance of a given type."@en ;
    schema:name "Class constraint component"@en .

sh:ClassConstraintComponent-class a sh:Parameter .

sh:ClosedConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to indicate that focus nodes must only have values for those properties that have been explicitly enumerated via sh:property/sh:path."@en ;
    schema:name "Closed constraint component"@en .

sh:ClosedConstraintComponent-closed a sh:Parameter .

sh:ClosedConstraintComponent-ignoredProperties a sh:Parameter .

sh:DatatypeConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the datatype of all value nodes."@en ;
    schema:name "Datatype constraint component"@en .

sh:DatatypeConstraintComponent-datatype a sh:Parameter .

sh:Debug a sh:Severity ;
    schema:description "The severity for a debug validation result."@en ;
    schema:name "Debug"@en .

sh:DisjointConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that the set of value nodes is disjoint with the the set of nodes that can be reached from the focus node via a given property path."@en ;
    schema:name "Disjoint constraint component"@en .

sh:DisjointConstraintComponent-disjoint a sh:Parameter .

sh:EqualsConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that the set of value nodes is equal to the set of nodes that can be reached from the focus node using a given property path."@en ;
    schema:name "Equals constraint component"@en .

sh:EqualsConstraintComponent-equals a sh:Parameter .

sh:ExpressionConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that a given node expression produces true for all value nodes."@en ;
    schema:name "Expression constraint component"@en .

sh:ExpressionConstraintComponent-expression a sh:Parameter .

sh:HasValueConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that one of the value nodes is a given RDF node."@en ;
    schema:name "Has-value constraint component"@en .

sh:HasValueConstraintComponent-hasValue a sh:Parameter .

sh:IRI a sh:NodeKind ;
    schema:description "The node kind of all IRIs."@en ;
    schema:name "IRI"@en .

sh:IRIOrLiteral a sh:NodeKind ;
    schema:description "The node kind of all IRIs or literals."@en ;
    schema:name "IRI or literal"@en .

sh:InConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to exclusively enumerate the permitted value nodes."@en ;
    schema:name "In constraint component"@en .

sh:InConstraintComponent-in a sh:Parameter .

sh:Info a sh:Severity ;
    schema:description "The severity for an informational validation result."@en ;
    schema:name "Info"@en .

sh:LanguageInConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to enumerate language tags that all value nodes must have."@en ;
    schema:name "Language-in constraint component"@en .

sh:LanguageInConstraintComponent-languageIn a sh:Parameter .

sh:LessThanConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that each value node is smaller than all the nodes that can be reached from the focus node via a given property path."@en ;
    schema:name "Less-than constraint component"@en .

sh:LessThanConstraintComponent-lessThan a sh:Parameter .

sh:LessThanOrEqualsConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that every value node is smaller than all the nodes that can be reached from the focus node via a given property path."@en ;
    schema:name "Less-than-or-equals constraint component"@en .

sh:LessThanOrEqualsConstraintComponent-lessThanOrEquals a sh:Parameter .

sh:Literal a sh:NodeKind ;
    schema:description "The node kind of all literals."@en ;
    schema:name "Literal"@en .

sh:MaxCountConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the maximum number of value nodes."@en ;
    schema:name "Max-count constraint component"@en .

sh:MaxCountConstraintComponent-maxCount a sh:Parameter .

sh:MaxExclusiveConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the range of value nodes with a maximum exclusive value."@en ;
    schema:name "Max-exclusive constraint component"@en .

sh:MaxExclusiveConstraintComponent-maxExclusive a sh:Parameter .

sh:MaxInclusiveConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the range of value nodes with a maximum inclusive value."@en ;
    schema:name "Max-inclusive constraint component"@en .

sh:MaxInclusiveConstraintComponent-maxInclusive a sh:Parameter .

sh:MaxLengthConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the maximum string length of value nodes."@en ;
    schema:name "Max-length constraint component"@en .

sh:MaxLengthConstraintComponent-maxLength a sh:Parameter .

sh:MaxListLengthConstraintComponent a sh:ConstraintComponent ;
    schema:description "Specifies the maximum length of a SHACL list. A violation is reported if the value is not a valid SHACL list."@en ;
    schema:name "Maximum list length constraint component"@en .

sh:MaxListLengthConstraintComponent-maxListLength a sh:Parameter .

sh:MemberShapeConstraintComponent a sh:ConstraintComponent ;
    schema:description "Can be used to specify constraints on the members of a given SHACL list. A violation is reported for each member of the list that does not comply with the constraints specified by the given shape. A violation is reported if the value is not a valid SHACL list."@en ;
    schema:name "Member shape constraint component"@en .

sh:MemberShapeConstraintComponent-memberShape a sh:Parameter .

sh:MinCountConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the minimum number of value nodes."@en ;
    schema:name "Min-count constraint component"@en .

sh:MinCountConstraintComponent-minCount a sh:Parameter .

sh:MinExclusiveConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the range of value nodes with a minimum exclusive value."@en ;
    schema:name "Min-exclusive constraint component"@en .

sh:MinExclusiveConstraintComponent-minExclusive a sh:Parameter .

sh:MinInclusiveConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the range of value nodes with a minimum inclusive value."@en ;
    schema:name "Min-inclusive constraint component"@en .

sh:MinInclusiveConstraintComponent-minInclusive a sh:Parameter .

sh:MinLengthConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the minimum string length of value nodes."@en ;
    schema:name "Min-length constraint component"@en .

sh:MinLengthConstraintComponent-minLength a sh:Parameter .

sh:MinListLengthConstraintComponent a sh:ConstraintComponent ;
    schema:description "Specifies the minimum length of a SHACL list. A violation is reported if the value is not a valid SHACL list."@en ;
    schema:name "Minimum list length constraint component"@en .

sh:MinListLengthConstraintComponent-minListLength a sh:Parameter .

sh:NodeByExpressionConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that all value nodes conform to the node shape(s) produced by the given node expression."@en ;
    schema:name "Node by expression constraint component"@en .

sh:NodeByExpressionConstraintComponent-nodeByExpression a sh:Parameter .

sh:NodeConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that all value nodes conform to the given node shape."@en ;
    schema:name "Node constraint component"@en .

sh:NodeConstraintComponent-node a sh:Parameter .

sh:NodeKindConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the RDF node kind of each value node."@en ;
    schema:name "Node-kind constraint component"@en .

sh:NodeKindConstraintComponent-nodeKind a sh:Parameter .

sh:NotConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that value nodes do not conform to a given shape."@en ;
    schema:name "Not constraint component"@en .

sh:NotConstraintComponent-not a sh:Parameter .

sh:OrConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the value nodes so that they conform to at least one out of several provided shapes."@en ;
    schema:name "Or constraint component"@en .

sh:OrConstraintComponent-or a sh:Parameter .

sh:PatternConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that every value node matches a given regular expression."@en ;
    schema:name "Pattern constraint component"@en .

sh:PatternConstraintComponent-flags a sh:Parameter .

sh:PatternConstraintComponent-pattern a sh:Parameter .

sh:PropertyConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that all value nodes conform to the given property shape."@en ;
    schema:name "Property constraint component"@en .

sh:PropertyConstraintComponent-property a sh:Parameter .

sh:QualifiedMaxCountConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that a specified maximum number of value nodes conforms to a given shape."@en ;
    schema:name "Qualified-max-count constraint component"@en .

sh:QualifiedMaxCountConstraintComponent-qualifiedMaxCount a sh:Parameter .

sh:QualifiedMaxCountConstraintComponent-qualifiedValueShape a sh:Parameter .

sh:QualifiedMaxCountConstraintComponent-qualifiedValueShapesDisjoint a sh:Parameter .

sh:QualifiedMinCountConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that a specified minimum number of value nodes conforms to a given shape."@en ;
    schema:name "Qualified-min-count constraint component"@en .

sh:QualifiedMinCountConstraintComponent-qualifiedMinCount a sh:Parameter .

sh:QualifiedMinCountConstraintComponent-qualifiedValueShape a sh:Parameter .

sh:QualifiedMinCountConstraintComponent-qualifiedValueShapesDisjoint a sh:Parameter .

sh:ReifierShapeConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that the reifier conforms to a given shape."@en ;
    schema:name "ReifierShape constraint component"@en .

sh:ReifierShapeConstraintComponent-reificationRequired a sh:Parameter .

sh:ReifierShapeConstraintComponent-reifierShape a sh:Parameter .

sh:RootClassConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that each value node is the given class or a (transitive) subclass of that class."@en ;
    schema:name "Root class constraint component"@en .

sh:RootClassConstraintComponent-rootClass a sh:Parameter .

sh:SPARQLConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to define constraints based on SPARQL queries."@en ;
    schema:name "SPARQL constraint component"@en .

sh:SPARQLConstraintComponent-sparql a sh:Parameter .

sh:SPARQLExprExpression a sh:NamedParameterExpressionFunction ;
    schema:description "The class of node expressions based on SPARQL expressions (sh:sparqlExpr)."@en ;
    schema:name "SPARQL expr expression"@en .

sh:SPARQLExprExpression-prefixes a sh:Parameter .

sh:SPARQLExprExpression-sparqlExpr a sh:Parameter .

sh:SelectExpression a sh:NamedParameterExpressionFunction ;
    schema:description "The class of node expressions based on SPARQL SELECT queries."@en ;
    schema:name "Select expression"@en .

sh:SelectExpression-prefixes a sh:Parameter .

sh:SelectExpression-select a sh:Parameter .

sh:SingleLineConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to specify that none of the value nodes may contain line breaks."@en ;
    schema:name "Single line constraint component"@en .

sh:SingleLineConstraintComponent-singleLine a sh:Parameter .

sh:SomeValueConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that at least one of the value nodes conform to the given shape."@en ;
    schema:name "Some value constraint component"@en .

sh:SomeValueConstraintComponent-someValue a sh:Parameter .

sh:SubsetOfConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to verify that the set of value nodes is a subset of the set of nodes that can be reached from the focus node using a given property path."@en ;
    schema:name "Subset-of constraint component"@en .

sh:SubsetOfConstraintComponent-subsetOf a sh:Parameter .

sh:Trace a sh:Severity ;
    schema:description "The severity for a trace validation result."@en ;
    schema:name "Trace"@en .

sh:TripleTerm a sh:NodeKind ;
    schema:description "The node kind of all triple terms."@en ;
    schema:name "Triple term"@en .

sh:UniqueLangConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to specify that no pair of value nodes may use the same language tag."@en ;
    schema:name "Unique-languages constraint component"@en .

sh:UniqueLangConstraintComponent-uniqueLang a sh:Parameter .

sh:UniqueMembersConstraintComponent a sh:ConstraintComponent ;
    schema:description "Specifies that all members of a SHACL list must be unique. A violation is reported if the value is not a valid SHACL list."@en ;
    schema:name "Unique list members constraint component"@en .

sh:UniqueMembersConstraintComponent-uniqueMembers a sh:Parameter .

sh:UniqueValuesForConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to ensure that no two nodes targeted by the same shape have the same combination of values for a given set of properties."@en ;
    schema:name "Unique-values-for constraint component"@en .

sh:UniqueValuesForConstraintComponent-uniqueValuesFor a sh:Parameter .

sh:Violation a sh:Severity ;
    schema:description "The severity for a violation validation result."@en ;
    schema:name "Violation"@en .

sh:Warning a sh:Severity ;
    schema:description "The severity for a warning validation result."@en ;
    schema:name "Warning"@en .

sh:XoneConstraintComponent a sh:ConstraintComponent ;
    schema:description "A constraint component that can be used to restrict the value nodes so that they conform to exactly one out of several provided shapes."@en ;
    schema:name "Exactly one constraint component"@en .

sh:XoneConstraintComponent-xone a sh:Parameter .

sh:agentInstruction a rdf:Property ;
    schema:description "Can be used to store instructions that shall be sent as input for external agents that understand natural language."@en ;
    schema:name "agent instruction"@en .

sh:alternativePath a rdf:Property ;
    schema:description "The (single) value of this property must be a list of path elements, representing the elements of alternative paths."@en ;
    schema:name "alternative path"@en .

sh:and a rdf:Property ;
    schema:description "RDF list of shapes to validate the value nodes against."@en ;
    schema:name "and"@en .

sh:annotationProperty a rdf:Property ;
    schema:description "The annotation property that shall be set."@en ;
    schema:name "annotation property"@en .

sh:annotationValue a rdf:Property ;
    schema:description "The (default) values of the annotation property."@en ;
    schema:name "annotation value"@en .

sh:annotationVarName a rdf:Property ;
    schema:description "The name of the SPARQL variable from the SELECT clause that shall be used for the values."@en ;
    schema:name "annotation variable name"@en .

sh:ask a rdf:Property ;
    schema:description "The SPARQL ASK query to execute."@en ;
    schema:name "ask"@en .

sh:bodyExpression a rdf:Property ;
    schema:description "A node expression that is the implementation/body of a custom node expression function."@en ;
    schema:name "body expression"@en .

sh:class a rdf:Property ;
    schema:description "The type that all value nodes must have."@en ;
    schema:name "class"@en .

sh:closed a rdf:Property ;
    schema:description "If set to true then the shape is closed."@en ;
    schema:name "closed"@en .

sh:codeIdentifier a rdf:Property ;
    schema:description "A hint on how code generators should represent the associated shape."@en ;
    schema:name "code identifier"@en .

sh:condition a rdf:Property ;
    schema:description "The shapes that the focus nodes need to conform to before a rule is executed on them."@en ;
    schema:name "condition"@en .

sh:conformanceDisallows a rdf:Property ;
    schema:description "Severity levels that are evaluated in the conformance check."@en ;
    schema:name "conformance disallows"@en .

sh:conforms a rdf:Property ;
    schema:description "True if the validation did not produce any validation results with a severity level of the set of disallowed levels, and false otherwise."@en ;
    schema:name "conforms"@en .

sh:conformsTo a rdf:Property ;
    schema:description "The subject conforms to the object if validation did not produce any validation results with a severity level of the set of disallowed levels."@en ;
    schema:name "conforms to"@en .

sh:construct a rdf:Property ;
    schema:description "The SPARQL CONSTRUCT query to execute."@en ;
    schema:name "construct"@en .

sh:datatype a rdf:Property ;
    schema:description "Specifies an RDF datatype that all value nodes must have."@en ;
    schema:name "datatype"@en .

sh:deactivated a rdf:Property ;
    schema:description "If set to true then all nodes conform to this."@en ;
    schema:name "deactivated"@en .

sh:declare a rdf:Property ;
    schema:description "Links a resource with its namespace prefix declarations."@en ;
    schema:name "declare"@en .

sh:defaultValue a rdf:Property ;
    schema:description "A default value for a property, for example for user interface tools to pre-populate input fields."@en ;
    schema:name "default value"@en .

sh:describe a rdf:Property ;
    schema:description "The SPARQL DESCRIBE to execute."@en ;
    schema:name "describe"@en .

sh:description a rdf:Property ;
    schema:description "Human-readable descriptions for the property in the context of the surrounding shape."@en ;
    schema:name "description"@en .

sh:detail a rdf:Property ;
    schema:description "Links a result with other results that provide more details, for example to describe violations against nested shapes."@en ;
    schema:name "detail"@en .

sh:disjoint a rdf:Property ;
    schema:description "Specifies a property path where the set of values must be disjoint with the value nodes."@en ;
    schema:name "disjoint"@en .

sh:entailment a rdf:Property ;
    schema:description "An entailment regime that indicates what kind of inferencing is required by a shapes graph."@en ;
    schema:name "entailment"@en .

sh:equals a rdf:Property ;
    schema:description "Specifies a property path that must have the same values as the value nodes."@en ;
    schema:name "equals"@en .

sh:expression a rdf:Property ;
    schema:description "The node expression that must return true for the value nodes."@en ;
    schema:name "expression"@en .

sh:filterShape schema:description "Deprecated with SHACL 1.2: replaced by shnex:filterShape."@en .

sh:flags a rdf:Property ;
    schema:description "An optional flag to be used with regular expression pattern matching."@en ;
    schema:name "flags"@en .

sh:focusNode a rdf:Property ;
    schema:description "The focus node that was validated when the result was produced."@en ;
    schema:name "focus node"@en .

sh:formalized a rdf:Property ;
    schema:description "Can be used as reification of sh:intent triples to indicate whether the intended interpretation has already been formalized using SHACL in the same shapes graph."@en ;
    schema:name "formalized"@en .

sh:group a rdf:Property ;
    schema:description "Can be used to link to a property group to indicate that a property shape belongs to a group of related property shapes."@en ;
    schema:name "group"@en .

sh:hasValue a rdf:Property ;
    schema:description "Specifies a value that must be among the value nodes."@en ;
    schema:name "has value"@en .

sh:ignoredProperties a rdf:Property ;
    schema:description "An optional RDF list of properties that are also permitted in addition to those explicitly enumerated via sh:property/sh:path."@en ;
    schema:name "ignored properties"@en .

sh:in a rdf:Property ;
    schema:description "Specifies a list of allowed values so that each value node must be among the members of the given list."@en ;
    schema:name "in"@en .

sh:intent a rdf:Property ;
    schema:description "Provides human-readable descriptions of one or more intended rules, assumptions, or constraints associated with its subject (e.g., a shape). Can be used as input for external agents that understand natural language."@en ;
    schema:name "intent"@en .

sh:intersection schema:description "Deprecated with SHACL 1.2: replaced by shnex:intersection."@en .

sh:inversePath a rdf:Property ;
    schema:description "The (single) value of this property represents an inverse path (object to subject)."@en ;
    schema:name "inverse path"@en .

sh:keyParameter a rdf:Property ;
    schema:description "Set to true for the parameter of a named parameter expression function that uniquely identifies it."@en ;
    schema:name "key parameter"@en .

sh:labelTemplate a rdf:Property ;
    schema:description "Outlines how human-readable labels of instances of the associated Parameterizable shall be produced. The values can contain {?paramName} as placeholders for the actual values of the given parameter."@en ;
    schema:name "label template"@en .

sh:languageIn a rdf:Property ;
    schema:description "Specifies a list of language tags that all value nodes must have."@en ;
    schema:name "language in"@en .

sh:lessThan a rdf:Property ;
    schema:description "Specifies a property path that must have smaller values than the value nodes."@en ;
    schema:name "less than"@en .

sh:lessThanOrEquals a rdf:Property ;
    schema:description "Specifies a property path that must have smaller or equal values than the value nodes."@en ;
    schema:name "less than or equals"@en .

sh:maxCount a rdf:Property ;
    schema:description "Specifies the maximum number of values in the set of value nodes."@en ;
    schema:name "max count"@en .

sh:maxExclusive a rdf:Property ;
    schema:description "Specifies the maximum exclusive value of each value node."@en ;
    schema:name "max exclusive"@en .

sh:maxInclusive a rdf:Property ;
    schema:description "Specifies the maximum inclusive value of each value node."@en ;
    schema:name "max inclusive"@en .

sh:maxLength a rdf:Property ;
    schema:description "Specifies the maximum string length of each value node."@en ;
    schema:name "max length"@en .

sh:maxListLength a rdf:Property ;
    schema:description "Specifies the maximum length that a given SHACL list must have."@en ;
    schema:name "maximum list length"@en .

sh:memberShape a rdf:Property ;
    schema:description "Specifies the shape that all members of SHACL lists must conform to."@en ;
    schema:name "member shape"@en .

sh:message a rdf:Property ;
    schema:description "A human-readable message (possibly with placeholders for variables) explaining the cause of the result."@en ;
    schema:name "message"@en .

sh:minCount a rdf:Property ;
    schema:description "Specifies the minimum number of values in the set of value nodes."@en ;
    schema:name "min count"@en .

sh:minExclusive a rdf:Property ;
    schema:description "Specifies the minimum exclusive value of each value node."@en ;
    schema:name "min exclusive"@en .

sh:minInclusive a rdf:Property ;
    schema:description "Specifies the minimum inclusive value of each value node."@en ;
    schema:name "min inclusive"@en .

sh:minLength a rdf:Property ;
    schema:description "Specifies the minimum string length of each value node."@en ;
    schema:name "min length"@en .

sh:minListLength a rdf:Property ;
    schema:description "Specifies the minimum length that a given SHACL list must have."@en ;
    schema:name "minimum list length"@en .

sh:minus schema:description "Deprecated with SHACL 1.2: replaced by shnex:remove."@en .

sh:name a rdf:Property ;
    schema:description "Human-readable labels for the property in the context of the surrounding shape."@en ;
    schema:name "name"@en .

sh:namespace a rdf:Property ;
    schema:description "The namespace associated with a prefix in a prefix declaration."@en ;
    schema:name "namespace"@en .

sh:node a rdf:Property ;
    schema:description "Specifies the node shape that all value nodes must conform to."@en ;
    schema:name "node"@en .

sh:nodeByExpression a rdf:Property ;
    schema:description "Links a shape to node expressions, indicating the node shape(s) that all value nodes must conform to."@en ;
    schema:name "node by expression"@en .

sh:nodeKind a rdf:Property ;
    schema:description "Specifies the node kind (e.g. IRI or literal) each value node."@en ;
    schema:name "node kind"@en .

sh:nodeValidator a rdf:Property ;
    schema:description "The validator(s) used to evaluate a constraint in the context of a node shape."@en ;
    schema:name "node validator"@en .

sh:nodes schema:description "Deprecated with SHACL 1.2: replaced by shnex:nodes."@en .

sh:not a rdf:Property ;
    schema:description "Specifies a shape that the value nodes must not conform to."@en ;
    schema:name "not"@en .

sh:object a rdf:Property ;
    schema:description "An expression producing the nodes that shall be inferred as objects."@en ;
    schema:name "object"@en .

sh:oneOrMorePath a rdf:Property ;
    schema:description "The (single) value of this property represents a path that is matched one or more times."@en ;
    schema:name "one or more path"@en .

sh:optional a rdf:Property ;
    schema:description "Indicates whether a parameter is optional."@en ;
    schema:name "optional"@en .

sh:or a rdf:Property ;
    schema:description "Specifies a list of shapes so that the value nodes must conform to at least one of the shapes."@en ;
    schema:name "or"@en .

sh:order a rdf:Property ;
    schema:description "Specifies the relative order of this compared to its siblings. For example use 0 for the first, 1 for the second."@en ;
    schema:name "order"@en .

sh:parameter a rdf:Property ;
    schema:description "The parameters of a function or constraint component."@en ;
    schema:name "parameter"@en .

sh:path a rdf:Property ;
    schema:description "Specifies the property path of a property shape."@en ;
    schema:name "path"@en .

sh:pattern a rdf:Property ;
    schema:description "Specifies a regular expression pattern that the string representations of the value nodes must match."@en ;
    schema:name "pattern"@en .

sh:predicate a rdf:Property ;
    schema:description "An expression producing the properties that shall be inferred as predicates."@en ;
    schema:name "predicate"@en .

sh:prefix a rdf:Property ;
    schema:description "The prefix of a prefix declaration."@en ;
    schema:name "prefix"@en .

sh:prefixes a rdf:Property ;
    schema:description "The prefixes that shall be applied before parsing the associated SPARQL query. The objects should define those prefixes using sh:declare."@en ;
    schema:name "prefixes"@en .

sh:property a rdf:Property ;
    schema:description "Links a shape to its property shapes."@en ;
    schema:name "property"@en .

sh:propertyValidator a rdf:Property ;
    schema:description "The validator(s) used to evaluate a constraint in the context of a property shape."@en ;
    schema:name "property validator"@en .

sh:qualifiedMaxCount a rdf:Property ;
    schema:description "The maximum number of value nodes that can conform to the shape."@en ;
    schema:name "qualified max count"@en .

sh:qualifiedMinCount a rdf:Property ;
    schema:description "The minimum number of value nodes that must conform to the shape."@en ;
    schema:name "qualified min count"@en .

sh:qualifiedValueShape a rdf:Property ;
    schema:description "The shape that a specified number of values must conform to."@en ;
    schema:name "qualified value shape"@en .

sh:qualifiedValueShapesDisjoint a rdf:Property ;
    schema:description "Can be used to mark the qualified value shape to be disjoint with its sibling shapes."@en ;
    schema:name "qualified value shapes disjoint"@en .

sh:reificationRequired a rdf:Property ;
    schema:description "Can be used to mark the reification statements required."@en ;
    schema:name "reification required"@en .

sh:reifierShape a rdf:Property ;
    schema:description "The shape that the reified triples must conform to."@en ;
    schema:name "reifier shape"@en .

sh:result a rdf:Property ;
    schema:description "The validation results contained in a validation report."@en ;
    schema:name "result"@en .

sh:resultAnnotation a rdf:Property ;
    schema:description "Links a SPARQL validator with zero or more sh:ResultAnnotation instances, defining how to derive additional result properties based on the variables of the SELECT query."@en ;
    schema:name "result annotation"@en .

sh:resultMessage a rdf:Property ;
    schema:description "Human-readable messages explaining the cause of the result."@en ;
    schema:name "result message"@en .

sh:resultPath a rdf:Property ;
    schema:description "The path of a validation result, based on the path of the validated property shape."@en ;
    schema:name "result path"@en .

sh:resultSeverity a rdf:Property ;
    schema:description "The severity of the result, e.g. warning."@en ;
    schema:name "result severity"@en .

sh:returnType a rdf:Property ;
    schema:description "The expected type of values returned by the associated function."@en ;
    schema:name "return type"@en .

sh:rootClass a rdf:Property ;
    schema:description "Specifies a class so that each value node must be that class or a (transitive) subclass of that class."@en ;
    schema:name "root class"@en .

sh:rule a rdf:Property ;
    schema:description "The rules linked to a shape."@en ;
    schema:name "rule"@en .

sh:select a rdf:Property ;
    schema:description "The SPARQL SELECT query to execute."@en ;
    schema:name "select"@en .

sh:severity a rdf:Property ;
    schema:description "Defines the severity that validation results produced by a shape or constraint must have. Defaults to sh:Violation."@en ;
    schema:name "severity"@en .

sh:shape a rdf:Property ;
    schema:description "Links from a node in the data graph to a shape that it is expected to conform to."@en ;
    schema:name "shape"@en .

sh:shapesGraph a rdf:Property ;
    schema:description "Shapes graphs that should be used when validating this data graph."@en ;
    schema:name "shapes graph"@en .

sh:shapesGraphWellFormed a rdf:Property ;
    schema:description "If true then the validation engine was certain that the shapes graph has passed all SHACL syntax requirements during the validation process."@en ;
    schema:name "shapes graph well formed"@en .

sh:singleLine a rdf:Property ;
    schema:description "Specifies whether none of the value nodes may contain a line break."@en ;
    schema:name "single line"@en .

sh:someValue a rdf:Property ;
    schema:description "Specifies the shape that at least one value node must conform to."@en ;
    schema:name "some value"@en .

sh:sourceConstraint a rdf:Property ;
    schema:description "The constraint that was validated when the result was produced."@en ;
    schema:name "source constraint"@en .

sh:sourceConstraintComponent a rdf:Property ;
    schema:description "The constraint component that is the source of the result."@en ;
    schema:name "source constraint component"@en .

sh:sourceShape a rdf:Property ;
    schema:description "The shape that is was validated when the result was produced."@en ;
    schema:name "source shape"@en .

sh:sparql a rdf:Property ;
    schema:description "Links a shape with SPARQL constraints."@en ;
    schema:name "constraint (in sparql)"@en .

sh:sparqlExpr a rdf:Property ;
    schema:description "The SPARQL expression that is executed during evaluation of a node expression."@en ;
    schema:name "sparql expr"@en .

sh:subject a rdf:Property ;
    schema:description "An expression producing the resources that shall be inferred as subjects."@en ;
    schema:name "subject"@en .

sh:subsetOf a rdf:Property ;
    schema:description "Specifies a property path where the set of value nodes must be a subset of the values of that property path."@en ;
    schema:name "subset of"@en .

sh:suggestedShapesGraph a rdf:Property ;
    schema:description "Suggested shapes graphs for this ontology. The values of this property may be used in the absence of specific sh:shapesGraph statements."@en ;
    schema:name "suggested shapes graph"@en .

sh:target a rdf:Property ;
    schema:description "Links a shape to a target specified by an extension language, for example instances of sh:SPARQLTarget."@en ;
    schema:name "target"@en .

sh:targetClass a rdf:Property ;
    schema:description "Links a shape to a class, indicating that all instances of the class must conform to the shape."@en ;
    schema:name "target class"@en .

sh:targetNode a rdf:Property ;
    schema:description "Links a shape to node expressions, indicating that the output nodes must conform to the shape."@en ;
    schema:name "target node"@en .

sh:targetObjectsOf a rdf:Property ;
    schema:description "Links a shape to a property, indicating that all all objects of triples that have the given property as their predicate must conform to the shape."@en ;
    schema:name "target objects of"@en .

sh:targetSubjectsOf a rdf:Property ;
    schema:description "Links a shape to a property, indicating that all subjects of triples that have the given property as their predicate must conform to the shape."@en ;
    schema:name "target subjects of"@en .

sh:targetWhere a rdf:Property ;
    schema:description "Links a (subject) shape to an (object) shape, indicating that all nodes from the data graph that conform to the given (object) shape must conform to the (subject) shape."@en ;
    schema:name "target where"@en .

sh:this schema:description "Deprecated with SHACL 1.2: replaced by shnex:var."@en .

sh:union schema:description "Deprecated with SHACL 1.2: replaced by shnex:concat."@en .

sh:uniqueLang a rdf:Property ;
    schema:description "Specifies whether all node values must have a unique (or no) language tag."@en ;
    schema:name "unique languages"@en .

sh:uniqueMembers a rdf:Property ;
    schema:description "Specifies that all members of a SHACL list must be unique."@en ;
    schema:name "unique list members"@en .

sh:uniqueValuesFor a rdf:Property ;
    schema:description "Specifies one or more properties (as a URI or rdf:List of URIs) for which no two nodes targeted by the same shape may have the same combination of values."@en ;
    schema:name "unique values for"@en .

sh:unit a rdf:Property ;
    schema:description "The code of a unit that the (literal) value nodes should be interpreted with. Recommended values are plain strings from the UCUM and ISO 4217 standards for units of measure and currencies respectively, or unit URIs from QUDT or a similar ontology."@en ;
    schema:name "unit"@en .

sh:update a rdf:Property ;
    schema:description "The SPARQL UPDATE to execute."@en ;
    schema:name "update"@en .

sh:usedShapesGraph a rdf:Property ;
    schema:description "The subject Validation Report was generated using the object Shapes Graph."@en ;
    schema:name "used shapes graph"@en .

sh:validationReport a rdf:Property ;
    schema:description "A Validation Report that exists for the subject."@en ;
    schema:name "validation report"@en .

sh:validator a rdf:Property ;
    schema:description "The validator(s) used to evaluate constraints of either node or property shapes."@en ;
    schema:name "validator"@en .

sh:value a rdf:Property ;
    schema:description "An RDF node that has caused the result."@en ;
    schema:name "value"@en .

sh:xone a rdf:Property ;
    schema:description "Specifies a list of shapes so that the value nodes must conform to exactly one of the shapes."@en ;
    schema:name "exactly one"@en .

sh:zeroOrMorePath a rdf:Property ;
    schema:description "The (single) value of this property represents a path that is matched zero or more times."@en ;
    schema:name "zero or more path"@en .

sh:zeroOrOnePath a rdf:Property ;
    schema:description "The (single) value of this property represents a path that is matched zero or one times."@en ;
    schema:name "zero or one path"@en .

